---
/**
 * The one site header. Every page that uses BaseLayout gets this, so the
 * wordmark and the five sections are in the same place everywhere.
 */
import { siteConfig } from '@/config/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sh">
  <a class="sh-skip" href="#main">Skip to content</a>
  <a class="sh-mark" href="/" aria-label="C M Nafi, home">C M Nafi</a>
  <nav class="sh-nav" aria-label="Primary">
    {siteConfig.nav.map((item) => (
      <a href={item.href} data-nav-item={item.id} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .sh {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    width: min(calc(100% - 2rem), var(--max-width));
    margin-inline: auto;
    padding: 1.6rem 0 1.4rem;
    border-bottom: 1px solid var(--surface-line);
  }

  .sh-skip {
    position: absolute;
    top: 0.5rem;
    left: 0;
    padding: 0.5rem 0.75rem;
    background: var(--accent);
    color: var(--surface-base);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transform: translateY(-300%);
  }

  .sh-skip:focus {
    transform: none;
  }

  .sh-mark {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--ink-primary);
    white-space: nowrap;
  }

  .sh-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem clamp(1rem, 2.4vw, 2rem);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sh-nav a {
    padding: 0.35rem 0;
    color: var(--ink-secondary);
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-mechanical), border-color var(--dur-fast) var(--ease-mechanical);
  }

  .sh-nav a:hover,
  .sh-nav a:focus-visible {
    color: var(--ink-primary);
  }

  .sh-nav a[aria-current='page'] {
    color: var(--ink-primary);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 640px) {
    .sh {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.7rem;
      padding: 1.1rem 0 0.9rem;
    }

    .sh-nav {
      justify-content: flex-start;
      gap: 0.2rem 1.1rem;
      letter-spacing: 0.1em;
    }
  }
</style>
