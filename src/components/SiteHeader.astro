---
import { siteConfig } from '@/config/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="editorial-header"><a class="wordmark" href="/" aria-label="C M Nafi — Home">C M Nafi<span class="wordmark-dot" aria-hidden="true">.</span></a><nav aria-label="Primary navigation">{siteConfig.nav.filter(n=>n.href!=='/').map(n=><a href={n.href} aria-current={path===n.href || path.startsWith(n.href+'/')?'page':undefined}>{n.label}</a>)}</nav><div class="site-lap" aria-label="Lap timer"><span aria-hidden="true">●</span> <span data-site-lap>00:00.000</span></div></header>
