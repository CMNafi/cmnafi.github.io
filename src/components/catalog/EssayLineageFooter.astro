---
import {getFieldNotesGraph} from '../../lib/field-notes-graph';
import {connectionsFor,tracks} from '../../data/field-notes-graph';
interface Props {slug:string}
const {slug}=Astro.props;
const graph=await getFieldNotesGraph(),current=graph.nodes.find(n=>n.id===slug);
const connected=current?connectionsFor(graph,current.id):[];
const seed=connected.find(c=>c.node.nodeType==='book'&&c.node.publishedAt<=current!.publishedAt);
const next=connected.find(c=>c.node.nodeType==='essay'||c.node.nodeType==='cricket')??connected.find(c=>c.node.nodeType==='book'&&c.node.id!==seed?.node.id);
const tool=connected.find(c=>c.node.nodeType==='tool');
const cards=current?[
 {label:'01 / A book to pair with this',node:seed?.node,copy:seed?.annotation??'This note starts a reading path. Explore the track without assuming an earlier influence.',fallback:`/field-notes/?view=tracks&spine=${current.spineId}`,fallbackLabel:tracks[current.spineId-1].name},
 {label:'02 / Next in the thread',node:next?.node,copy:next?.annotation??'Continue through the related ideas in this curated reading track.',fallback:`/field-notes/?view=tracks&spine=${current.spineId}`,fallbackLabel:tracks[current.spineId-1].name},
 {label:`03 / Related tool${tool?.node.status?' · '+tool.node.status:''}`,node:tool?.node,copy:tool?.node.summary??'Find adviser research, cricket planners, and other independent projects in the Garage.',fallback:'/garage/',fallbackLabel:'Explore the Garage'},
]:[];
---
{current&&<section class="essay-lineage" aria-labelledby={`lineage-${slug}`} data-essay-lineage={slug}><div class="lineage-heading"><div><p>Keep the question moving</p><h2 id={`lineage-${slug}`}>This note belongs to a larger thread.</h2></div><a href={`/field-notes/?node=${current.id}`}>See related writing & tools ↗</a></div><svg class="lineage-mini" viewBox="0 0 700 105" role="img" aria-label={`A reading connection between ${seed?.node.title??'the reading track'}, this note, ${next?.node.title??'the next reading'}, and ${tool?.node.title??'the Garage'}`}><path id={`lineage-path-${slug}`} d="M45 52 C150 12 150 92 255 52 S420 12 475 52 S580 92 655 52"/><g class="lineage-seed"><path d="M45 44L53 52 45 60 37 52Z"/><text x="45" y="85">Seed</text></g><g class="lineage-current"><circle cx="255" cy="52" r="10"/><text x="255" y="85">This note</text></g><g class="lineage-next"><circle cx="475" cy="52" r="7"/><text x="475" y="85">Next reading</text></g><g class="lineage-tool"><rect x="647" y="44" width="16" height="16"/><text x="655" y="85">Related tool</text></g><circle class="lineage-pulse" r="3"><animateMotion dur="7s" repeatCount="indefinite" path="M45 52 C150 12 150 92 255 52 S420 12 475 52 S580 92 655 52"/></circle></svg><div class="lineage-cards">{cards.map(card=><a href={card.node?.href??card.fallback}><span>{card.label}</span><h3>{card.node?.title??card.fallbackLabel} <span aria-hidden="true">↗</span></h3><p>{card.copy}</p></a>)}</div><p class="lineage-context">A curated reading path. Book pairings offer another perspective; related tools let you explore a similar question. Development projects are marked R&D.</p></section>}
<style>
.essay-lineage{--lineage-bg:#FAF8F5;--lineage-surface:#fff;--lineage-ink:#141618;--lineage-copy:#454A50;--lineage-muted:#727880;--lineage-border:#E5E0D5;--lineage-green:#1E3A2F;--lineage-gold:#B87D14;--lineage-blue:#1D4ED8;--lineage-red:#C84B31;background:var(--lineage-bg);color:var(--lineage-ink);font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;text-align:left;max-width:1120px;box-sizing:border-box;margin:4rem auto;padding:30px;border:1px solid var(--lineage-border);letter-spacing:normal;text-transform:none;line-height:1.5}:global([data-theme="dark"]) .essay-lineage{--lineage-bg:#0D0F12;--lineage-surface:#14171C;--lineage-ink:#F1F3F5;--lineage-copy:#A6AEB7;--lineage-muted:#89929e;--lineage-border:#222730;--lineage-green:#34D399;--lineage-gold:#FBBF24;--lineage-blue:#60A5FA;--lineage-red:#FB923C}.lineage-heading{display:flex;justify-content:space-between;align-items:end;gap:20px}.lineage-heading p{font:9px/1.5 'JetBrains Mono',monospace;letter-spacing:.09em;text-transform:uppercase;color:var(--lineage-green);margin:0 0 10px}.essay-lineage h2{font:400 30px/1.1 'Newsreader',Georgia,serif;letter-spacing:-.025em;color:var(--lineage-ink);margin:0;border:0;padding:0;text-transform:none}.lineage-heading>a{font-size:10px;color:var(--lineage-green);text-decoration:none;white-space:nowrap}.lineage-mini{width:100%;height:105px;display:block;margin:8px 0}.lineage-mini>path{fill:none;stroke:var(--lineage-border);stroke-width:1.5}.lineage-mini text{font:9px 'JetBrains Mono',monospace;fill:var(--lineage-muted);text-anchor:middle}.lineage-seed path{fill:var(--lineage-gold)}.lineage-current circle,.lineage-next circle{fill:var(--lineage-green)}.lineage-tool rect{fill:var(--lineage-blue)}.lineage-pulse{fill:var(--lineage-red)}.lineage-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.lineage-cards>a{padding:16px;border:1px solid var(--lineage-border);background:var(--lineage-surface);color:var(--lineage-ink);text-decoration:none;transition:border-color .15s}.lineage-cards>a:hover{border-color:var(--lineage-green)}.lineage-cards>a>span{font:8px/1.5 'JetBrains Mono',monospace;color:var(--lineage-muted);text-transform:uppercase;letter-spacing:.04em;display:block}.lineage-cards h3{font:400 21px/1.2 'Newsreader',Georgia,serif;margin:10px 0;color:var(--lineage-ink);letter-spacing:-.01em;text-transform:none}.lineage-cards h3 span{font:12px sans-serif;color:var(--lineage-green)}.lineage-cards p{font-size:10px;line-height:1.7;color:var(--lineage-copy);margin:0}.lineage-context{font-size:9px;line-height:1.6;color:var(--lineage-muted);margin:15px 0 0}.essay-lineage a:focus-visible{outline:2px solid var(--lineage-red);outline-offset:3px}@media(max-width:700px){.essay-lineage{margin:2rem 10px;padding:20px}.lineage-heading{display:block}.lineage-heading>a{display:inline-block;margin-top:14px}.essay-lineage h2{font-size:27px}.lineage-cards{grid-template-columns:1fr}.lineage-cards h3{font-size:23px}.lineage-mini{height:85px}.lineage-cards p{font-size:11px}}@media(prefers-reduced-motion:reduce){.lineage-pulse{display:none}.lineage-cards>a{transition:none}}
</style>
