---
import {getFieldNotesGraph} from '../../lib/field-notes-graph';
import {tracks} from '../../data/field-notes-graph';
const graph=await getFieldNotesGraph();
---
<section class="atlas-ledger" id="notes-ledger" aria-labelledby="notes-ledger-title"><div class="atlas-ledger-heading"><h2 id="notes-ledger-title">The complete index.</h2><p data-ledger-scope>One entry per note. Select a node, stream, entity, or track above.</p></div><div class="atlas-table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Title & thesis</th><th scope="col">Reading track</th><th scope="col">Related tool</th><th scope="col">Read / status</th></tr></thead><tbody>{[...graph.nodes].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt)).map(n=>{const tool=n.connectedNodeIds.map(c=>graph.nodes.find(p=>p.id===c.targetId)).find(p=>p?.nodeType==='tool');return <tr data-atlas-row={n.id}><td><time datetime={n.publishedAt}>{n.publishedAt}</time>{n.nodeType==='tool'&&<small>Catalog date</small>}</td><td><a href={n.href}>{n.title}</a><span>{n.nodeType==='book'?'Book note':n.nodeType==='cricket'?'Cricket log':n.nodeType==='tool'?'Related tool':n.subtopic}</span><p>{n.summary}</p></td><td>{tracks[n.spineId-1].short}</td><td>{tool?<a href={tool.href}>{tool.title}<small>{tool.status}</small></a>:<span>Not linked</span>}</td><td>{n.readingMinutes?`${n.readingMinutes} min`:n.status}</td></tr>})}</tbody></table></div><p data-atlas-empty-ledger hidden>No matching entries. Clear a filter to continue.</p></section>
<style>
.atlas-ledger{font-family:var(--font-sans);color:var(--text-primary);margin-top:3rem;scroll-margin-top:4rem}.atlas-ledger-heading{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:20px}.atlas-ledger h2{font:32px 'Newsreader',Georgia,serif;margin:0}.atlas-ledger-heading p{font-size:11px;color:var(--text-muted);margin:0}.atlas-table-wrap{overflow:auto}.atlas-ledger table{width:100%;border-collapse:collapse;text-align:left;font-size:12px}.atlas-ledger th{font:9px var(--font-mono);text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);border-bottom:1px solid var(--text-primary);padding:12px 10px}.atlas-ledger td{padding:17px 10px;border-bottom:1px solid var(--border-hairline);vertical-align:top}.atlas-ledger td:first-child,.atlas-ledger td:last-child{white-space:nowrap;font:10px/1.6 var(--font-mono);font-variant-numeric:tabular-nums}.atlas-ledger td:first-child{width:110px}.atlas-ledger td:nth-child(3),.atlas-ledger td:nth-child(4){width:130px;font-size:10px;color:var(--text-muted)}.atlas-ledger a{color:var(--ink-forest);text-decoration:none}.atlas-ledger a:hover{text-decoration:underline}.atlas-ledger td:nth-child(2)>a{font:19px/1.2 'Newsreader',Georgia,serif;display:inline-block}.atlas-ledger td span{display:block;font:8px var(--font-mono);text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);margin-top:8px}.atlas-ledger td p{font-size:11px;line-height:1.6;color:var(--text-secondary);margin:7px 0 0;max-width:650px}.atlas-ledger small{display:block;font:7px var(--font-mono);color:var(--text-muted);margin-top:5px}.atlas-ledger [hidden]{display:none!important}@media(max-width:700px){.atlas-ledger-heading{display:block}.atlas-ledger-heading p{margin-top:9px}.atlas-ledger td:nth-child(3),.atlas-ledger th:nth-child(3),.atlas-ledger td:nth-child(4),.atlas-ledger th:nth-child(4){display:none}.atlas-ledger td{padding:13px 6px}.atlas-ledger td:first-child{width:73px;font-size:8px}.atlas-ledger td:nth-child(2)>a{font-size:17px}.atlas-ledger td p{font-size:10px}.atlas-ledger td:last-child{font-size:8px}}
</style>
