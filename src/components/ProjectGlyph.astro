---
const {slug}=Astro.props;
const cricket=/captain|fielding/.test(slug);const globe=/worldview/.test(slug);const cup=/world-cup/.test(slug);
---
<svg viewBox="0 0 300 140" fill="none" stroke="currentColor" stroke-width="1" class="project-glyph" aria-hidden="true">{cricket?<><ellipse cx="150" cy="70" rx="98" ry="54"/><ellipse cx="150" cy="70" rx="48" ry="28"/><rect x="145" y="52" width="10" height="36"/>{[[85,45],[210,78],[138,26],[180,108]].map(([x,y])=><circle cx={x} cy={y} r="4" class="highlight"/>)}</>:globe?<><circle cx="150" cy="70" r="48"/><ellipse cx="150" cy="70" rx="25" ry="48"/><path d="M102 70h96M111 43h78M111 97h78M40 70h62M198 70h62"/><circle cx="40" cy="70" r="5" class="highlight"/><circle cx="260" cy="70" r="5"/></>:cup?<><path d="M45 30h55v30h45v40h55v20h55M45 110h55V80h45V40h55V20h55"/><circle cx="145" cy="70" r="5" class="highlight"/></>:<><rect x="45" y="24" width="82" height="92"/><path d="M57 44h58M57 60h42M57 76h58M57 92h34M127 70h45"/><rect x="173" y="40" width="82" height="58"/><path d="M184 58h59M184 76h40"/><circle cx="150" cy="70" r="5" class="highlight"/></>}</svg>
<style>.project-glyph{width:100%;height:140px;color:var(--ink-secondary)}.highlight{stroke:var(--accent);fill:var(--accent)}</style>
