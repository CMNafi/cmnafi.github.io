---
import {places,legs,distance} from '../../data/journey/geography';
const acts=[
  {id:'roots',name:'Dinajpur',short:'Roots',title:'Where reading was the answer to boredom.',meta:'25.6279° N, 88.6332° E · 37 m elevation · Origin',body:'I grew up in Dinajpur, in northern Bangladesh, in a household that treated reading as the default answer to boredom. Before I knew what a data pipeline or a balance sheet was, the world was measured in paperbacks, monsoon afternoons, and tape-ball cricket in the courtyard.',prompt:'Move across the constellation. Follow a small curiosity.',line:'A household where the answer to boredom was a book.'},
  {id:'discipline',name:'Rangpur Cadet',short:'Structure',title:'Learning structure away from home.',meta:`25.7169° N, 89.2612° E · About ${Math.round(legs[0]/5)*5} km east`,body:'Moving from Dinajpur to Rangpur Cadet College was only about sixty-five kilometres on a map. At twelve, leaving home for boarding school felt much further. Early morning muster, pressed uniforms, study halls, and dorm camaraderie gave everything a cadence. Discipline became the scaffolding that let me carry bigger questions.',prompt:'Move across the formation. Watch it find its shape again.',line:'A short distance on the map. A much bigger step at twelve.'},
  {id:'crossings',name:'Changshu, China',short:'Self-reliance',title:'Sixteen, and learning self-reliance.',meta:`31.6539° N, 120.7522° E · ${Math.round(distance(places[0],places[2])).toLocaleString('en-US')} km from home`,body:'At sixteen, the map widened all at once. I left Bangladesh on a full scholarship to UWC Changshu China, arriving in a country where I didn’t speak the language. Among classmates from around the world, two years taught me how to read a room without familiar shorthand, and how to build a home out of shared curiosity.',prompt:'Drag the globe, or focus it and use the arrow keys.',line:'A new country, an unfamiliar language, and a shared curiosity.'},
  {id:'translation',name:'USA: Iowa to Tampa',short:'Translation',title:'Where the data meets the story.',meta:'43.3017° N, 91.7896° W → 27.9506° N, 82.4572° W',body:'University took me across the Pacific to Luther College in Decorah, Iowa, a town of eight thousand people. Winter taught me patience; a small campus taught me to stay with a question. A Data Science degree and a Computer Science minor led into work at Mayo Clinic, SkyBridge Associates, BlackRock, and Dasseti. Now I translate between investment teams and software, and chase cricket totals on the weekend.',prompt:'Choose a place on the map to open a note from that chapter.',line:'Numbers into stories. Problems into tools. Matches into memory.'}
];
const numerals=['I','II','III','IV'];
const memories=[{label:'Paperbacks & curiosity',note:'At home, reading was the default answer to boredom.'},{label:'Northern Bangladesh plains',note:'Dinajpur was the small, familiar world before the map widened.'},{label:'Backyard tape-ball cricket',note:'Cricket belonged to the everyday rhythm, long before the Florida match reports.'}];
---
<section class="journey-hero" data-journey-hero aria-labelledby="journey-title">
  <header class="journey-intro"><div><p class="journey-eyebrow">C M Nafi · A story in four acts</p><h1 id="journey-title">The rooms<br />that <em>shaped me.</em></h1></div><div class="journey-intro-note"><p>Before the job titles, there were books, a boarding school, and a map that kept getting bigger.</p><a href="#journey-roots">Scroll to follow the thread ↓</a><a href="#home-notebook">Or go straight to the notebook ↗</a></div></header>
  <div class="journey-grid">
    <figure class="journey-stage" aria-label="Interactive atlas and living geometry">
      <div class="journey-stage-meta"><div><span class="journey-eyebrow" data-stage-act>Act I · Roots</span><strong data-stage-place>Dinajpur</strong><span class="journey-coordinate" data-stage-coordinates>25.63° N, 88.63° E</span></div><div class="journey-distance"><output data-stage-distance>0</output><span>km connected</span></div></div>
      <div class="journey-surface"><canvas data-journey-canvas tabindex="0" role="img" aria-label="Interactive geographic atlas. Drag to turn the globe, or use arrow keys. Home resets the view.">A geographic atlas connects Dinajpur, Rangpur Cadet College, Changshu, and the United States. The four chapters below contain the complete story.</canvas><svg class="journey-labels" data-journey-labels viewBox="0 0 600 600" aria-label="Places and memories"><g class="journey-arcs" aria-hidden="true">{[0,1,2].map(i=><g><path data-arc-base={i}/><path data-arc-active={i}/><circle data-arc-head={i} r="3.5"/></g>)}</g><g class="journey-memory-labels">{memories.map((memory,i)=><g data-memory={i} role="button" tabindex="0" aria-label={memory.label}><circle r="4"/><text x="12" y="4">{memory.label}</text></g>)}</g><g class="journey-map-labels">{places.map((place,i)=><g data-place={i} role="button" tabindex="0" aria-label={`Inspect ${place.label}`}><line class="journey-node-leader" data-node-leader /><rect class="journey-node-hit" data-node-hit fill="transparent" /><circle class="journey-node-halo" r="14"/><circle class="journey-node-dot" r="4"/><text data-node-text x="10" y="-9">{place.label}</text></g>)}</g></svg><div class="journey-inspect" data-journey-inspect role="region" aria-label="Place note" aria-live="polite" hidden><button type="button" data-close-inspect aria-label="Close place note">×</button><strong data-inspect-title></strong><p data-inspect-copy></p><a data-inspect-link href="/story/">Read the related story ↗</a><a href="/field-notes/">Browse Field Notes ↗</a></div><nav class="journey-us-index" aria-label="Inspect US chapters">{[3,4,5,7].map(i=><button type="button" data-open-place={i}>{places[i].label}</button>)}</nav><span class="journey-surface-note" data-surface-note>Living geometry / the courtyard</span></div>
      <figcaption><p class="journey-scene-line" data-scene-line>{acts[0].line}</p><div class="journey-controls"><nav class="journey-pills" aria-label="Choose a story chapter">{acts.map((act,i)=><a href={`#journey-${act.id}`} data-go-act={i} aria-current={i===0?'step':undefined}><span>0{i+1}</span>{act.name}</a>)}</nav><div class="journey-playback"><button type="button" data-journey-play aria-label="Play the four-act story">Play story <span aria-hidden="true">▷</span></button><label class="journey-scrub-label"><span class="journey-sr">Story progress</span><input data-journey-scrub type="range" min="0" max="1" step="0.001" value="0" aria-label="Scrub through the four-act story" /></label><button type="button" data-reset-globe aria-label="Reset globe rotation">Reset view</button></div><div class="journey-motion-row"><p class="journey-mode-hint" data-mode-hint>Drag globe or hover nodes to inspect. Scrolling stops autoplay.</p><label class="journey-motion-choice"><input type="checkbox" data-still-view /> Still view</label></div></div></figcaption>
    </figure>
    <div class="journey-steps">{acts.map((act,i)=><article class="journey-step" id={`journey-${act.id}`} data-journey-step={i} aria-labelledby={`journey-act-${i}`}><p class="journey-act-number">Act {numerals[i]} <span>/ {act.short}</span></p><h2 id={`journey-act-${i}`}><span>{i===0?'Dinajpur':i===1?'Rangpur Cadet College':i===2?'UWC Changshu, China':'Iowa to the next room'}</span>{act.title}</h2><p class="journey-act-meta">{act.meta}</p><p class="journey-prose">{act.body}</p><p class="journey-prompt"><span aria-hidden="true">↗</span> {act.prompt}</p>{i===3&&<a class="journey-continue" href="#home-notebook">The notebook continues below ↓</a>}</article>)}</div>
  </div>
  <footer class="journey-geography-note"><span>Map connections, not recorded flights. Distances use city-centre great-circle geometry; particles are a visual metaphor.</span><a href="https://www.naturalearthdata.com/about/terms-of-use/">Land: Natural Earth ↗</a></footer>
  <script is:inline type="application/json" data-journey-copy set:html={JSON.stringify(acts.map(a=>({name:a.name,short:a.short,line:a.line}))).replaceAll('<','\u003c')} />
  <noscript><style is:inline>.journey-hero .journey-stage{display:none}.journey-hero .journey-grid{display:block;min-height:0}.journey-hero .journey-step{min-height:0}</style><p class="journey-fallback">The complete story is above. Enable JavaScript to explore the atlas, or <a href="/story/">read the full biography</a>.</p></noscript>
</section>
<script>
  import land from '../../data/journey/land.json';
  import {places,unit,greatCircle,cumulative,clamp,smooth,type Vec3} from '../../data/journey/geography';
  type Particle={x:number;y:number;vx:number;vy:number;tx:number;ty:number;size:number;color:number;role:number};
  function initJourney(){
    const candidate=document.querySelector<HTMLElement>('[data-journey-hero]');if(!candidate||candidate.dataset.ready)return;const root:HTMLElement=candidate;
    const canvas=root.querySelector<HTMLCanvasElement>('[data-journey-canvas]')!,ctx=canvas.getContext('2d');if(!ctx)return;
    root.dataset.ready='true';
    const surface=root.querySelector<HTMLElement>('.journey-surface')!,svg=root.querySelector<SVGSVGElement>('[data-journey-labels]')!,steps=[...root.querySelectorAll<HTMLElement>('[data-journey-step]')],pills=[...root.querySelectorAll<HTMLAnchorElement>('[data-go-act]')];
    const copy=JSON.parse(root.querySelector('[data-journey-copy]')!.textContent!) as {name:string;short:string;line:string}[];
    const play=root.querySelector<HTMLButtonElement>('[data-journey-play]')!,scrub=root.querySelector<HTMLInputElement>('[data-journey-scrub]')!,inspect=root.querySelector<HTMLElement>('[data-journey-inspect]')!;
    const reduced=matchMedia('(prefers-reduced-motion: reduce)'),stillView=root.querySelector<HTMLInputElement>('[data-still-view]')!;let reduce=reduced.matches;
    const rings=(land as number[][][]).map(ring=>ring.map(([lon,lat])=>unit(lat,lon)));
    const placeVectors=places.map(p=>unit(p.lat,p.lon));
    const chinaLat=places[2].lat*Math.PI/180,chinaLon=places[2].lon*Math.PI/180,chinaEast=[-Math.sin(chinaLon),Math.cos(chinaLon),0],chinaNorth=[-Math.sin(chinaLat)*Math.cos(chinaLon),-Math.sin(chinaLat)*Math.sin(chinaLon),Math.cos(chinaLat)];
    const arcs=[greatCircle(places[0],places[1]),greatCircle(places[1],places[2]),greatCircle(places[2],places[3])];
    const branches=[4,5,6,7].map(index=>greatCircle(places[3],places[index],32));
    const graticules:Vec3[][]=[];for(let lat=-75;lat<=75;lat+=15)graticules.push(Array.from({length:121},(_,i)=>unit(lat,-180+i*3)));for(let lon=-180;lon<180;lon+=15)graticules.push(Array.from({length:61},(_,i)=>unit(-90+i*3,lon)));
    const particles:Particle[]=Array.from({length:180},(_,i)=>({x:0,y:0,vx:0,vy:0,tx:0,ty:0,size:i%13===0?2.2:1.15+(i%3)*.2,color:i%4,role:i%4}));
    const mapCache=document.createElement('canvas'),mapContext=mapCache.getContext('2d');let mapKey='';
    let w=1,h=1,dpr=1,frame=0,last=0,clock=0,current=0,target=0,visible=false,autoplay=false,active=-1,source:'scroll'|'manual'|'auto'='scroll',initial=true;
    let sampleCount=0,sampleCost=0,sampleStart=0;
    let pointer={x:-1000,y:-1000,on:false},drag:{x:number;y:number;yaw:number;pitch:number}|null=null,yaw=0,pitch=0,centres:number[]=[];
    let palette={paper:'#FAF8F5',surface:'#FFFFFF',ink:'#141618',muted:'#727880',line:'#E5E0D5',forest:'#1E3A2F',red:'#C84B31',amber:'#B87D14',blue:'#1D4ED8'};
    const readPalette=()=>{const style=getComputedStyle(root);const read=(key:string,fallback:string)=>style.getPropertyValue(key).trim()||fallback;palette={paper:read('--bg-canvas',palette.paper),surface:read('--bg-surface',palette.surface),ink:read('--text-primary',palette.ink),muted:read('--text-muted',palette.muted),line:read('--border-hairline',palette.line),forest:read('--accent-forest',palette.forest),red:read('--accent-vermilion',palette.red),amber:read('--accent-amber',palette.amber),blue:read('--accent-blue',palette.blue)};};
    const probe=()=>innerWidth<900?surface.closest('figure')!.getBoundingClientRect().height+56+(innerHeight-surface.closest('figure')!.getBoundingClientRect().height-56)*.45:innerHeight*.55;
    const measure=()=>{centres=steps.map(step=>{const rect=step.getBoundingClientRect();return scrollY+rect.top+rect.height/2;});};
    const fromScroll=()=>{const at=scrollY+probe();let segment=0;while(segment<2&&at>centres[segment+1])segment++;return clamp((segment+clamp((at-centres[segment])/(centres[segment+1]-centres[segment])))/3);};
    const scrollToProgress=(p:number)=>{const v=clamp(p)*3,i=Math.min(2,Math.floor(v));window.scrollTo({top:centres[i]+(centres[i+1]-centres[i])*(v-i)-probe(),behavior:'instant'});};
    function updatePlay(){play.textContent=autoplay?'Pause story Ⅱ':'Play story ▷';play.setAttribute('aria-label',autoplay?'Pause the story':'Play the four-act story');play.setAttribute('aria-pressed',String(autoplay));}
    function pause(){autoplay=false;source='scroll';updatePlay();}
    const setActive=(p:number)=>{const index=Math.min(3,Math.floor(p*4));if(index===active)return;active=index;root.dataset.act=String(index);pills.forEach((pill,i)=>i===index?pill.setAttribute('aria-current','step'):pill.removeAttribute('aria-current'));steps.forEach((step,i)=>step.classList.toggle('is-current',i===index));root.querySelector('[data-stage-act]')!.textContent=`Act ${['I','II','III','IV'][index]} · ${copy[index].short}`;root.querySelector('[data-stage-place]')!.textContent=copy[index].name;root.querySelector('[data-scene-line]')!.textContent=copy[index].line;root.querySelector('[data-surface-note]')!.textContent=['Living geometry / the courtyard','Living geometry / the quadrangle','An orthographic atlas / across Asia','An orthographic atlas / across the Pacific'][index];};
    function inspectPlace(index:number){pause();const place=places[index];inspect.hidden=false;root.querySelector('[data-inspect-title]')!.textContent=place.label;root.querySelector('[data-inspect-copy]')!.textContent=place.note;const link=root.querySelector<HTMLAnchorElement>('[data-inspect-link]')!;link.hidden=false;link.href=place.href;}
    const memoryNotes=[['Paperbacks & curiosity','At home, reading was the default answer to boredom.'],['Northern Bangladesh plains','Dinajpur was the small, familiar world before the map widened.'],['Backyard tape-ball cricket','Cricket belonged to the everyday rhythm, long before the Florida match reports.']];
    root.querySelectorAll<HTMLButtonElement>('[data-open-place]').forEach(button=>button.addEventListener('click',()=>inspectPlace(Number(button.dataset.openPlace))));
    root.querySelectorAll<SVGGElement>('[data-place]').forEach(node=>{const open=()=>inspectPlace(Number(node.dataset.place));node.addEventListener('click',open);node.addEventListener('mouseenter',()=>{if(!autoplay)open();});node.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();open();}});});
    root.querySelectorAll<SVGGElement>('[data-memory]').forEach(node=>{const open=()=>{const note=memoryNotes[Number(node.dataset.memory)];inspect.hidden=false;root.querySelector('[data-inspect-title]')!.textContent=note[0];root.querySelector('[data-inspect-copy]')!.textContent=note[1];root.querySelector<HTMLAnchorElement>('[data-inspect-link]')!.hidden=true;};node.addEventListener('mouseenter',()=>node.classList.add('is-hovered'));node.addEventListener('mouseleave',()=>node.classList.remove('is-hovered'));node.addEventListener('click',open);node.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});});
    root.querySelector('[data-close-inspect]')!.addEventListener('click',()=>{inspect.hidden=true;});
    function draw(){
      setActive(current);
      const a=smooth(.20,.30,current),b=smooth(.48,.58,current),c=smooth(.72,.84,current),weights=[1-a,a*(1-b),b*(1-c),c];
      const lat=25.6279+(25.7169-25.6279)*a+(31.6539-25.7169)*b+(39-31.6539)*c+pitch;
      const lon=88.6332+(89.2612-88.6332)*a+(120.7522-89.2612)*b+(255-120.7522)*c+yaw;
      const zoom=6.2+(5.8-6.2)*a+(1.08-5.8)*b+(.98-1.08)*c,r=Math.min(w,h)*.43*zoom,cx=w*.5,cy=h*.49;
      const rad=Math.PI/180,phi=lat*rad,lambda=lon*rad,front=unit(lat,lon),east=[-Math.sin(lambda),Math.cos(lambda),0],north=[-Math.sin(phi)*Math.cos(lambda),-Math.sin(phi)*Math.sin(lambda),Math.cos(phi)];
      const project=(v:Vec3,lift=0)=>({x:cx+r*(1+lift)*(v[0]*east[0]+v[1]*east[1]+v[2]*east[2]),y:cy-r*(1+lift)*(v[0]*north[0]+v[1]*north[1]+v[2]*north[2]),z:v[0]*front[0]+v[1]*front[1]+v[2]*front[2]});
      const trace=(points:Vec3[],closed=false)=>{let pen=false;for(const v of points){const p=project(v);if(p.z<=0){pen=false;continue;}if(!pen){ctx!.moveTo(p.x,p.y);pen=true;}else ctx!.lineTo(p.x,p.y);}if(closed)ctx!.closePath();};
      ctx!.setTransform(dpr,0,0,dpr,0,0);ctx!.clearRect(0,0,w,h);
      const nextMapKey=[lat.toFixed(3),lon.toFixed(3),zoom.toFixed(3),w,h,dpr,palette.paper].join(':');
      if(mapContext&&mapKey===nextMapKey){ctx!.drawImage(mapCache,0,0,w,h);}else{
      ctx!.fillStyle=palette.paper;ctx!.fillRect(0,0,w,h);
      ctx!.save();ctx!.globalAlpha=.7;ctx!.fillStyle=palette.line;ctx!.strokeStyle=palette.line;ctx!.lineWidth=.6;for(const ring of rings){ctx!.beginPath();trace(ring,true);ctx!.fill();}ctx!.restore();
      ctx!.save();ctx!.strokeStyle=palette.muted;ctx!.globalAlpha=.15+b*.07;ctx!.lineWidth=.6;ctx!.beginPath();for(const line of graticules)trace(line);ctx!.stroke();if(zoom<1.6){ctx!.beginPath();ctx!.arc(cx,cy,r,0,Math.PI*2);ctx!.stroke();}ctx!.restore();
      const organic=1-b;
      if(organic>.01){ctx!.save();ctx!.strokeStyle=palette.amber;ctx!.globalAlpha=.13*organic;for(let i=0;i<7;i++){ctx!.beginPath();ctx!.ellipse(cx,cy,(i+1)*Math.min(w,h)*.055,(i+1)*Math.min(w,h)*.04,Math.sin(i*1.2)*.12,0,Math.PI*2);ctx!.stroke();}ctx!.restore();}
      const mapPw=Math.min(w*.72,h*.75),mapPh=mapPw*.72;
      if(weights[1]>.01){ctx!.save();ctx!.globalAlpha=weights[1]*.28;ctx!.strokeStyle=palette.forest;ctx!.lineWidth=.7;ctx!.strokeRect(cx-mapPw*.55,cy-mapPh*.55,mapPw*1.1,mapPh*1.1);ctx!.beginPath();ctx!.moveTo(cx-mapPw*.6,cy);ctx!.lineTo(cx+mapPw*.6,cy);ctx!.moveTo(cx,cy-mapPh*.6);ctx!.lineTo(cx,cy+mapPh*.6);ctx!.stroke();ctx!.restore();}
      if(c>.01){ctx!.save();ctx!.strokeStyle=palette.blue;ctx!.globalAlpha=c*.35;ctx!.lineWidth=.8;for(const branch of branches){ctx!.beginPath();trace(branch);ctx!.stroke();}ctx!.restore();}
      if(mapContext){mapCache.width=canvas.width;mapCache.height=canvas.height;mapContext.drawImage(canvas,0,0);mapKey=nextMapKey;}
      }
      const pw=Math.min(w*.72,h*.75),ph=pw*.72;
      const projectedPlaces=placeVectors.map(v=>project(v));const seconds=reduce?0:clock;
      for(let i=0;i<particles.length;i++){
        const p=particles[i],gold=i*2.3999632297,spiral=Math.sqrt((i+.5)/180),orb=gold+seconds*.055;
        const t1={x:cx+Math.cos(orb)*spiral*pw*.48+Math.sin(seconds*.38+i)*5,y:cy+Math.sin(orb)*spiral*ph*.53+Math.cos(seconds*.31+i*.7)*5};
        const breathe=reduce?0:Math.sin(seconds*1.1)*1.1;
        const t2={x:cx+((i%15)-7)*pw/15,y:cy+(Math.floor(i/15)-5.5)*ph/12+breathe};
        const ring=i%3,angle=(Math.floor(i/3)/60)*Math.PI*2+seconds*(.08+ring*.025),angularRadius=.18+ring*.12;
        const ringVector=placeVectors[2].map((v,j)=>v*Math.cos(angularRadius)+(chinaEast[j]*Math.cos(angle)+chinaNorth[j]*Math.sin(angle))*Math.sin(angularRadius)) as Vec3;
        const t3=project(ringVector);
        const hubIndex=[3,4,5,7][i%4],hubPoint=projectedPlaces[hubIndex],local=Math.floor(i/4),theta=local*2.3999632297,rr=Math.sqrt(local/45)*Math.min(w,h)*.09;
        const t4={x:hubPoint.x+Math.cos(theta)*rr,y:hubPoint.y+Math.sin(theta)*rr};
        p.tx=t1.x*weights[0]+t2.x*weights[1]+t3.x*weights[2]+t4.x*weights[3];p.ty=t1.y*weights[0]+t2.y*weights[1]+t3.y*weights[2]+t4.y*weights[3];
        if(pointer.on&&!drag){const dx=p.tx-pointer.x,dy=p.ty-pointer.y,d2=dx*dx+dy*dy;if(d2<6400&&d2>1){const force=(1-Math.sqrt(d2)/80)*(weights[1]>.5?17:26);p.tx+=dx/Math.sqrt(d2)*force;p.ty+=dy/Math.sqrt(d2)*force;}}
        if(reduce||initial){p.x=p.tx;p.y=p.ty;p.vx=0;p.vy=0;}else{const stiffness=weights[1]>.6?.14:.09,damping=weights[1]>.6?.82:.78;p.vx=(p.vx+(p.tx-p.x)*stiffness)*damping;p.vy=(p.vy+(p.ty-p.y)*stiffness)*damping;p.x+=p.vx;p.y+=p.vy;}
      }
      ctx!.save();ctx!.lineWidth=.5;ctx!.strokeStyle=palette.forest;ctx!.globalAlpha=.11;ctx!.beginPath();for(let i=0;i<180;i++){let links=0;for(let j=i+1;j<180&&links<3;j++){const p=particles[i],q=particles[j],dx=p.x-q.x,dy=p.y-q.y;if(dx*dx+dy*dy<2304){ctx!.moveTo(p.x,p.y);ctx!.lineTo(q.x,q.y);links++;}}}ctx!.stroke();ctx!.restore();
      const colors=[palette.amber,palette.forest,palette.red,palette.blue];for(const p of particles){ctx!.fillStyle=weights[1]>.6?palette.forest:colors[p.color];ctx!.globalAlpha=.62;ctx!.beginPath();ctx!.arc(p.x,p.y,p.size,0,Math.PI*2);ctx!.fill();}ctx!.globalAlpha=1;initial=false;
      const legProgress=[smooth(.20,.30,current),smooth(.48,.65,current),smooth(.72,.92,current)];
