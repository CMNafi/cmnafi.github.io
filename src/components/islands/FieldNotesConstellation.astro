---
import {getFieldNotesGraph} from '../../lib/field-notes-graph';
import {tracks,connectionsFor} from '../../data/field-notes-graph';
import {nodes as storySkills} from '../../data/professional/systems';
interface Props {compact?:boolean}
const {compact=false}=Astro.props;
const graph=await getFieldNotesGraph();
const posts=graph.nodes.filter(n=>n.nodeType!=='tool');
const entities=[...new Set(graph.nodes.flatMap(n=>n.sharedEntities))].sort();
const initial=graph.nodes.find(n=>n.id==='figma-the-billion-dollar-bet')!;
const initialConnections=connectionsFor(graph,initial.id);
const uid='nafi-constellation-stage';
---
<section class:list={['idea-atlas',{compact}]} id={uid} data-idea-atlas data-shared-story transition:name="nafi-constellation-stage" transition:persist="nafi-constellation-stage" aria-labelledby={`${uid}-title`}>
 <header class="atlas-heading"><div><p class="atlas-eyebrow">The research notebook / connected</p><h2 id={`${uid}-title`}>{compact?'One question leads to the next.':'An atlas of the notebook.'}</h2><p>{posts.length} notes · {graph.nodes.length-posts.length} related tools · {graph.nodes[0].publishedAt.slice(0,4)} to {posts.map(n=>n.publishedAt).sort().at(-1)!.slice(0,4)}</p></div><a href={compact?'/field-notes/':'#notes-ledger'}>{compact?'Explore the complete atlas ↗':'Go straight to the index ↓'}</a></header>
 <div class="atlas-mode-bar" role="group" aria-label="Choose archive view"><button type="button" data-atlas-mode="constellation" aria-pressed="true"><span>01</span> Related ideas</button><button type="button" data-atlas-mode="river" aria-pressed="false"><span>02</span> Browse by year</button><button type="button" data-atlas-mode="tracks" aria-pressed="false"><span>03</span> Guided reading lists</button></div>
 <div class="atlas-tracks" role="group" aria-label="Filter by reading track"><button type="button" data-atlas-track="0" aria-pressed="true">All ideas</button>{tracks.map(t=><button type="button" data-atlas-track={t.id} aria-pressed="false"><span>0{t.id}</span> {t.short}</button>)}</div>
 <div class="atlas-filters"><label>Type of entry<select data-atlas-stream aria-label="Filter archive stream"><option value="all">All streams</option><option value="essay">Essays & research</option><option value="book">Book notes</option><option value="cricket">Cricket logs</option><option value="tool">Related tools</option></select></label><label>Company or topic<select data-atlas-entity aria-label="Filter shared entity"><option value="">All companies & topics</option>{entities.map(entity=><option value={entity}>{entity}</option>)}</select></label><label class="atlas-search">Find a question<input type="search" data-atlas-search placeholder="Title, idea, ticker…" aria-label="Search the connected archive" /></label><button type="button" data-atlas-reset>Clear filters</button></div>
 <div class="atlas-year" data-atlas-year-panel hidden><label>Timeline lens · through <output data-atlas-year-label>2026</output><input type="range" min="2018" max="2026" step="1" value="2026" data-atlas-year aria-label="Timeline through year" /></label><p>Scroll the river sideways. The lens keeps earlier notes and their connections in view. Tool dates are catalog reference dates.</p></div>
 <div class="atlas-status-line"><p data-atlas-results role="status">{graph.nodes.length} results · {posts.length} notes + 7 tools</p><label><input type="checkbox" data-atlas-still /> Still view</label></div>
 <div class="atlas-workspace"><div class="atlas-visual"><div class="atlas-plot" data-atlas-plot tabindex="0" aria-label="Scrollable idea graph"><div class="atlas-surface" data-atlas-surface><canvas data-atlas-canvas aria-hidden="true"></canvas><svg data-atlas-svg aria-label="Interactive archive nodes" preserveAspectRatio="none"><g data-archive-layer>{graph.nodes.map(n=><g data-atlas-node={n.id} role="button" tabindex="0" aria-label={`Inspect ${n.title}`}><circle r="16" fill="transparent"/><text data-atlas-label x="12" y="4">{n.title.length>30?n.title.slice(0,28)+'…':n.title}</text></g>)}</g><g data-story-skill-layer style="display:none">{storySkills.map(n=><g data-story-skill={n.id} role="button" tabindex="0" aria-label={`Inspect capability ${n.label}`}><circle r="11" fill="transparent"/><text x="9" y="-7">{n.label}</text></g>)}</g></svg><div class="story-skill-inspector" data-story-skill-inspector hidden><button type="button" data-story-close-inspector aria-label="Close capability note">×</button><strong data-story-skill-title></strong><p data-story-skill-copy></p></div><div class="atlas-annotation" data-atlas-annotation hidden></div><p class="atlas-empty" data-atlas-empty hidden>No nodes match these filters. Try another stream or clear the filters.</p></div></div><div class="atlas-legend"><span class="finance">● Essays</span><span class="books">◆ Books</span><span class="cricket">⬡ Cricket</span><span class="tool">■ Tools</span><span>Essay size = reading time</span></div><div class="atlas-node-picker"><label for={`${uid}-pick`}>Inspect any result</label><select id={`${uid}-pick`} data-atlas-pick><option value="">Choose a title…</option>{graph.nodes.map(n=><option value={n.id}>{n.title}</option>)}</select></div><p class="atlas-hint">Select a dot or choose a title to preview a piece and its related reading. Select a reading list to narrow the index below. Drag dots to rearrange the map; Escape clears the selection.</p></div>
 <aside class="atlas-dossier" aria-label="Essay and lineage dossier"><div data-atlas-dossier><p class="atlas-eyebrow" data-dossier-type>Essay · {initial.subtopic}</p><h3 data-dossier-title>{initial.title}</h3><p class="atlas-dossier-meta" data-dossier-meta>{initial.publishedAt} · {initial.readingMinutes} min read</p><p data-dossier-summary>{initial.summary}</p><a class="atlas-read" data-dossier-read href={initial.href}>Read full essay →</a><h4>Why this connects</h4><ol data-dossier-connections>{initialConnections.map(c=><li><span>{c.relationship==='inspired-by-book'?'Book pairing':c.node.nodeType==='tool'?'Related tool':'Related reading'}</span><a href={c.node.href}>{c.node.title} ↗</a><p>{c.node.nodeType==='tool'?c.node.summary:c.annotation}</p><button type="button" data-atlas-inspect={c.node.id}>Show its connections</button></li>)}</ol></div><p class="atlas-curation">These are suggested connections across my reading, research, and cricket. Related tools include a preview of what you can do; R&D means the project is still in development.</p></aside></div>
 <div class="atlas-playlist" data-atlas-playlist hidden><h3 data-atlas-playlist-title>Curated reading order</h3><p data-atlas-playlist-description></p><ol data-atlas-playlist-items></ol></div>
 <noscript><p class="atlas-noscript">The animation needs JavaScript. {compact?<a href="/field-notes/#notes-ledger">Read every note in the archive index →</a>:<a href="#notes-ledger">Every note is available in the complete index below →</a>}</p><style>.atlas-workspace,.atlas-mode-bar,.atlas-tracks,.atlas-filters,.atlas-status-line{display:none!important}</style></noscript>
 <script is:inline type="application/json" data-atlas-data set:html={JSON.stringify(graph).replaceAll('<','\u003c')} />
</section>

<script>
import {makeStoryRenderer,type StoryScene} from '../../lib/story-layouts';
import {nodes as capabilities} from '../../data/professional/systems';
import {parseSpine,spineSlug} from '../../data/story-spines';
import {filterNodes,connectionsFor,type ArchiveGraph,type GraphNode} from '../../data/field-notes-graph';
interface MovingNode {node:GraphNode;x:number;y:number;vx:number;vy:number;tx:number;ty:number;alpha:number;r:number}
function initAtlases(){document.querySelectorAll<HTMLElement>('[data-idea-atlas]').forEach(candidate=>{
 if(candidate.dataset.ready){candidate.dispatchEvent(new Event('atlas:route'));return;}const root:HTMLElement=candidate,graph=JSON.parse(root.querySelector('[data-atlas-data]')!.textContent!) as ArchiveGraph;
 const canvas=root.querySelector<HTMLCanvasElement>('[data-atlas-canvas]')!,context=canvas.getContext('2d');if(!context)return;const ctx:CanvasRenderingContext2D=context;
 const plot=root.querySelector<HTMLElement>('[data-atlas-plot]')!,surface=root.querySelector<HTMLElement>('[data-atlas-surface]')!,svg=root.querySelector<SVGSVGElement>('[data-atlas-svg]')!,picker=root.querySelector<HTMLSelectElement>('[data-atlas-pick]')!,search=root.querySelector<HTMLInputElement>('[data-atlas-search]')!,stream=root.querySelector<HTMLSelectElement>('[data-atlas-stream]')!,entity=root.querySelector<HTMLSelectElement>('[data-atlas-entity]')!,year=root.querySelector<HTMLInputElement>('[data-atlas-year]')!,still=root.querySelector<HTMLInputElement>('[data-atlas-still]')!,annotation=root.querySelector<HTMLElement>('[data-atlas-annotation]')!;
 const motions=matchMedia('(prefers-reduced-motion: reduce)');let compact=location.pathname==='/',isHome=compact,scene:StoryScene={act:compact?1:4,local:0,tail:false,focus:false,reduce:false},storyRenderer=isHome?makeStoryRenderer():undefined,isolateLedger=false;root.dataset.engineId=crypto.randomUUID();root.classList.toggle('is-home-atlas',isHome);let reduce=motions.matches,view='constellation',spine=0,selected='',eligible=new Set(graph.nodes.map(n=>n.id)),thread=new Set<string>(),width=800,height=compact?340:520,visible=true,raf=0,last=0,time=0,dirty=true,disposed=false,dragged:MovingNode|null=null,dragMoved=0,hoverTimer=0;
 const models:MovingNode[]=graph.nodes.map((node,i)=>({node,x:100+(i%10)*55,y:80+Math.floor(i/10)*45,vx:0,vy:0,tx:0,ty:0,alpha:1,r:node.nodeType==='essay'?4+Math.sqrt(node.readingMinutes??5)*1.1:node.nodeType==='tool'?8:6})),byId=new Map(models.map(m=>[m.node.id,m])),nodeUI=new Map([...root.querySelectorAll<SVGGElement>('[data-atlas-node]')].map(g=>[g.dataset.atlasNode!,g]));const colors:Record<string,string>={};
 function theme(){const css=getComputedStyle(root);for(const key of ['finance','books','cricket','tool'])colors[key]=css.getPropertyValue(`--stream-${key}`).trim();colors.text=css.getPropertyValue('--text-secondary').trim();colors.muted=css.getPropertyValue('--text-muted').trim();colors.line=css.getPropertyValue('--border-hairline').trim();colors.paper=css.getPropertyValue('--bg-canvas').trim();dirty=true;schedule();}
 const color=(n:GraphNode)=>colors[n.nodeType==='book'?'books':n.nodeType==='essay'?'finance':n.nodeType];
 function orderedTrack(){const track=graph.tracks[(spine||1)-1],explicit=(track.ids as readonly string[]).filter(id=>eligible.has(id));return[...explicit,...graph.nodes.filter(n=>eligible.has(n.id)&&!explicit.includes(n.id)).map(n=>n.id)];}
 function layout(){
  const available=models.filter(m=>eligible.has(m.node.id));const oldWidth=width;const base=Math.max(280,plot.clientWidth);width=view==='river'?Math.max(2100,base):base;height=isHome?Math.max(150,Math.min(620,plot.clientHeight||380)):view==='river'?520:base<500?380:520;
  if(view==='tracks'){const cols=base<500?2:base<800?3:4;height=Math.max(compact?340:440,Math.ceil(available.length/cols)*100+70);}
  surface.style.width=`${width}px`;surface.style.height=`${height}px`;svg.setAttribute('viewBox',`0 0 ${width} ${height}`);const dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);
  for(const m of models){if(oldWidth!==width)m.x*=width/oldWidth;const n=m.node;
   if(view==='constellation'){if(n.nodeType==='tool'){const hubs=models.filter(m=>m.node.nodeType==='tool'),i=hubs.indexOf(m),angle=-Math.PI/2+i*Math.PI*2/hubs.length;m.tx=width/2+Math.cos(angle)*(width/2-46);m.ty=height/2+Math.sin(angle)*(height/2-42);}else{const group=available.filter(m=>m.node.spineId===n.spineId&&m.node.nodeType!=='tool'),index=group.indexOf(m),angle=index*2.399963;const oneGroup=new Set(available.filter(m=>m.node.nodeType!=='tool').map(m=>m.node.spineId)).size===1,centerX=oneGroup?width/2:width*(.25+((n.spineId-1)%3)*.25),centerY=oneGroup?height/2:height*(n.spineId<=3?.32:.68),radius=Math.sqrt(index+1)*Math.min(oneGroup?35:17,width/(oneGroup?12:34));m.tx=Math.max(26,Math.min(width-26,centerX+Math.cos(angle)*radius));m.ty=Math.max(34,Math.min(height-34,centerY+Math.sin(angle)*radius));}}
   else if(view==='river'){const start=Date.UTC(2018,0,1),end=Date.UTC(2027,0,1),date=Date.parse(n.publishedAt);m.tx=65+(date-start)/(end-start)*(width-130);const same=available.filter(x=>x.node.nodeType===n.nodeType&&x.node.publishedAt.slice(0,4)===n.publishedAt.slice(0,4));const index=same.indexOf(m);m.ty=n.nodeType==='book'?100+(index%3)*24:n.nodeType==='cricket'?220+(index%3)*24:n.nodeType==='tool'?height-36:340+(index%6)*23;m.tx+=(Math.floor(index/6)%3)*15;}
   else {const list=orderedTrack(),index=list.indexOf(n.id),cols=base<500?2:base<800?3:4,row=Math.floor(Math.max(0,index)/cols),column=Math.max(0,index)%cols;m.tx=((row%2?cols-1-column:column)+.5)*width/cols;m.ty=56+row*100;}
   if(reduce){m.x=m.tx;m.y=m.ty;m.vx=m.vy=0;}
  }dirty=true;schedule();
 }
 function updateURL(){if(isHome)return;const url=new URL(location.href);for(const key of ['view','spine','stream','entity','q','through','node','category'])url.searchParams.delete(key);if(view!=='constellation')url.searchParams.set('view',view);if(spine)url.searchParams.set('spine',spineSlug(spine));if(stream.value!=='all')url.searchParams.set('stream',stream.value);if(entity.value)url.searchParams.set('entity',entity.value);if(search.value)url.searchParams.set('q',search.value);if(view==='river'&&Number(year.value)<2026)url.searchParams.set('through',year.value);if(selected)url.searchParams.set('node',selected);history.replaceState(null,'',url);}
 function update(){eligible=new Set(filterNodes(graph.nodes,{spine,stream:stream.value,entity:entity.value,query:search.value,throughYear:view==='river'?Number(year.value):undefined}).map(n=>n.id));document.querySelectorAll<HTMLElement>('[data-atlas-row]').forEach(row=>row.hidden=!eligible.has(row.dataset.atlasRow!));const notes=graph.nodes.filter(n=>eligible.has(n.id)&&n.nodeType!=='tool').length,tools=eligible.size-notes;root.querySelector('[data-atlas-results]')!.textContent=`${eligible.size} results · ${notes} ${notes===1?'note':'notes'} + ${tools} ${tools===1?'tool':'tools'}`;root.querySelector<HTMLElement>('[data-atlas-empty]')!.hidden=eligible.size>0;const emptyLedger=document.querySelector<HTMLElement>('[data-atlas-empty-ledger]');if(emptyLedger)emptyLedger.hidden=eligible.size>0;
  for(const option of picker.options)if(option.value)option.hidden=!eligible.has(option.value);for(const [id,g]of nodeUI){g.style.display=eligible.has(id)?'':'none';g.setAttribute('tabindex',eligible.has(id)?'0':'-1');g.setAttribute('aria-hidden',String(!eligible.has(id)));}
  root.querySelectorAll<HTMLButtonElement>('[data-atlas-track]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.atlasTrack)===spine)));root.querySelectorAll<HTMLButtonElement>('[data-atlas-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.atlasMode===view)));root.querySelector<HTMLElement>('[data-atlas-year-panel]')!.hidden=view!=='river';root.querySelector('[data-atlas-year-label]')!.textContent=year.value;root.querySelector<HTMLElement>('[data-atlas-playlist]')!.hidden=view!=='tracks';
  root.querySelector<HTMLElement>('[data-atlas-dossier]')!.hidden=eligible.size===0;if(!selected||!eligible.has(selected)){selected='';const first=graph.nodes.find(n=>eligible.has(n.id));if(first)inspect(first.id,false);}thread.clear();if(selected)thread=new Set([selected,...connectionsFor(graph,selected).map(c=>c.node.id)]);picker.value=selected;renderPlaylist();layout();syncLedger();updateURL();
 }
 function renderPlaylist(){if(view!=='tracks')return;const t=graph.tracks[(spine||1)-1];root.querySelector('[data-atlas-playlist-title]')!.textContent=`0${t.id} / ${t.name}`;root.querySelector('[data-atlas-playlist-description]')!.textContent=t.description+' The numbered main path is followed by further reading.';const list=root.querySelector('[data-atlas-playlist-items]')!;list.replaceChildren();for(const id of orderedTrack()){const n=byId.get(id)!.node,li=document.createElement('li'),a=document.createElement('a');a.href=n.href;a.textContent=n.title;li.append(a);const info=document.createElement('span');info.textContent=n.nodeType==='tool'?`Related tool · ${n.status}`:(t.ids as readonly string[]).includes(id)?'Main reading path':'Further reading';li.append(info);list.append(li);}}
 function inspect(id:string,sync=true){const model=byId.get(id);if(!model)return;selected=id;const n=model.node,connections=connectionsFor(graph,id);thread=new Set([id,...connections.map(c=>c.node.id)]);picker.value=id;root.querySelector('[data-dossier-type]')!.textContent=`${n.nodeType==='tool'?'Related tool':n.nodeType==='book'?'Book note':n.nodeType==='cricket'?'Cricket log':'Essay'} · ${n.subtopic??''}`;root.querySelector('[data-dossier-title]')!.textContent=n.title;root.querySelector('[data-dossier-meta]')!.textContent=n.nodeType==='tool'?`${n.status} · Catalog reference ${n.publishedAt}`:`${n.publishedAt} · ${n.readingMinutes} min read`;root.querySelector('[data-dossier-summary]')!.textContent=n.summary;const read=root.querySelector<HTMLAnchorElement>('[data-dossier-read]')!;read.href=n.href;read.textContent=n.nodeType==='tool'?`${n.status==='R&D'?'Read the development plan':n.id==='tool-regulatory-lens'?'Read the project write-up':'Open the tool'} →`:'Read full essay →';const list=root.querySelector('[data-dossier-connections]')!;list.replaceChildren();for(const c of connections){const li=document.createElement('li'),label=document.createElement('span'),a=document.createElement('a'),p=document.createElement('p'),button=document.createElement('button');label.textContent=c.relationship==='inspired-by-book'?'Book pairing':c.node.nodeType==='tool'?'Related tool':'Related reading';a.href=c.node.href;a.textContent=c.node.title+' ↗';p.textContent=c.node.nodeType==='tool'?c.node.summary:c.annotation;button.type='button';button.textContent='Show its connections';button.addEventListener('click',()=>{if(!eligible.has(c.node.id)){reset(false);}inspect(c.node.id);});li.append(label,a,p,button);list.append(li);}root.dataset.selected=id;dirty=true;schedule();if(sync){isolateLedger=true;syncLedger();updateURL();}}
 function reset(sync=true){isolateLedger=false;spine=0;stream.value='all';entity.value='';search.value='';year.value='2026';selected='';if(view==='tracks')spine=1;update();if(sync)updateURL();}
 function chooseMode(mode:string){view=mode;if(view==='tracks'&&!spine)spine=1;root.dataset.view=view;plot.scrollLeft=0;update();}
 function polygon(x:number,y:number,r:number,sides:number,angle=0){ctx.beginPath();for(let i=0;i<sides;i++){const a=angle+i*Math.PI*2/sides;i?ctx.lineTo(x+Math.cos(a)*r,y+Math.sin(a)*r):ctx.moveTo(x+Math.cos(a)*r,y+Math.sin(a)*r);}ctx.closePath();}
 function edgePath(a:MovingNode,b:MovingNode){const mid=(a.x+b.x)/2;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.bezierCurveTo(mid,a.y,mid,b.y,b.x,b.y);}
 function draw(delta:number){const started=performance.now();ctx.setTransform(canvas.width/width,0,0,canvas.height/height,0,0);ctx.clearRect(0,0,width,height);ctx.globalAlpha=1;
  const archiveLayer=root.querySelector<SVGGElement>('[data-archive-layer]')!,skillLayer=root.querySelector<SVGGElement>('[data-story-skill-layer]')!;archiveLayer.style.display=isHome&&scene.act<4?'none':'';skillLayer.style.display=isHome&&scene.act===3?'':'none';
  if(isHome){storyRenderer??=makeStoryRenderer();storyRenderer.render(ctx,width,height,delta,time,{...scene,reduce:reduce||scene.reduce},{forest:colors.finance,amber:colors.books,red:colors.cricket,blue:colors.tool,line:colors.line,muted:colors.muted,text:colors.text},models);if(scene.act===3){root.querySelectorAll<SVGGElement>('[data-story-skill]').forEach((g,i)=>g.setAttribute('transform', 'translate('+storyRenderer!.layouts.skillPositions[i*2]*width+' '+storyRenderer!.layouts.skillPositions[i*2+1]*height+')'));}if(scene.act<4){root.dataset.renderMs=(performance.now()-started).toFixed(2);root.dataset.rendered='true';dirty=false;return;}}

  if(view==='river'){ctx.font='11px JetBrains Mono, monospace';ctx.fillStyle=colors.muted;for(let y=2018;y<=2026;y++){const x=65+(y-2018)/9*(width-130);ctx.fillText(String(y),x,24);ctx.strokeStyle=colors.line;ctx.lineWidth=.6;ctx.beginPath();ctx.moveTo(x,34);ctx.lineTo(x,height-15);ctx.stroke();}for(const [label,y,key]of [['Book notes',84,'books'],['Cricket logs',205,'cricket'],['Essays & research',322,'finance'],['Related tools',height-58,'tool']] as const){ctx.fillStyle=colors[key];ctx.fillText(label,12,y);ctx.strokeStyle=colors.line;ctx.beginPath();ctx.moveTo(12,y+7);ctx.lineTo(width-12,y+7);ctx.stroke();}}
  if(view==='constellation'){ctx.font='10px JetBrains Mono, monospace';ctx.fillStyle=colors.muted;for(const t of graph.tracks.filter(t=>models.some(m=>eligible.has(m.node.id)&&m.node.spineId===t.id))){const x=width*(.25+((t.id-1)%3)*.25),y=height*(t.id<=3?.15:.85);ctx.globalAlpha=.65;ctx.textAlign='center';ctx.fillText(width<600?`0${t.id} ${t.short.split(' ')[0]}`:`0${t.id} / ${t.short}`,x,y);}ctx.textAlign='left';}
  const active=models.filter(m=>eligible.has(m.node.id));if(!reduce&&view==='constellation'){for(let i=0;i<active.length;i++)for(let j=i+1;j<active.length;j++){const a=active[i],b=active[j],dx=a.x-b.x,dy=a.y-b.y,d=Math.max(2,Math.hypot(dx,dy)),limit=a.r+b.r+15;if(d<limit){const force=(limit-d)*.025;a.vx+=dx/d*force;b.vx-=dx/d*force;a.vy+=dy/d*force;b.vy-=dy/d*force;}}}
  for(const m of models){const targetAlpha=!eligible.has(m.node.id)?0:selected&&!thread.has(m.node.id)?.15:1;m.alpha=reduce?targetAlpha:m.alpha+(targetAlpha-m.alpha)*.18;if(!eligible.has(m.node.id))continue;if(m!==dragged){if(reduce){m.x=m.tx;m.y=m.ty;}else{const ticks=Math.min(2,Math.max(.5,delta/16.667));m.vx=(m.vx+(m.tx-m.x)*.085*ticks)*Math.pow(.78,ticks);m.vy=(m.vy+(m.ty-m.y)*.085*ticks)*Math.pow(.78,ticks);m.x=Math.max(14,Math.min(width-14,m.x+m.vx*ticks));m.y=Math.max(20,Math.min(height-20,m.y+m.vy*ticks));}}}
  let primary:ArchiveGraph['edges'][number]|undefined;const drawn=new Set<string>();for(const e of graph.edges){const a=byId.get(e.sourceId)!,b=byId.get(e.targetId)!;if(!eligible.has(a.node.id)||!eligible.has(b.node.id))continue;const key=[a.node.id,b.node.id].sort().join('|');if(drawn.has(key))continue;drawn.add(key);const related=selected&&thread.has(a.node.id)&&thread.has(b.node.id);if(related&&!primary&&(a.node.id===selected||b.node.id===selected))primary=e;ctx.globalAlpha=related?.7:selected?.035:.1;ctx.strokeStyle=related?color(a.node.nodeType==='book'?a.node:b.node):colors.line;ctx.lineWidth=related?1.4:.7;edgePath(a,b);ctx.stroke();if(related&&!reduce){const t=(time*.0001+e.sourceId.length*.057)%1,u=1-t,mid=(a.x+b.x)/2,x=u*u*u*a.x+3*u*u*t*mid+3*u*t*t*mid+t*t*t*b.x,y=u*u*u*a.y+3*u*u*t*a.y+3*u*t*t*b.y+t*t*t*b.y;ctx.globalAlpha=.95;ctx.fillStyle=color(b.node);ctx.beginPath();ctx.arc(x,y,2.5,0,Math.PI*2);ctx.fill();}}
