---
import {nodes,eras,categories} from '../../data/professional/systems';
---
<section class="professional" id="professional" data-professional aria-labelledby="professional-title">
  <header class="professional-intro"><div><p class="professional-kicker">Professional practice / 01 to 05</p><h2 id="professional-title">Different industries.<br/>A clearer <em>way to think.</em></h2></div><div><p>Follow the work from statistical foundations to institutional software. Select a capability to see what it depends on, and what it makes possible.</p><a href="#professional-foundations">Explore the architecture ↓</a><a href="#garage">Skip to the tools ↗</a></div></header>
  <div class="professional-grid">
    <figure class="professional-stage" aria-label="Interactive professional systems architecture">
      <div class="professional-readout"><div><span data-pro-domain>01 / Statistical computing</span><strong data-pro-org>Luther College</strong></div><div class="professional-count"><output data-pro-count>8</output><span>active capabilities</span></div><p data-pro-scale>Foundational models</p></div>
      <div class="professional-lenses" role="group" aria-label="Highlight architecture by category"><button type="button" data-pro-filter="all" aria-pressed="true">All <span data-pro-total>(8 / 42)</span></button>{categories.map(c=><button type="button" data-pro-filter={c.id} aria-label={c.label} aria-pressed="false"><i class={`pro-${c.id}`} aria-hidden="true"></i>{c.label}</button>)}</div>
      <div class="professional-surface"><canvas data-pro-canvas aria-hidden="true"></canvas><svg data-pro-svg class="professional-svg" preserveAspectRatio="none" viewBox="0 0 800 520" aria-label="Inspect capability nodes"><g data-pro-edge-hits aria-hidden="true"></g><g>{nodes.map(n=><g data-pro-node={n.id} role="button" tabindex={n.era===1?0:-1} aria-label={`Inspect ${n.label}`} aria-hidden={n.era>1?'true':undefined} class={`pro-${n.category}`} style={n.era>1?'display:none':undefined}><rect x="-61" y="-14" width="122" height="29" rx="3"/><circle r="4" cx="-53"/><text x="-42" y="4">{n.label.length>23?n.label.slice(0,21)+'…':n.label}</text></g>)}</g></svg><div class="professional-edge-note" data-pro-edge-note hidden></div><div class="professional-inspector" data-pro-inspector role="region" aria-label="Technical specification" aria-live="polite" hidden><button type="button" data-pro-close aria-label="Close technical specification">×</button><span data-pro-category></span><strong data-pro-name></strong><p data-pro-unlocked></p><p data-pro-summary></p><p data-pro-status></p><nav data-pro-links aria-label="Related projects and research"></nav><button type="button" data-pro-clear>Show the whole architecture</button></div></div>
      <figcaption><p class="professional-scene" data-pro-scene>Inputs → transformations → validated outputs</p><div class="professional-access"><label for="professional-node-select">Inspect a capability</label><select id="professional-node-select" data-pro-select><option value="">Choose a node…</option>{nodes.map(n=><option value={n.id} disabled={n.era>1}>{n.label}</option>)}</select></div><nav class="professional-eras" aria-label="Choose a professional stage">{eras.map((era,i)=><a href={`#professional-${era.id}`} data-pro-era={i} aria-current={i===0?'step':undefined}><span>0{i+1}</span>{era.name}</a>)}</nav><div class="professional-playback"><label><span class="professional-sr">Professional timeline progress</span><input type="range" min="0" max="1" step="0.001" value="0" data-pro-scrub aria-label="Scrub professional timeline" /></label><button type="button" data-pro-reset>Reset graph</button><label class="professional-still"><input type="checkbox" data-pro-still /> Still view</label></div><p class="professional-hint">Select to trace dependencies. Drag a node; arrow keys move it. Escape clears.</p></figcaption>
    </figure>
    <div class="professional-steps">{eras.map((era,i)=><article class="professional-step" id={`professional-${era.id}`} data-pro-step={i} aria-labelledby={`professional-heading-${i}`}><p class="professional-kicker">Stage {['I','II','III','IV','V'][i]} · {era.domain}</p><p class="professional-role">{era.organization}<span>{era.role} · {era.period}</span></p><h3 id={`professional-heading-${i}`}>{era.title}</h3><p class="professional-thesis">{era.thesis}</p><div class="professional-pills" role="group" aria-label={`Trace capabilities from ${era.organization}`}>{era.pills.map(id=>{const node=nodes.find(n=>n.id===id)!;return <button type="button" data-pro-pill={id} aria-pressed="false" class={`pro-${node.category}`}>{node.label}</button>})}</div><div class="professional-output"><span>Work & related outputs</span><p>{era.output}</p><nav>{era.links.map(link=><a href={link.href}>{link.label} ↗</a>)}</nav></div>{'credentials' in era&&era.credentials&&<details><summary>Technical credentials</summary><ul>{era.credentials.map(c=><li>{c}</li>)}</ul></details>}</article>)}</div>
  </div>
  <footer class="professional-footnote"><p>42 capability nodes, with related technologies grouped. Connections explain dependencies; layout and signal packets are illustrative. They reveal no employer systems, records, or measured flows. Era labels describe career chapters, not dates of tool adoption.</p><p>Career details and credentials follow the supplied professional brief and documented biography. Independent tools and later essays are labeled separately. <a href="https://www.linkedin.com/in/cm-nafi/" target="_blank" rel="noopener noreferrer">Professional profile ↗</a></p><noscript><p>The five complete stages and project links are available below without animation.</p></noscript></footer>
  <noscript><style>.professional-stage{display:none!important}.professional-grid{display:block!important;min-height:0!important}.professional-step{min-height:0!important;padding:2rem 0!important}.professional-pills button{pointer-events:none}</style></noscript>
</section>

<script>
import {nodes as catalog,eras,categories,edges,traceDependencies,bezier,type Capability,type Category} from '../../data/professional/systems';
interface SkillNode extends Capability {x:number;y:number;vx:number;vy:number;targetX:number;targetY:number;radius:number;alpha:number}
function initProfessional(){
 const candidate=document.querySelector<HTMLElement>('[data-professional]');if(!candidate||candidate.dataset.ready)return;const root:HTMLElement=candidate;
 const canvas=root.querySelector<HTMLCanvasElement>('[data-pro-canvas]')!,context=canvas.getContext('2d');if(!context)return;const ctx:CanvasRenderingContext2D=context;
 const surface=root.querySelector<HTMLElement>('.professional-surface')!,svg=root.querySelector<SVGSVGElement>('[data-pro-svg]')!,stage=root.querySelector<HTMLElement>('.professional-stage')!,steps=[...root.querySelectorAll<HTMLElement>('[data-pro-step]')];
 const pills=[...root.querySelectorAll<HTMLButtonElement>('[data-pro-pill]')],eraLinks=[...root.querySelectorAll<HTMLAnchorElement>('[data-pro-era]')],filters=[...root.querySelectorAll<HTMLButtonElement>('[data-pro-filter]')],select=root.querySelector<HTMLSelectElement>('[data-pro-select]')!,scrub=root.querySelector<HTMLInputElement>('[data-pro-scrub]')!,still=root.querySelector<HTMLInputElement>('[data-pro-still]')!,inspector=root.querySelector<HTMLElement>('[data-pro-inspector]')!,edgeNote=root.querySelector<HTMLElement>('[data-pro-edge-note]')!;
 const motion=matchMedia('(prefers-reduced-motion: reduce)');let reduce=motion.matches,activeEra=1,progress=0,selected='',lens:Category|'all'='all',related=new Set<string>(),visible=true,raf=0,last=0,time=0,dirty=true,disposed=false,width=800,height=520,dpr=1,dragged:SkillNode|null=null,dragDistance=0,hoverBlockedUntil=0,pointerStart={x:0,y:0};
 const models:SkillNode[]=catalog.map((n,i)=>({...n,x:70+(i%4)*200,y:100+(i%8)*40,vx:0,vy:0,targetX:0,targetY:0,radius:4,alpha:n.era===1?1:0})),byId=new Map(models.map(n=>[n.id,n]));
 const nodeUI=new Map([...root.querySelectorAll<SVGGElement>('[data-pro-node]')].map(g=>[g.dataset.proNode!,g]));const color:Record<string,string>={};
 function theme(){const style=getComputedStyle(root);for(const c of categories)color[c.id]=style.getPropertyValue(`--node-${c.id}`).trim();color.text=style.getPropertyValue('--text-primary').trim();color.muted=style.getPropertyValue('--text-muted').trim();color.border=style.getPropertyValue('--border-hairline').trim();color.surface=style.getPropertyValue('--bg-surface').trim();dirty=true;schedule();}
 function layout(){
  for(const [column,c]of categories.entries()){const group=models.filter(n=>n.category===c.id&&n.era<=activeEra);group.forEach((n,i)=>{n.targetX=88+column*208;n.targetY=118+(i+.5)*(height-142)/Math.max(group.length,5);if(reduce){n.x=n.targetX;n.y=n.targetY;n.vx=n.vy=0;}});}
 }
 function setEra(era:number){era=Math.max(1,Math.min(5,era));if(era===activeEra&&root.dataset.era)return;activeEra=era;root.dataset.era=String(era);const copy=eras[era-1],count=models.filter(n=>n.era<=era).length;
  root.querySelector('[data-pro-domain]')!.textContent=`0${era} / ${copy.domain}`;root.querySelector('[data-pro-org]')!.textContent=copy.organization;root.querySelector('[data-pro-count]')!.textContent=String(count);root.querySelector('[data-pro-total]')!.textContent=`(${count} / 42)`;root.querySelector('[data-pro-scale]')!.textContent=copy.scale;
  root.querySelector('[data-pro-scene]')!.textContent=['Inputs → transformations → validated outputs','Clinical inputs → validation → ETL → research reporting','200 illustrated profiles → screening lenses → portfolio context','Mandates → attribution → readable decisions','Research informs tools. Tools reveal the next research question.'][era-1];
  for(const n of models){const unlocked=n.era<=era,g=nodeUI.get(n.id)!;g.style.display=unlocked?'':'none';g.setAttribute('aria-hidden',String(!unlocked));g.setAttribute('tabindex',unlocked?'0':'-1');}for(const option of select.options){const n=byId.get(option.value);if(n)option.disabled=n.era>era;}
  eraLinks.forEach((link,i)=>{if(i===era-1)link.setAttribute('aria-current','step');else link.removeAttribute('aria-current');});steps.forEach((step,i)=>step.classList.toggle('is-active',i===era-1));if(selected&&byId.get(selected)!.era>era)clear();else if(selected)related=traceDependencies(selected,models.filter(n=>n.era<=era));layout();dirty=true;
 }
 function setProgress(value:number){progress=Math.max(0,Math.min(1,value));scrub.value=String(progress);setEra(Math.min(5,Math.floor(progress*5)+1));dirty=true;schedule();}
 function inspect(id:string){const n=byId.get(id);if(!n||n.era>activeEra)return;selected=id;related=traceDependencies(id,models.filter(n=>n.era<=activeEra));inspector.hidden=false;select.value=id;root.querySelector('[data-pro-category]')!.textContent=categories.find(c=>c.id===n.category)!.label;root.querySelector('[data-pro-name]')!.textContent=n.label;root.querySelector('[data-pro-unlocked]')!.textContent=`Stage ${['I','II','III','IV','V'][n.era-1]} · ${eras[n.era-1].organization}`;root.querySelector('[data-pro-summary]')!.textContent=n.summary;root.querySelector('[data-pro-status]')!.textContent=n.status??'Capability / conceptual dependency';const links=root.querySelector('[data-pro-links]')!;links.replaceChildren();for(const item of n.links??[{label:'Explore the Garage',href:'/garage/'},{label:'Read Field Notes',href:'/field-notes/'}]){const a=document.createElement('a');a.href=item.href;a.textContent=item.label+' ↗';links.append(a);}pills.forEach(p=>p.setAttribute('aria-pressed',String(p.dataset.proPill===id)));dirty=true;schedule();}
 function clear(){hoverBlockedUntil=performance.now()+600;selected='';related.clear();inspector.hidden=true;select.value='';pills.forEach(p=>p.setAttribute('aria-pressed','false'));dirty=true;schedule();}
 const edgeUI:SVGPathElement[]=[];const hitGroup=root.querySelector('[data-pro-edge-hits]')!;for(const edge of edges){const path=document.createElementNS('http://www.w3.org/2000/svg','path');path.setAttribute('fill','none');path.setAttribute('stroke','transparent');path.setAttribute('stroke-width','12');path.style.pointerEvents='stroke';path.addEventListener('pointerenter',()=>{if(activeEra!==4)return;edgeNote.hidden=false;edgeNote.textContent=`${byId.get(edge.source)!.label} → ${byId.get(edge.target)!.label} · conceptual dependency, no measured flow weight`;});path.addEventListener('pointerleave',()=>edgeNote.hidden=true);hitGroup.append(path);edgeUI.push(path);}
 function resize(){const rect=surface.getBoundingClientRect();width=800;height=Math.max(620,Math.min(760,rect.height/Math.max(rect.width,1)*800));dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(rect.width*dpr);canvas.height=Math.round(rect.height*dpr);svg.setAttribute('viewBox',`0 0 ${width} ${height}`);layout();dirty=true;schedule();}
 function path(a:SkillNode,b:SkillNode){const mid=(a.x+b.x)/2;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.bezierCurveTo(mid,a.y,mid,b.y,b.x,b.y);return `M${a.x},${a.y}C${mid},${a.y} ${mid},${b.y} ${b.x},${b.y}`;}
 function alpha(n:SkillNode){return n.era>activeEra?0:selected?(related.has(n.id)?1:.18):lens==='all'||n.category===lens?1:.18;}
 function draw(delta:number){const start=performance.now(),active=models.filter(n=>n.era<=activeEra);ctx.setTransform(canvas.width/width,0,0,canvas.height/height,0,0);ctx.clearRect(0,0,width,height);
  ctx.strokeStyle=color.border;ctx.lineWidth=.6;ctx.globalAlpha=.6;for(let x=24;x<width;x+=24){ctx.beginPath();ctx.moveTo(x,86);ctx.lineTo(x,height);ctx.stroke();}for(let y=94;y<height;y+=24){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(width,y);ctx.stroke();}ctx.globalAlpha=1;
  // This band is a schematic for the active domain, never private data or live metrics.
  ctx.font='11px Inter, sans-serif';ctx.textAlign='left';ctx.fillStyle=color.muted;
  if(activeEra===1){['Input','Transform','Validate'].forEach((label,i)=>{ctx.fillText(label,45+i*275,28);for(let j=0;j<12;j++){ctx.globalAlpha=.18+(j%3)*.12;ctx.fillStyle=color.language;ctx.fillRect(45+i*275+(j%6)*14,40+Math.floor(j/6)*12,7,7);}});}
  if(activeEra===2){['Clinical streams','Validation gate','ETL engine','Research reports'].forEach((label,i)=>{ctx.globalAlpha=1;ctx.strokeStyle=color.border;ctx.strokeRect(12+i*200,12,174,56);ctx.fillStyle=color.text;ctx.fillText(label,24+i*200,34);for(let j=0;j<7;j++){const t=reduce?j/7:(j/7+time*.00018)%1;ctx.fillStyle=color.infra;ctx.globalAlpha=.6;ctx.beginPath();ctx.arc(24+i*200+t*143,50+(i===0?Math.sin(j*2+time*.002)*5:0),1.5,0,Math.PI*2);ctx.fill();}});}
  if(activeEra===3){for(let i=0;i<200;i++){ctx.globalAlpha=.18+(i%5===0?.5:0);ctx.fillStyle=color.infra;ctx.beginPath();ctx.arc(18+(i%40)*4.5,14+Math.floor(i/40)*9,1.3,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;ctx.fillStyle=color.muted;ctx.fillText('Liquidity / drawdown / correlation',220,32);ctx.strokeStyle=color.concept;ctx.beginPath();ctx.moveTo(530,62);ctx.bezierCurveTo(565,22,630,15,740,12);ctx.stroke();ctx.fillText('Illustrated frontier',560,75);}
  if(activeEra===4){['Mandates','Risk & attribution','Performance','Research'].forEach((label,i)=>{ctx.globalAlpha=1;ctx.fillStyle=color.muted;ctx.fillText(label,20+i*200,24);if(i<3){ctx.strokeStyle=color.concept;ctx.lineWidth=3+i*2;ctx.globalAlpha=.28;ctx.beginPath();ctx.moveTo(28+i*200,50);ctx.bezierCurveTo(100+i*200,26,125+i*200,67,190+i*200,42);ctx.stroke();}});ctx.lineWidth=1;}
  if(activeEra===5){ctx.globalAlpha=.7;ctx.strokeStyle=color.project;ctx.setLineDash([4,5]);ctx.beginPath();ctx.moveTo(65,45);ctx.bezierCurveTo(180,5,620,5,735,45);ctx.bezierCurveTo(620,84,180,84,65,45);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle=color.muted;ctx.globalAlpha=1;ctx.fillText('Independent research ↔ public tools',285,48);if(!reduce){const t=(time*.00005)%1;ctx.fillStyle=color.project;ctx.beginPath();ctx.arc(400+335*Math.cos(t*Math.PI*2),45+28*Math.sin(t*Math.PI*2),3,0,Math.PI*2);ctx.fill();}}
  ctx.globalAlpha=1;ctx.font='10px JetBrains Mono, monospace';categories.forEach((c,i)=>{ctx.fillStyle=color[c.id];ctx.fillText(c.short.toUpperCase(),30+i*208,101);});
  // Repulsion is restricted to a layer; canonical rows reserve space for labels.
  if(!reduce)for(let i=0;i<active.length;i++)for(let j=i+1;j<active.length;j++){const a=active[i],b=active[j];if(a.category!==b.category)continue;const dx=a.x-b.x,dy=a.y-b.y,dist=Math.max(8,Math.hypot(dx,dy));if(dist<43){const force=(43-dist)*.008;a.vy+=dy/dist*force;b.vy-=dy/dist*force;}}
  for(const n of models){const target=alpha(n);n.alpha=reduce?target:n.alpha+(target-n.alpha)*.15;if(n.era>activeEra)continue;if(n!==dragged){if(reduce){n.x=n.targetX;n.y=n.targetY;}else{const ticks=Math.min(2,Math.max(.5,delta/16.667));n.vx=(n.vx+(n.targetX-n.x)*.085*ticks)*Math.pow(.80,ticks);n.vy=(n.vy+(n.targetY-n.y)*.085*ticks)*Math.pow(.80,ticks);n.x+=n.vx*ticks;n.y+=n.vy*ticks;}}}
  edges.forEach((edge,i)=>{const a=byId.get(edge.source)!,b=byId.get(edge.target)!,enabled=a.era<=activeEra&&b.era<=activeEra;const hit=edgeUI[i];hit.style.display=enabled?'':'none';if(!enabled)return;const traced=selected&&related.has(a.id)&&related.has(b.id);ctx.globalAlpha=Math.min(a.alpha,b.alpha)*(traced?.8:.22);ctx.strokeStyle=traced?color.project:color[b.category];ctx.lineWidth=traced?1.8:1;hit.setAttribute('d',path(a,b));ctx.stroke();if(!reduce){const pos=bezier((time*(activeEra===2?.00017:.000065)+i*.137)%1,a,b);ctx.globalAlpha=Math.min(a.alpha,b.alpha)*.75;ctx.fillStyle=traced?color.project:color[b.category];ctx.beginPath();ctx.arc(pos.x,pos.y,traced?2.3:1.5,0,Math.PI*2);ctx.fill();}});
  ctx.globalAlpha=1;for(const n of active){const g=nodeUI.get(n.id)!;g.setAttribute('transform',`translate(${n.x.toFixed(2)} ${n.y.toFixed(2)})`);g.style.opacity=String(n.alpha);g.classList.toggle('is-selected',n.id===selected);g.setAttribute('aria-pressed',String(n.id===selected));}
  root.dataset.renderMs=(performance.now()-start).toFixed(2);root.dataset.rendered='true';dirty=false;
 }
 function frame(now:number){raf=0;if(disposed||!visible||document.hidden)return;const delta=last?now-last:16.667;if(delta<15&&!reduce){schedule();return;}last=now;if(!reduce)time+=Math.min(delta,50);if(dirty||!reduce)draw(delta);if(!reduce)schedule();}
 function schedule(){if(!raf&&!disposed&&visible&&!document.hidden)raf=requestAnimationFrame(frame);}
 function scroll(){const probe=innerWidth<900?Math.min(innerHeight-40,stage.getBoundingClientRect().bottom+innerHeight*.18):innerHeight*.5,centers=steps.map(s=>{const rect=s.getBoundingClientRect();return rect.top+rect.height*.5;});let p=0;if(centers[0]<=probe){p=1;for(let i=0;i<4;i++)if(centers[i+1]>=probe){p=(i+(probe-centers[i])/(centers[i+1]-centers[i]))/4;break;}}setProgress(p);}
 function goEra(index:number){clear();steps[index].scrollIntoView({behavior:reduce?'instant':'smooth',block:'center'});setProgress((index+.15)/5);}
 eraLinks.forEach((a,i)=>a.addEventListener('click',event=>{event.preventDefault();goEra(i);}));
 pills.forEach(p=>p.addEventListener('click',()=>{const n=byId.get(p.dataset.proPill!)!;if(n.era>activeEra){setProgress((n.era-1+.15)/5);}inspect(n.id);}));
 filters.forEach(b=>b.addEventListener('click',()=>{clear();lens=b.dataset.proFilter as Category|'all';filters.forEach(f=>f.setAttribute('aria-pressed',String(f===b)));dirty=true;schedule();}));
 select.addEventListener('change',()=>select.value?inspect(select.value):clear());root.querySelector('[data-pro-close]')!.addEventListener('click',clear);root.querySelector('[data-pro-clear]')!.addEventListener('click',clear);
 function point(event:PointerEvent){const rect=surface.getBoundingClientRect();return{x:(event.clientX-rect.left)/rect.width*width,y:(event.clientY-rect.top)/rect.height*height};}
 for(const [id,g]of nodeUI){g.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse'&&!dragged&&performance.now()>hoverBlockedUntil)inspect(id);});g.addEventListener('click',()=>{if(dragDistance<8)inspect(id);dragDistance=0;});g.addEventListener('keydown',event=>{const n=byId.get(id)!;if(event.key==='Enter'||event.key===' '){event.preventDefault();inspect(id);}if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)){event.preventDefault();n.x+=event.key==='ArrowLeft'?-12:event.key==='ArrowRight'?12:0;n.y+=event.key==='ArrowUp'?-12:event.key==='ArrowDown'?12:0;n.vx=n.vy=0;inspect(id);dirty=true;schedule();}});g.addEventListener('pointerdown',event=>{dragged=byId.get(id)!;dragDistance=0;pointerStart=point(event);g.setPointerCapture(event.pointerId);inspect(id);});g.addEventListener('pointermove',event=>{if(!dragged||dragged.id!==id)return;const p=point(event);dragDistance=Math.hypot(p.x-pointerStart.x,p.y-pointerStart.y);dragged.x=Math.max(62,Math.min(width-62,p.x));dragged.y=Math.max(118,Math.min(height-16,p.y));dragged.vx=dragged.vy=0;dirty=true;schedule();});const release=()=>{dragged=null;dirty=true;schedule();};g.addEventListener('pointerup',release);g.addEventListener('pointercancel',release);}
 function scrubTimeline(){const value=Number(scrub.value),centers=steps.map(s=>{const r=s.getBoundingClientRect();return r.top+scrollY+r.height*.5;});const scaled=value*4,i=Math.min(3,Math.floor(scaled)),target=centers[i]+(centers[i+1]-centers[i])*(scaled-i);const stageBottom=stage.getBoundingClientRect().bottom;const probe=innerWidth<900?Math.min(innerHeight-40,stageBottom+innerHeight*.18):innerHeight*.5;window.scrollTo({top:Math.max(0,target-probe),behavior:'instant'});setProgress(value);}
 scrub.addEventListener('input',scrubTimeline);root.querySelector('[data-pro-reset]')!.addEventListener('click',()=>{clear();lens='all';filters.forEach(f=>f.setAttribute('aria-pressed',String(f.dataset.proFilter==='all')));layout();dirty=true;schedule();});
 function reduced(){reduce=motion.matches||still.checked;still.checked=reduce;root.dataset.reducedMotion=String(reduce);layout();dirty=true;last=0;schedule();}still.addEventListener('change',reduced);motion.addEventListener('change',reduced);
 const escape=(event:KeyboardEvent)=>{if(event.key==='Escape')clear();};root.addEventListener('keydown',escape);
 const observer=new ResizeObserver(resize);observer.observe(surface);const visibility=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(!visible&&raf){cancelAnimationFrame(raf);raf=0;}if(visible){last=0;dirty=true;schedule();}},{rootMargin:'120px'});visibility.observe(stage);
 const themes=new MutationObserver(theme);themes.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});function hidden(){if(document.hidden&&raf){cancelAnimationFrame(raf);raf=0;}else{last=0;schedule();}}document.addEventListener('visibilitychange',hidden);window.addEventListener('scroll',scroll,{passive:true});window.addEventListener('resize',scroll,{passive:true});root.dataset.ready='true';theme();reduced();resize();setEra(1);scroll();schedule();
 function cleanup(){disposed=true;cancelAnimationFrame(raf);observer.disconnect();visibility.disconnect();themes.disconnect();motion.removeEventListener('change',reduced);window.removeEventListener('scroll',scroll);window.removeEventListener('resize',scroll);document.removeEventListener('visibilitychange',hidden);document.removeEventListener('astro:before-swap',cleanup);}document.addEventListener('astro:before-swap',cleanup);
}
initProfessional();document.addEventListener('astro:page-load',initProfessional);
</script>

<style>
.professional{--node-language:#1E3A2F;--node-infra:#1D4ED8;--node-concept:#B87D14;--node-project:#C84B31;--pro-serif:'Newsreader','Iowan Old Style',Georgia,serif;--pro-sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;--pro-mono:'JetBrains Mono',monospace;color:var(--text-primary);font-family:var(--pro-sans);border-top:1px solid var(--border-hairline);margin-top:5rem;padding-top:3.5rem;scroll-margin-top:5rem}
