---
/**
 * Command menu for /claude pages. A native <dialog>, so it is hidden until opened and
 * never adds text to the page flow.
 *
 * Opens with Cmd/Ctrl+K or "?" (and any element with [data-cl-palette-open]).
 * Single-key jumps from anywhere on the page: H Home, G Projects, F Essays & Notes, S Story,
 * C Connect. Those keys never fire while typing in a field, while a modifier is held, while
 * another dialog is open, or inside an element marked [data-cl-shortcuts="off"].
 */
import { claudeNav } from './nav';

const EMAIL = 'nafi@cmnafi.com';
---
<dialog id="cl-palette" class="cl-palette" aria-labelledby="cl-palette-title" data-cl-palette>
  <div class="cl-palette__panel">
    <h2 id="cl-palette-title" class="cl-sr-only">Command menu</h2>

    <div class="cl-palette__search">
      <svg class="cl-palette__glyph" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
        <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M13 13l4.25 4.25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <label for="cl-palette-input" class="cl-sr-only">Filter destinations and actions</label>
      <input
        id="cl-palette-input"
        class="cl-palette__input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="cl-palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Where to?"
        data-cl-palette-input
      />
      <button class="cl-palette__close" type="button" data-cl-palette-close>
        <kbd>Esc</kbd><span class="cl-sr-only">Close the command menu</span>
      </button>
    </div>

    <div id="cl-palette-list" class="cl-palette__list" role="listbox" aria-label="Destinations and actions" data-cl-palette-list>
      <div class="cl-palette__group" role="group" aria-labelledby="cl-palette-g-nav">
        <div id="cl-palette-g-nav" class="cl-palette__group-label" role="presentation">Go to</div>
        {claudeNav.map((item) => (
          <div
            id={`cl-palette-opt-${item.key}`}
            class="cl-palette__opt"
            role="option"
            aria-selected="false"
            data-cl-opt
            data-href={item.href}
            data-search={`${item.label} ${item.hint}`.toLowerCase()}
          >
            <span class="cl-palette__opt-text">
              <span class="cl-palette__opt-label">{item.label}</span>
              <span class="cl-palette__opt-hint">{item.hint}</span>
            </span>
            <kbd aria-hidden="true">{item.key.toUpperCase()}</kbd>
            <span class="cl-sr-only">Shortcut: {item.key.toUpperCase()}</span>
          </div>
        ))}
      </div>

      <div class="cl-palette__group" role="group" aria-labelledby="cl-palette-g-act">
        <div id="cl-palette-g-act" class="cl-palette__group-label" role="presentation">Actions</div>
        <div
          id="cl-palette-opt-theme"
          class="cl-palette__opt"
          role="option"
          aria-selected="false"
          data-cl-opt
          data-action="theme"
          data-search="theme dark paper light mode appearance"
        >
          <span class="cl-palette__opt-text">
            <span class="cl-palette__opt-label" data-cl-theme-label>Switch to the Dark theme</span>
            <span class="cl-palette__opt-hint">Paper and Dark, remembered on this device</span>
          </span>
        </div>
        <div
          id="cl-palette-opt-email"
          class="cl-palette__opt"
          role="option"
          aria-selected="false"
          data-cl-opt
          data-action="copy-email"
          data-search={`copy email address contact ${EMAIL}`}
        >
          <span class="cl-palette__opt-text">
            <span class="cl-palette__opt-label">Copy email address</span>
            <span class="cl-palette__opt-hint cl-mono">{EMAIL}</span>
          </span>
        </div>
      </div>

      <p class="cl-palette__empty" data-cl-palette-empty hidden>Nothing matches that. Try “story” or “projects”.</p>
    </div>

    <div class="cl-palette__foot">
      <p class="cl-palette__keys" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>Esc</kbd> close</span>
      </p>
      <p class="cl-palette__status" role="status" aria-live="polite" data-cl-palette-status></p>
    </div>
  </div>
</dialog>

<script>
  const EMAIL = 'nafi@cmnafi.com';
  const dialog = document.querySelector<HTMLDialogElement>('[data-cl-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-cl-palette-input]');
  const list = document.querySelector<HTMLElement>('[data-cl-palette-list]');
  const empty = document.querySelector<HTMLElement>('[data-cl-palette-empty]');
  const status = document.querySelector<HTMLElement>('[data-cl-palette-status]');
  const themeLabel = document.querySelector<HTMLElement>('[data-cl-theme-label]');

  type ThemeApi = { get: () => 'light' | 'dark'; set: (t: 'light' | 'dark') => void };

  if (dialog && input && list) {
    const options = Array.from(list.querySelectorAll<HTMLElement>('[data-cl-opt]'));
    const shortcutMap = new Map<string, string>();
    options.forEach((opt) => {
      const key = opt.id.replace('cl-palette-opt-', '');
      if (opt.dataset.href && key.length === 1) shortcutMap.set(key, opt.dataset.href);
    });

    let active = -1;
    let lastFocus: HTMLElement | null = null;
    let statusTimer: number | undefined;

    const visible = () => options.filter((o) => !o.hidden);

    function setActive(index: number) {
      const items = visible();
      options.forEach((o) => o.setAttribute('aria-selected', 'false'));
      if (!items.length) {
        active = -1;
        input!.removeAttribute('aria-activedescendant');
        return;
      }
      active = (index + items.length) % items.length;
      const el = items[active];
      el.setAttribute('aria-selected', 'true');
      input!.setAttribute('aria-activedescendant', el.id);
      el.scrollIntoView({ block: 'nearest' });
    }

    function filter() {
      const terms = input!.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      options.forEach((opt) => {
        const hay = opt.dataset.search ?? '';
        opt.hidden = terms.length > 0 && !terms.every((t) => hay.includes(t));
      });
      list!.querySelectorAll<HTMLElement>('.cl-palette__group').forEach((group) => {
        group.hidden = !group.querySelector('[data-cl-opt]:not([hidden])');
      });
      const any = visible().length > 0;
      if (empty) empty.hidden = any;
      setActive(0);
    }

    function syncThemeLabel() {
      const api = (window as unknown as { clTheme?: ThemeApi }).clTheme;
      const isDark = api ? api.get() === 'dark' : document.documentElement.dataset.theme === 'dark';
      if (themeLabel) themeLabel.textContent = isDark ? 'Switch to the Paper theme' : 'Switch to the Dark theme';
    }

    function announce(message: string) {
      if (!status) return;
      status.textContent = message;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.textContent = '';
      }, 2600);
    }

    function open() {
      if (dialog!.open) return;
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      input!.value = '';
      if (status) status.textContent = '';
      syncThemeLabel();
      filter();
      dialog!.showModal();
      document.documentElement.classList.add('cl-palette-open');
      input!.focus();
    }

    function close() {
      if (dialog!.open) dialog!.close();
    }

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('cl-palette-open');
      if (lastFocus && document.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
      lastFocus = null;
    });

    function go(href: string) {
      const here = window.location.pathname.replace(/\/?$/, '/');
      if (here === href) {
        close();
        return;
      }
      window.location.assign(href);
    }

    async function copyEmail(): Promise<boolean> {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(EMAIL);
          return true;
        }
      } catch {
        /* fall through to the legacy path */
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = EMAIL;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        dialog!.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        ta.remove();
        input!.focus();
        return ok;
      } catch {
        return false;
      }
    }

    async function activate(opt: HTMLElement | undefined) {
      if (!opt) return;
      if (opt.dataset.href) {
        go(opt.dataset.href);
        return;
      }
      if (opt.dataset.action === 'theme') {
        const api = (window as unknown as { clTheme?: ThemeApi }).clTheme;
        if (api) {
          const next = api.get() === 'dark' ? 'light' : 'dark';
          api.set(next);
          syncThemeLabel();
          announce(next === 'dark' ? 'Dark theme on.' : 'Paper theme on.');
        }
        return;
      }
      if (opt.dataset.action === 'copy-email') {
        const ok = await copyEmail();
        announce(ok ? `Copied ${EMAIL}` : `Copy failed. The address is ${EMAIL}`);
      }
    }

    input.addEventListener('input', filter);

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        activate(visible()[active]);
      }
    });

    options.forEach((opt) => {
      opt.addEventListener('click', () => activate(opt));
      opt.addEventListener('mousemove', () => {
        const idx = visible().indexOf(opt);
        if (idx !== -1 && idx !== active) setActive(idx);
      });
    });

    // Click on the scrim (the dialog box itself, outside the panel) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    document.querySelectorAll('[data-cl-palette-close]').forEach((btn) => btn.addEventListener('click', close));
    document.querySelectorAll('[data-cl-palette-open]').forEach((btn) =>
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      }),
    );

    function isTypingContext(target: EventTarget | null): boolean {
      const el = target instanceof Element ? target : null;
      const focused = document.activeElement;
      return [el, focused].some((node) => {
        if (!(node instanceof Element)) return false;
        if (node instanceof HTMLElement && node.isContentEditable) return true;
        return Boolean(
          node.closest(
            'input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="textbox"], [role="combobox"], [data-cl-shortcuts="off"]',
          ),
        );
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.isComposing) return;
      const key = event.key;

      // Cmd/Ctrl+K toggles from anywhere.
      if ((event.metaKey || event.ctrlKey) && !event.altKey && !event.shiftKey && key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) close();
        else open();
        return;
      }

      if (dialog.open || event.defaultPrevented) return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (isTypingContext(event.target)) return;
      if (document.querySelector('dialog[open]')) return;

      if (key === '?') {
        event.preventDefault();
        open();
        return;
      }

      if (event.shiftKey || event.repeat || key.length !== 1) return;
      const href = shortcutMap.get(key.toLowerCase());
      if (href) {
        event.preventDefault();
        go(href);
      }
    });

    document.addEventListener('cl:theme-change', syncThemeLabel);
  }
</script>

<style>
  .cl-palette {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: min(14vh, 120px) 16px 16px;
    border: 0;
    background: var(--overlay-scrim);
    color: var(--text-primary);
    overflow: auto;
  }

  .cl-palette::backdrop {
    background: transparent;
  }

  :global(html.cl-palette-open) {
    overflow: hidden;
  }

  .cl-palette__panel {
    display: flex;
    flex-direction: column;
    width: min(600px, 100%);
    max-height: min(560px, 76vh);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    box-shadow: var(--shadow-overlay);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cl-palette[open] .cl-palette__panel {
      animation: cl-palette-in var(--duration-base) var(--ease-standard);
    }
  }

  @keyframes cl-palette-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cl-palette__search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px 0 18px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cl-palette__glyph {
    flex: none;
    color: var(--text-muted);
  }

  .cl-palette__input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    outline: none;
  }

  .cl-palette__input::placeholder {
    color: var(--text-muted);
  }

  .cl-palette__close {
    flex: none;
    padding: 6px;
    border: 0;
    background: none;
  }

  .cl-palette__list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    overscroll-behavior: contain;
  }

  .cl-palette__group + .cl-palette__group {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--border-subtle);
  }

  .cl-palette__group-label {
    padding: 8px 10px 4px;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .cl-palette__opt {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    user-select: none;
  }

  .cl-palette__opt[hidden],
  .cl-palette__group[hidden] {
    display: none;
  }

  .cl-palette__opt[aria-selected='true'] {
    background: var(--bg-subtle);
    box-shadow: inset 2px 0 0 var(--accent-highlight);
  }

  .cl-palette__opt-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .cl-palette__opt-label {
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .cl-palette__opt-hint {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cl-palette__opt-hint.cl-mono {
    font-size: 0.75rem;
  }

  .cl-palette__empty {
    padding: 24px 10px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
  }

  .cl-palette__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 8px 16px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .cl-palette__keys {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .cl-palette__keys span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .cl-palette__status {
    color: var(--text-primary);
    font-weight: 500;
    text-align: right;
  }

  @media (max-width: 480px) {
    .cl-palette {
      padding-top: 16px;
    }

    .cl-palette__keys {
      display: none;
    }
  }
</style>
