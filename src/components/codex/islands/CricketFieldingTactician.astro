---
import {scenarios} from '../../../data/codex/islands/cricket-scenarios';
---
<section class="cricket" data-tactics aria-label="Cricket field placement simulator">
 <h3>Nine fielders. One decision at a time.</h3><label>Match context<select data-scenario>{scenarios.map((s,i)=><option value={i}>{s.name} · {s.date}</option>)}</select></label><p data-context></p>
 <svg data-field viewBox="0 0 400 400" aria-label="Cricket field. Select a fielder and use arrow keys or drag." role="group"><ellipse cx="200" cy="200" rx="180" ry="185" fill="var(--bg-subtle)" stroke="var(--border-subtle)"/><circle cx="200" cy="200" r="95" fill="none" stroke="var(--accent-primary)" stroke-dasharray="5 5"/><rect x="188" y="174" width="24" height="53" fill="var(--bg-elevated)" stroke="var(--border-subtle)"/><circle cx="200" cy="215" r="5" fill="var(--text-secondary)"/><text x="212" y="220">Bowler</text><circle cx="200" cy="165" r="5" fill="var(--text-secondary)"/><text x="211" y="165">Keeper</text><g data-dots></g><text x="200" y="392" text-anchor="middle">Right-handed batter, facing down the pitch</text></svg>
 <p data-rules aria-live="polite"></p><div class="coverage"><span data-boundary></span><span data-single></span></div>
 <label>Selected fielder<select data-selected>{Array.from({length:9},(_,i)=><option value={i}>Fielder {i+1}</option>)}</select></label>
 <div class="moves"><button data-move="0,-8" aria-label="Move selected fielder up">↑</button><button data-move="-8,0" aria-label="Move selected fielder left">←</button><button data-move="8,0" aria-label="Move selected fielder right">→</button><button data-move="0,8" aria-label="Move selected fielder down">↓</button><button data-reset>Suggested formation</button></div>
 <p class="note">Drag the numbered dots, focus one and use arrow keys, or use the movement buttons. Suggested formations are tactical examples: the match reports do not document actual fielder coordinates. Assumed limited-overs rules: maximum five outside the circle at the death, two during powerplay. Check your league regulations. Coverage indices measure geometric coverage, not save probabilities.</p>
 <nav><a data-essay href="/field-notes/seven-to-defend-swat-vs-royal-phoenix/">Read match report</a><a href="/garage/captains-view/">Open Captains View</a></nav>
 <script is:inline type="application/json" data-scenarios set:html={JSON.stringify(scenarios).replaceAll('<','\\u003c')}/>
</section>
<script>
 import type {scenarios} from '../../../data/codex/islands/cricket-scenarios';
 function init(){document.querySelectorAll<HTMLElement>('[data-tactics]').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const data=JSON.parse(root.querySelector('[data-scenarios]')!.textContent!) as typeof scenarios;const svg=root.querySelector<SVGSVGElement>('[data-field]')!,layer=root.querySelector('[data-dots]')!,selector=root.querySelector<HTMLSelectElement>('[data-selected]')!;let current=0,selected=0,drag:number|null=null;let points:{x:number;y:number}[]=[];
 const positions=(max:number)=>Array.from({length:9},(_,i)=>{const angle=(i*40-90)*Math.PI/180,r=i<max?155:70;return{x:200+Math.cos(angle)*r,y:200+Math.sin(angle)*r};});
 const clamp=(x:number,y:number)=>{const dx=x-200,dy=y-200,f=Math.max(1,Math.sqrt((dx/175)**2+(dy/180)**2));return{x:200+dx/f,y:200+dy/f};};
 const update=()=>{let outside=0;points.forEach((p,i)=>{const dot=layer.children[i] as SVGGElement;dot.setAttribute('transform',`translate(${p.x},${p.y})`);dot.setAttribute('aria-label',`Fielder ${i+1}, ${Math.hypot(p.x-200,p.y-200)>95?'outside':'inside'} circle`);dot.setAttribute('aria-pressed',String(i===selected));if(Math.hypot(p.x-200,p.y-200)>95)outside++;});const legal=outside<=data[current].max;const status=root.querySelector<HTMLElement>('[data-rules]')!;status.textContent=`${outside} outside the circle / ${data[current].max} allowed. ${legal?'Legal under assumed rule':'Field restriction violation'}`;status.style.color=legal?'var(--accent-primary)':'var(--accent-highlight)';
 const coverage=(radius:number,reach:number)=>{let covered=0;for(let i=0;i<72;i++){const a=i*Math.PI/36,tx=200+radius*Math.cos(a),ty=200+radius*Math.sin(a);if(points.some(p=>Math.hypot(p.x-tx,p.y-ty)<=reach))covered++;}return Math.round(covered/72*100);};root.querySelector('[data-boundary]')!.textContent=`Boundary coverage index: ${coverage(160,45)}%`;root.querySelector('[data-single]')!.textContent=`Single coverage index: ${coverage(65,30)}%`;selector.value=String(selected);};
 const move=(dx:number,dy:number)=>{points[selected]=clamp(points[selected].x+dx,points[selected].y+dy);update();};
 for(let i=0;i<9;i++){const g=document.createElementNS('http://www.w3.org/2000/svg','g');g.setAttribute('role','button');g.setAttribute('tabindex','0');const c=document.createElementNS('http://www.w3.org/2000/svg','circle');c.setAttribute('r','12');c.setAttribute('fill','var(--accent-primary)');const text=document.createElementNS('http://www.w3.org/2000/svg','text');text.setAttribute('text-anchor','middle');text.setAttribute('dy','4');text.setAttribute('fill','var(--bg-canvas)');text.textContent=String(i+1);g.append(c,text);g.addEventListener('pointerdown',e=>{selected=i;drag=i;g.setPointerCapture(e.pointerId);update();});g.addEventListener('pointermove',e=>{if(drag!==i)return;const matrix=svg.getScreenCTM();if(!matrix)return;const p=new DOMPoint(e.clientX,e.clientY).matrixTransform(matrix.inverse());points[i]=clamp(p.x,p.y);update();});g.addEventListener('pointerup',()=>{drag=null;});g.addEventListener('pointercancel',()=>{drag=null;});g.addEventListener('focus',()=>{selected=i;update();});g.addEventListener('keydown',e=>{const directions:Record<string,number[]>={ArrowUp:[0,-8],ArrowDown:[0,8],ArrowLeft:[-8,0],ArrowRight:[8,0]};if(directions[e.key]){e.preventDefault();selected=i;move(directions[e.key][0],directions[e.key][1]);}});layer.append(g);}
 const reset=()=>{points=positions(data[current].max);root.querySelector('[data-context]')!.textContent=`${data[current].context} Recorded result: ${data[current].outcome}.`;root.querySelector<HTMLAnchorElement>('[data-essay]')!.href=`/field-notes/${data[current].slug}/`;update();};root.querySelector<HTMLSelectElement>('[data-scenario]')!.addEventListener('change',e=>{current=Number((e.target as HTMLSelectElement).value);reset();});selector.addEventListener('change',()=>{selected=Number(selector.value);update();});root.querySelectorAll<HTMLButtonElement>('[data-move]').forEach(button=>button.addEventListener('click',()=>{const[dx,dy]=button.dataset.move!.split(',').map(Number);move(dx,dy);}));root.querySelector('[data-reset]')!.addEventListener('click',reset);reset();});}init();document.addEventListener('astro:page-load',init);
</script>
<style>
 .cricket{font-family:var(--font-sans);color:var(--text-primary)}h3{font:400 1.8rem var(--font-serif);margin:0 0 1rem}p{color:var(--text-secondary);line-height:1.6}label{display:grid;gap:.4rem;font-size:.85rem}select{padding:.7rem;background:var(--bg-surface);border:1px solid var(--border-subtle);color:var(--text-primary);width:100%;font:inherit}svg{display:block;width:100%;max-height:380px;margin:1rem auto;touch-action:none}svg text{font:10px var(--font-sans);fill:var(--text-secondary)}:global([data-dots] text){fill:var(--bg-canvas);font:11px var(--font-mono)}:global([data-dots] g){cursor:grab}:global([data-dots] g[aria-pressed=true] circle){stroke:var(--accent-highlight);stroke-width:3}:global([data-dots] g:focus-visible){outline:none}:global([data-dots] g:focus-visible circle){stroke:var(--accent-blue);stroke-width:4}.coverage{display:grid;gap:.5rem;font:.8rem var(--font-mono);margin:1rem 0;font-variant-numeric:tabular-nums}.moves{display:flex;gap:.4rem;flex-wrap:wrap;margin:1rem 0}button{min-width:44px;min-height:44px;background:var(--bg-subtle);border:1px solid var(--border-subtle);color:var(--text-primary);font:inherit;cursor:pointer}.note{font-size:.77rem}nav{display:flex;gap:1rem;flex-wrap:wrap}a{color:var(--accent-primary)}:focus-visible{outline:2px solid var(--accent-blue);outline-offset:3px}
</style>
