---
import { advisers } from '../../../data/codex/islands/sample-advisers';
---
<section class="adv-island" data-adv aria-label="SEC adviser explorer">
 <h3>Read the entity, then the numbers.</h3>
 <p>Start with BlackRock or Blackstone, then compare assets and clients for the exact registered advisers. The same question behind my Form ADV essay: what sits beneath a familiar firm name?</p>
 <label>Search eight manager brands<input type="search" data-search placeholder="Try BlackRock or Citadel" /></label>
 <div class="pills">{advisers.map((a,i)=><button type="button" data-firm={i} aria-pressed={i===0?'true':'false'}>{a.name}</button>)}</div>
 <p data-empty hidden>No matching manager. Try another name.</p>
 <label class="compare"><input type="checkbox" data-compare /> Compare two entities</label>
 <label data-second-label hidden>Compare with<select data-second>{advisers.map((a,i)=><option value={i} selected={i===1}>{a.name}</option>)}</select></label>
 <div class="cards"><article data-card></article><article data-other hidden></article></div>
 <p class="note">Official Form ADV snapshots, checked October 14, 2026. Figures cover each named legal adviser and its filing perimeter, not the parent group's assets. Item 5.F reports regulatory AUM; Item 5.D reports client types. Fee schedules require separate Part 2 review and remain unverified. No 13F holdings are loaded.</p>
 <nav><a href="/garage/form-adv-data-finder/">How I built Regulatory Lens</a><a href="/field-notes/adv-universe/">Read The Universe of Form ADV</a></nav>
 <script is:inline type="application/json" data-advisers set:html={JSON.stringify(advisers).replaceAll('<','\\u003c')} />
</section>
<script>
 import type {advisers} from '../../../data/codex/islands/sample-advisers';
 function init(){document.querySelectorAll<HTMLElement>('[data-adv]').forEach(root=>{
  if(root.dataset.ready)return;root.dataset.ready='true';const data=JSON.parse(root.querySelector('[data-advisers]')!.textContent!) as typeof advisers;let current=0;
  const card=(target:HTMLElement,a:typeof data[number])=>{target.replaceChildren();const heading=document.createElement('h4');heading.textContent=a.name;target.append(heading);const identity=document.createElement('p');identity.textContent=a.entity;target.append(identity);
   const money=(v:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v);const dl=document.createElement('dl');[['SEC CRD',a.crd],['Filing report date',a.filingDate],['Regulatory AUM',money(a.aum)],['Discretionary / non-discretionary',`${money(a.discretionary)} / ${money(a.nonDiscretionary)}`],['Primary client types',a.clients],['Fee structure',a.fees??'Not verified; review Part 2 brochure']].forEach(([label,value])=>{const dt=document.createElement('dt');dt.textContent=label;const dd=document.createElement('dd');dd.textContent=value;dl.append(dt,dd);});target.append(dl);const bar=document.createElement('div');bar.className='aum-split';bar.setAttribute('role','img');const discretionary=a.discretionary/a.aum*100;bar.setAttribute('aria-label',`${discretionary.toFixed(1)}% discretionary and ${(100-discretionary).toFixed(1)}% non-discretionary`);const fill=document.createElement('span');fill.style.width=`${discretionary}%`;bar.append(fill);target.append(bar);const legend=document.createElement('p');legend.className='split-label';legend.textContent=`Discretionary ${discretionary.toFixed(1)}% · Non-discretionary ${(100-discretionary).toFixed(1)}%`;target.append(legend);const link=document.createElement('a');link.href=a.source;link.textContent='Source: official Form ADV';link.target='_blank';link.rel='noopener noreferrer';target.append(link);};
  const compare=root.querySelector<HTMLInputElement>('[data-compare]')!,second=root.querySelector<HTMLSelectElement>('[data-second]')!;
  const render=()=>{card(root.querySelector('[data-card]')!,data[current]);const other=root.querySelector<HTMLElement>('[data-other]')!;other.hidden=!compare.checked;root.querySelector<HTMLElement>('[data-second-label]')!.hidden=!compare.checked;if(compare.checked)card(other,data[Number(second.value)]);};
  root.querySelectorAll<HTMLButtonElement>('[data-firm]').forEach(button=>button.addEventListener('click',()=>{current=Number(button.dataset.firm);root.querySelectorAll('[data-firm]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));render();}));
  root.querySelector<HTMLInputElement>('[data-search]')!.addEventListener('input',event=>{const query=(event.target as HTMLInputElement).value.toLowerCase();let count=0;root.querySelectorAll<HTMLButtonElement>('[data-firm]').forEach(b=>{b.hidden=!b.textContent!.toLowerCase().includes(query);if(!b.hidden)count++;});root.querySelector<HTMLElement>('[data-empty]')!.hidden=count>0;});compare.addEventListener('change',render);second.addEventListener('change',render);render();
 });}init();document.addEventListener('astro:page-load',init);
</script>
<style>
 .adv-island{color:var(--text-primary);font-family:var(--font-sans)}h3{font:400 1.8rem var(--font-serif);margin:0 0 1rem}p{color:var(--text-secondary);line-height:1.6}label{display:grid;gap:.4rem;font-size:.85rem}input[type=search],select{padding:.7rem;border:1px solid var(--border-subtle);background:var(--bg-surface);color:var(--text-primary);max-width:100%;font:inherit}.pills{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0}button{padding:.5rem .7rem;border:1px solid var(--border-subtle);background:var(--bg-subtle);color:var(--text-primary);font:inherit;cursor:pointer}button[aria-pressed=true]{border-color:var(--accent-primary);color:var(--accent-primary)}.compare{display:flex;align-items:center;margin:1rem 0}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:1rem;margin:1rem 0}article{padding:1rem;border:1px solid var(--border-subtle);background:var(--bg-surface)}.note{font-size:.78rem}nav{display:flex;gap:1rem;flex-wrap:wrap}a{color:var(--accent-primary)}[hidden]{display:none!important}:global([data-adv] h4){font:400 1.4rem var(--font-serif);margin:0}:global([data-adv] dl){font-size:.82rem}:global([data-adv] dt){color:var(--text-secondary);margin-top:.7rem}:global([data-adv] dd){margin:0;font-variant-numeric:tabular-nums}:global([data-adv] .aum-split){height:10px;background:var(--accent-amber);display:flex;margin-top:1rem}:global([data-adv] .aum-split span){height:100%;background:var(--accent-primary)}:global([data-adv] .split-label){font-size:.72rem;font-family:var(--font-mono);font-variant-numeric:tabular-nums}:focus-visible{outline:2px solid var(--accent-blue);outline-offset:3px}
</style>
