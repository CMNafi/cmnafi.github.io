---
import type { ProjectItem } from '../../../types/codex-site';
interface Props { project: ProjectItem }
const { project } = Astro.props;
const labels = {'fintech-sec':'FinTech & SEC Data','cricket-sports':'Cricket & Sports Analytics','knowledge-systems':'Knowledge Systems'};
---
<article class="project-card" data-project-category={project.category}>
  <div class="project-meta"><span>{labels[project.category]}</span><span>{project.lifecycle === 'live' ? 'Live' : 'Active R&D'}</span></div>
  <h2>{project.title}</h2><p class="tagline">{project.tagline}</p>
  <p class="metric">{project.keyMetricBadge}</p>
  <p>{project.problem}</p>
  <div class="pipeline"><span>System architecture</span><p>{project.architectureSummary}</p></div>
  <ul class="stack" aria-label="Project stack">{project.stack.map(tag => <li>{tag}</li>)}</ul>
  <div class="card-footer"><time datetime={project.updatedAt}>{project.updatedAt}</time>{project.href && <a href={project.href}>{project.lifecycle === 'live' ? 'Explore project' : 'Read project notes'} <span aria-hidden="true">↗</span></a>}</div>
</article>
<style>
  .project-card{padding:28px;border:1px solid var(--border-subtle);background:var(--bg-surface);display:flex;flex-direction:column;min-width:0}
  .project-card[hidden]{display:none!important}
  .project-meta,.card-footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.78rem;color:var(--text-secondary)}
  h2{font:400 clamp(1.8rem,3vw,2.4rem)/1.1 var(--font-serif);letter-spacing:-.02em;margin:24px 0 12px}
  p{color:var(--text-secondary);line-height:1.65}.tagline{color:var(--text-primary);font-size:1.05rem;margin-top:0}.metric{color:var(--accent-primary);font-size:.85rem;font-weight:600}
  .pipeline{border-top:1px solid var(--border-subtle);padding-top:14px;margin-top:auto}.pipeline span{font-size:.75rem;color:var(--text-muted)}.pipeline p{font-size:.85rem;margin:5px 0 18px}
  .stack{padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0 0 22px}.stack li{font: .7rem var(--font-mono);padding:5px 7px;background:var(--bg-subtle);border-radius:var(--radius-sm)}
  time{font-family:var(--font-mono);font-variant-numeric:tabular-nums}.card-footer{border-top:1px solid var(--border-subtle);padding-top:16px}.card-footer a{color:var(--accent-primary);font-weight:600}
</style>
