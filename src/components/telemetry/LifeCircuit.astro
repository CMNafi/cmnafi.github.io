---
import {journeySegments} from '@/data/life-journey';
const education=journeySegments.find(s=>s.id==='education')!.items;
const stops=[
 {place:'Bangladesh',period:education.find(i=>i.id==='dinajpur')!.period,detail:education.find(i=>i.id==='dinajpur')!.description.replace('Dinajpur', 'Bangladesh'),x:8,y:83},
 {place:'China',period:education.find(i=>i.id==='changshu')!.period,detail:'United World College. Full merit scholarship and the IB Diploma.',x:20.42,y:16.67},
 {place:'Iowa',period:'Graduated 2022',detail:'Luther College. Data Science major, Computer Science minor.',x:68.75,y:11.33},
 {place:'Minnesota',period:'2021–2022',detail:'Mayo Clinic. AI Intern, working with clinical data and research teams.',x:89.79,y:48.67},
 {place:'New York',period:'2021–2023',detail:'SkyBridge Associates, then BlackRock. Data science and institutional finance.',x:56.46,y:66.67},
 {place:'Florida',period:'2023–Present',detail:'Dasseti. Solutions Engineer, working with finance and data infrastructure.',x:45.83,y:86.67}
];
const track='M330,520 C310,520 207,524 170,520 C133,516 131,519 108,498 C85,477 83,468 82,440 C81,412 93,389 104,360 C115,331 170,193 190,150 C210,107 205,115 226,100 C247,85 247,87 286,82 C325,77 442,73 460,72 C478,71 609,61 640,60 C671,59 672,55 690,68 C708,81 707,83 708,108 C709,133 692,134 694,160 C696,186 696,189 716,204 C736,219 750,215 770,218 C790,221 818,217 836,222 C854,227 865,232 876,246 C887,260 894,265 892,292 C890,319 889,321 870,336 C851,351 848,350 820,350 C792,350 726,341 700,338 C674,335 651,327 628,330 C605,333 599,333 584,352 C569,371 571,377 572,400 C573,423 587,426 590,452 C593,478 595,478 582,496 C569,514 562,513 540,518 C518,523 491,520 470,520 C449,520 350,520 330,520Z';
---
<div class="life-circuit" data-circuit data-stops={JSON.stringify(stops)}><div class="circuit-caption"><span>One lap · Bangladesh to Florida</span><span>A life in six turns</span></div><div class="circuit-drawing"><svg viewBox="30 0 960 600" role="img" aria-label="A symbolic circuit connecting six places in my life"><path d={track} class="track-surface"/><path d={track} class="track-line" pathLength="1"/><line x1="330" x2="330" y1="503" y2="537" class="start-line"/><circle class="circuit-dot" cx="330" cy="520" r="7"/></svg>{stops.map((s,i)=><button class="circuit-turn" type="button" data-turn={i} style={`left:${s.x}%;top:${s.y}%`} aria-label={`${String(i+1).padStart(2,'0')} ${s.place}`} aria-pressed={i===5}><span class="turn-ring" aria-hidden="true"></span><span class="turn-label">{String(i+1).padStart(2,'0')} <span>{s.place}</span></span></button>)}</div><div class="circuit-readout" aria-live="polite"><span class="meta" data-turn-place>06 / Florida</span><span class="meta" data-turn-period>2023–Present</span><p data-turn-detail>{stops[5].detail}</p></div></div>
<style>
.life-circuit{min-width:0}.circuit-caption{display:flex;justify-content:space-between;gap:12px;font:12px/1.7 var(--font-mono);color:var(--ink-secondary)}.circuit-drawing{position:relative;aspect-ratio:960/600;margin:25px 0 30px}.circuit-drawing svg{display:block;width:100%;height:100%;overflow:visible}.track-surface{fill:none;stroke:var(--ink-primary);stroke-opacity:.06;stroke-width:30;stroke-linejoin:round}.track-line{fill:none;stroke:var(--ink-primary);stroke-width:2.5;stroke-linecap:round}.start-line{stroke:var(--ink-primary);stroke-width:2}.circuit-dot{fill:var(--accent)}.circuit-turn{position:absolute;transform:translate(-50%,-50%);width:44px;height:44px;display:grid;place-items:center;background:none;border:0;color:var(--ink-primary);padding:0}.turn-ring{width:9px;height:9px;border:1px solid var(--ink-primary);border-radius:50%;background:var(--surface-base)}.turn-label{position:absolute;top:35px;white-space:nowrap;font:12px var(--font-mono)}.turn-label>span{color:var(--ink-secondary)}.circuit-turn[aria-pressed=true] .turn-ring{background:var(--accent);border-color:var(--accent)}.circuit-readout{border-top:1px solid var(--surface-line);padding-top:16px;display:grid;grid-template-columns:1fr auto;gap:8px 20px;min-height:120px}.circuit-readout p{grid-column:1/-1;font-size:16px;color:var(--ink-secondary);margin:0;max-width:560px}.life-circuit.running .track-line{stroke-dasharray:1;animation:draw 2.4s ease both}@keyframes draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}@media(max-width:650px){.circuit-caption{font-size:12px}.circuit-caption>span:last-child{display:none}.turn-label>span{display:none}.circuit-readout{min-height:105px}.circuit-drawing{margin:10px 0 20px}.circuit-readout p{font-size:15px}}
</style>
<script>
function initCircuit(){const root=document.querySelector<HTMLElement>('[data-circuit]');if(!root||root.dataset.ready)return;root.dataset.ready='true';const stops=JSON.parse(root.dataset.stops!);const buttons=root.querySelectorAll<HTMLButtonElement>('[data-turn]');const pick=(i:number)=>{buttons.forEach((b,j)=>b.setAttribute('aria-pressed',String(i===j)));root.querySelector('[data-turn-place]')!.textContent=`${String(i+1).padStart(2,'0')} / ${stops[i].place}`;root.querySelector('[data-turn-period]')!.textContent=stops[i].period;root.querySelector('[data-turn-detail]')!.textContent=stops[i].detail;};buttons.forEach(b=>{['click','focus','mouseenter'].forEach(event=>b.addEventListener(event,()=>pick(Number(b.dataset.turn))))});const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');if(reduced.matches)return;root.classList.add('running');const path=root.querySelector<SVGPathElement>('.track-line')!;const dot=root.querySelector<SVGCircleElement>('.circuit-dot')!;const timer=document.querySelector('[data-site-lap]');let frame=0,last=0,elapsed=0,visible=true;const observer=new IntersectionObserver(([e])=>{visible=e.isIntersecting});observer.observe(root);const draw=(now:number)=>{if(last&&visible&&!document.hidden&&!reduced.matches){elapsed+=Math.min(now-last,100);const lap=Math.max(0,elapsed-2400)%28000;const pos=path.getPointAtLength(path.getTotalLength()*lap/28000);dot.setAttribute('cx',String(pos.x));dot.setAttribute('cy',String(pos.y));if(timer)timer.textContent=`00:${String(Math.floor(lap/1000)).padStart(2,'0')}.${String(Math.floor(lap%1000)).padStart(3,'0')}`;}last=now;frame=requestAnimationFrame(draw)};frame=requestAnimationFrame(draw);document.addEventListener('astro:before-swap',()=>{cancelAnimationFrame(frame);observer.disconnect()},{once:true});}
initCircuit();document.addEventListener('astro:page-load',initCircuit);
</script>
