---
---

<footer class="gem-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <div class="footer-wordmark">C M Nafi</div>
      <p class="footer-credo">
        Solutions Engineer at Dasseti. Turning numbers into stories, problems into tools, and weekend matches into memory.
      </p>
      <div class="lab-colophon">
        <span>Editorial Systems Lab · Built with Astro, TypeScript & CSS</span>
      </div>
    </div>

    <div class="footer-right">
      <div class="nav-links-column">
        <span class="links-title">Primary Signals</span>
        <ul class="footer-links-list">
          <li><a href="mailto:nafi@cmnafi.com">nafi@cmnafi.com</a></li>
          <li><a href="https://github.com/CMNafi" target="_blank" rel="noopener noreferrer">GitHub / CMNafi ↗</a></li>
          <li><a href="https://linkedin.com/in/cm-nafi" target="_blank" rel="noopener noreferrer">LinkedIn / cm-nafi ↗</a></li>
          <li><a href="https://x.com/naficm01" target="_blank" rel="noopener noreferrer">X / @naficm01 ↗</a></li>
        </ul>
      </div>

      <div class="shortcut-hint-box">
        <button type="button" class="shortcut-btn" data-trigger-palette>
          Press <kbd class="kbd-key">?</kbd> or <kbd class="kbd-key">⌘K</kbd> for command navigation
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooterShortcuts() {
    document.querySelectorAll('[data-trigger-palette]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dialog = document.querySelector<HTMLDialogElement>('[data-command-dialog]');
        if (dialog) dialog.showModal();
      });
    });
  }
  initFooterShortcuts();
  document.addEventListener('astro:page-load', initFooterShortcuts);
</script>

<style>
  .gem-footer {
    border-top: 1px solid var(--border-strong);
    background: var(--bg-canvas);
    padding: 48px 0 64px;
    margin-top: 64px;
    font-family: var(--font-sans);
  }

  .footer-inner {
    width: min(var(--max-w-page), calc(100% - 48px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: flex-start;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-wordmark {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--text-primary);
  }

  .footer-credo {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 46ch;
    margin: 0;
  }

  .lab-colophon {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-top: 8px;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  .nav-links-column {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .links-title {
    font-size: 10px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .footer-links-list a {
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .footer-links-list a:hover {
    color: var(--accent-highlight);
  }

  .shortcut-hint-box {
    margin-top: 4px;
  }

  .shortcut-btn {
    background: transparent;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    cursor: pointer;
    text-align: right;
  }

  .shortcut-btn:hover {
    color: var(--text-primary);
  }

  .kbd-key {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    padding: 2px 6px;
    font-size: 10px;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-right {
      align-items: flex-start;
    }
    .nav-links-column {
      align-items: flex-start;
    }
    .footer-links-list {
      align-items: flex-start;
    }
    .shortcut-btn {
      text-align: left;
    }
  }
</style>
