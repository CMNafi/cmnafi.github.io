---
/**
 * Markdown tables in field notes scroll sideways by default, which suits wide
 * numeric tables. Wrap a text-heavy table in this to let its cells wrap and
 * stay inside the reading column instead.
 */
---
<div class="wrap-table"><slot /></div>

<style>
  .wrap-table :global(table) { display: table; white-space: normal; table-layout: auto; }
  .wrap-table :global(th),
  .wrap-table :global(td) { white-space: normal; vertical-align: top; line-height: 1.5; }
  .wrap-table :global(td:first-child) { min-width: 7.5rem; }
  @media (max-width: 640px) {
    .wrap-table :global(th),
    .wrap-table :global(td) { padding: 0.6rem 0.5rem; font-size: 0.88rem; }
    .wrap-table :global(td:first-child) { min-width: 5.5rem; }
  }
</style>
