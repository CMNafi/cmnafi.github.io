---
import {getCollection} from 'astro:content';import NoteRow from './NoteRow.astro';import {categorySlug,isPublicNote} from '@/config/editorial';
const {category=''}=Astro.props;const all=(await getCollection('field-notes')).filter(isPublicNote).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());const categories=[...new Set(all.map(n=>n.data.category))];const notes=category?all.filter(n=>n.data.category===category):all;
---
<div class="page-container" data-notes-index data-category={category}><header class="page-masthead"><span class="eyebrow">Writing / {notes.length} notes</span><h1>{category||'Field Notes'}</h1><p class="lead">Essays, research, and things worth remembering.</p><a class="text-link" href="/technology-history/">Explore the technology history atlas →</a></header><div class="filter-bar"><a href="/field-notes/" data-filter="" aria-current={!category?'page':undefined}>All {all.length}</a>{categories.map(c=><a href={`/field-notes/category/${categorySlug(c)}/`} data-filter={c} aria-current={c===category?'page':undefined}>{c} {all.filter(n=>n.data.category===c).length}</a>)}<label><span class="sr-only">Search titles</span><input type="search" placeholder="Search titles…" data-note-search/></label></div><div class="filter-bar" data-subfilters hidden><a href="?topic=" data-subfilter="">All finance</a>{['Venture Capital','Private Equity','Public Equities','Macro','General'].map(c=><a href={`?topic=${encodeURIComponent(c)}`} data-subfilter={c}>{c}</a>)}</div><p class="result-count" aria-live="polite" data-result-count>{notes.length} notes</p><div>{notes.map(note=><NoteRow note={note}/>)}</div><p data-empty hidden>No notes match. Try another title or category.</p></div>
<style>.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}</style>
<script>
function initNotes(){document.querySelectorAll<HTMLElement>('[data-notes-index]').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const rows=[...root.querySelectorAll<HTMLElement>('[data-note-row]')];const field=root.querySelector<HTMLInputElement>('[data-note-search]')!;const fixed=root.dataset.category||'';let selected=fixed,topic='';const params=new URLSearchParams(location.search);selected=fixed||params.get('category')||'';topic=params.get('topic')||'';field.value=params.get('q')||'';const apply=(update=true)=>{let count=0;rows.forEach(row=>{const show=(!selected||row.dataset.category===selected)&&(!topic||row.dataset.subcategory===topic)&&row.dataset.title!.includes(field.value.toLowerCase().trim());row.hidden=!show;if(show)count++});root.querySelector('[data-result-count]')!.textContent=`${count} ${count===1?'note':'notes'}`;(root.querySelector('[data-empty]')as HTMLElement).hidden=count!==0;(root.querySelector('[data-subfilters]')as HTMLElement).hidden=selected!=='Finance';root.querySelectorAll<HTMLAnchorElement>('[data-filter]').forEach(a=>a.toggleAttribute('aria-current',a.dataset.filter===selected));root.querySelectorAll<HTMLAnchorElement>('[data-subfilter]').forEach(a=>a.toggleAttribute('aria-current',a.dataset.subfilter===topic));if(update){const url=new URL(location.href);for(const [k,v] of [['q',field.value],['category',fixed?'':selected],['topic',topic]])v?url.searchParams.set(k,v):url.searchParams.delete(k);history.replaceState(null,'',url)}};field.addEventListener('input',()=>apply());root.querySelectorAll<HTMLAnchorElement>('[data-filter]').forEach(a=>a.addEventListener('click',e=>{if(fixed)return;e.preventDefault();selected=a.dataset.filter||'';topic='';apply()}));root.querySelectorAll<HTMLAnchorElement>('[data-subfilter]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();topic=a.dataset.subfilter||'';apply()}));apply(false)})}initNotes();document.addEventListener('astro:page-load',initNotes);
</script>
