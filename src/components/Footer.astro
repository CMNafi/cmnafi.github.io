---
import { siteConfig } from '@/config/site';
const year = new Date().getFullYear();

// The header already carries the page nav, so the footer stays to one quiet line
const links = [
  ...siteConfig.socialLinks.map((link) => ({ label: link.label, href: link.href })),
  { label: 'Sitemap', href: '/sitemap' },
  { label: 'Telemetry ↗', href: '/admin' }
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-copy">&copy; {year} {siteConfig.author}</span>
    <nav class="footer-links" aria-label="Footer">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    /* override the legacy .site-footer rules in global.css */
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--surface-line);
    background: var(--surface-base);
    position: relative;
    z-index: 50;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 24px clamp(16px, 5vw, 48px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-copy { color: var(--ink-tertiary); }

  .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }

  .footer-links a {
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .footer-links a:hover { color: var(--ink-primary); }
</style>
