---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// The nine chapters live in src/content/journey — STORY.md is the source of truth for what they say
const chapters = (await getCollection('journey')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  chapters.map(async (chapter) => ({ chapter, Content: (await chapter.render()).Content }))
);

const pad = (n: number) => String(n).padStart(2, '0');

const record = [
  { org: 'Dasseti', role: 'Solutions Engineer', when: '2023 to now', where: 'Remote' },
  { org: 'BlackRock', role: 'Analyst, Data and AI', when: '2022 to 2023', where: 'Wilmington, DE' },
  { org: 'SkyBridge', role: 'Data Scientist', when: '2021 to 2022', where: '' },
  { org: 'Mayo Clinic', role: 'AI Intern', when: '2021 to 2022', where: 'Rochester, MN' }
];

const education = [
  { org: 'Luther College', role: 'B.A. Data Science, Computer Science minor', when: '2022', where: 'Decorah, IA' },
  { org: 'UWC Changshu', role: 'IB Diploma, full scholarship', when: '2016 to 2018', where: 'Changshu, China' }
];

const certifications = [
  'IBM: Introduction to Data Engineering',
  'Google: Data Analytics Professional Certificate',
  'DeepLearning.AI: Neural Networks and Deep Learning',
  'Salesforce: Einstein Analytics'
];
---

<BaseLayout
  title="Story"
  description="I left home at twelve and have been the newest person in the room ever since. Military school, China, Iowa, BlackRock, and now a job that is mostly translation."
>
  <article class="story">
    <header class="story-head">
      <p class="story-eyebrow">Story · {chapters.length} chapters · about 8 minutes</p>
      <h1>The newest person <br />in the <em>room.</em></h1>
      <p class="dek">
        I left home at twelve and have been learning new rooms ever since. Military school, China, a small
        town in Iowa, three very different institutions, and now a job that is mostly translation. This is
        how that happened.
      </p>

      <dl class="facts">
        <div><dt>Now</dt><dd>Solutions Engineer, Dasseti</dd></div>
        <div><dt>Based</dt><dd>New York, working remotely</dd></div>
        <div><dt>Before</dt><dd>BlackRock, SkyBridge, Mayo Clinic</dd></div>
        <div><dt>Studied</dt><dd>Data Science, Luther College</dd></div>
      </dl>

      <div class="head-links">
        <a href="https://www.linkedin.com/in/cm-nafi/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="mailto:nafi@cmnafi.com">Email</a>
        <a href="#record">The record ↓</a>
      </div>
    </header>

    <section class="short-version" aria-labelledby="short-version-title">
      <h2 id="short-version-title" class="label">The short version</h2>
      <p>
        I'm a solutions engineer at Dasseti, based in New York and working remotely. I grew up in Bangladesh,
        left home at twelve for military school, and at sixteen moved to China on a full scholarship to a
        United World College, without speaking the language. I studied data science in an Iowa town of eight
        thousand, then worked at Mayo Clinic, SkyBridge and BlackRock.
      </p>
      <p>
        Every one of those places asked the same thing of me: learn how the room talks, then make yourself
        useful in it. Now that's the job.
      </p>
    </section>

    <nav class="chapter-index" aria-label="Chapters">
      <ol>
        {chapters.map((chapter) => (
          <li>
            <a href={`#${chapter.slug}`}>
              <span class="ci-num">{pad(chapter.data.order)}</span>
              <span class="ci-place">{chapter.data.place.split(',')[0]}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {rendered.map(({ chapter, Content }) => (
      <section class="chapter" id={chapter.slug} aria-labelledby={`${chapter.slug}-title`}>
        <div class="chapter-meta">
          <span class="chapter-num">Chapter {pad(chapter.data.order)}</span>
          <span class="chapter-place">{chapter.data.place}</span>
          <span class="chapter-period">{chapter.data.period}</span>
          {chapter.data.role && (
            <span class="chapter-role">{chapter.data.role}, {chapter.data.organization}</span>
          )}
        </div>
        <div class="chapter-main">
          <h2 id={`${chapter.slug}-title`}>{chapter.data.theme}</h2>
          <div class="chapter-body">
            <Content />
          </div>
        </div>
      </section>
    ))}

    <section class="off-clock" aria-labelledby="off-clock-title">
      <h2 id="off-clock-title" class="label">Off the clock</h2>
      <div class="off-grid">
        <div>
          <h3>Cricket</h3>
          <p>
            All-rounder, right-arm fast. Most of the match reports here come from the Tampa leagues, playing for
            TB Bengal Tigers, SWAT and St Pete Shields. I write up the close ones.
          </p>
          <a href="/field-notes/category/cricket">Cricket notes →</a>
        </div>
        <div>
          <h3>Formula 1</h3>
          <p>
            I follow it the way some people follow theology, which is why this site has a garage, sector
            labels and a lap timer in the corner. Read it as affection, not engineering.
          </p>
        </div>
        <div>
          <h3>Books</h3>
          <p>
            About a book a month, mostly non-fiction, and the occasional novel that makes me feel
            underprepared. Notes on the ones that stayed with me are in Field Notes.
          </p>
          <a href="/field-notes/category/books">Book notes →</a>
        </div>
      </div>
    </section>

    <section class="useful" aria-labelledby="useful-title">
      <h2 id="useful-title" class="label">Where I'm useful</h2>
      <p class="useful-lede">
        Due diligence and allocator workflows. How investment teams evaluate and adopt software. Solutions
        engineering at finance-adjacent SaaS. Regulatory data like Form ADV and 13F. Writing about finance for
        people who don't read finance for fun.
      </p>
      <p class="useful-not">Probably not your person for sell-side equity research or a quant trading seat.</p>
    </section>

    <section class="record" id="record" aria-labelledby="record-title">
      <h2 id="record-title" class="label">The record</h2>

      <h3 class="record-head">Work</h3>
      <ul class="record-list">
        {record.map((r) => (
          <li>
            <span class="r-org">{r.org}</span>
            <span class="r-role">{r.role}</span>
            <span class="r-when">{r.when}{r.where && ` · ${r.where}`}</span>
          </li>
        ))}
      </ul>

      <h3 class="record-head">Education</h3>
      <ul class="record-list">
        {education.map((r) => (
          <li>
            <span class="r-org">{r.org}</span>
            <span class="r-role">{r.role}</span>
            <span class="r-when">{r.when} · {r.where}</span>
          </li>
        ))}
      </ul>

      <h3 class="record-head">Certifications</h3>
      <p class="certs">{certifications.join(' · ')}</p>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="label">Say hello</h2>
      <a class="contact-email" href="mailto:nafi@cmnafi.com">nafi@cmnafi.com</a>
      <p>I read everything, and reply within two business days.</p>
    </section>
  </article>
</BaseLayout>

<style>
  .story {
    --ink-quiet: #8f8475;
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 96px) clamp(16px, 4vw, 48px) clamp(64px, 8vw, 120px);
    color: var(--ink-primary);
  }

  .story-eyebrow,
  .label,
  .chapter-meta,
  .facts dt,
  .head-links a,
  .chapter-index,
  .record-head,
  .r-when,
  .off-grid a {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Head */
  .story-eyebrow { color: var(--ink-quiet); margin: 0 0 28px; }

  .story-head h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(52px, 9vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin: 0 0 clamp(28px, 4vw, 44px);
  }

  .story-head h1 em { font-style: italic; }

  .dek {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.5;
    color: var(--ink-secondary);
    max-width: 34em;
    margin: 0 0 48px;
    text-wrap: pretty;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 0 32px;
    margin: 0 0 28px;
  }

  .facts div {
    border-top: 1px solid var(--surface-line);
    padding: 16px 0;
  }

  .facts dt { color: var(--ink-quiet); font-size: 11px; margin-bottom: 6px; }
  .facts dd { margin: 0; font-size: 17px; color: var(--ink-primary); }

  .head-links { display: flex; flex-wrap: wrap; gap: 4px 28px; }
  .head-links a { color: var(--ink-secondary); padding: 12px 0; transition: color var(--dur-fast); }
  .head-links a:hover { color: var(--accent); }

  /* Section labels */
  .label {
    color: var(--ink-quiet);
    font-weight: 400;
    margin: 0 0 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--surface-line);
  }

  .short-version { margin-top: clamp(72px, 10vw, 128px); }

  .short-version p {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 30em;
    margin: 0 0 0.8em;
    text-wrap: pretty;
  }

  .short-version p:last-child { color: var(--ink-secondary); }

  /* Chapter index */
  .chapter-index { margin: clamp(56px, 8vw, 96px) 0 0; }

  .chapter-index ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--surface-line);
    border-bottom: 1px solid var(--surface-line);
  }

  .chapter-index a {
    display: flex;
    gap: 10px;
    padding: 16px 20px 16px 0;
    margin-right: 12px;
    color: var(--ink-secondary);
    font-size: 11px;
    transition: color var(--dur-fast);
  }

  .chapter-index .ci-num { color: var(--ink-primary); }
  .chapter-index a:hover { color: var(--accent); }

  /* Chapters */
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: 24px clamp(32px, 5vw, 72px);
    padding: clamp(56px, 7vw, 88px) 0;
    border-bottom: 1px solid var(--surface-line);
    scroll-margin-top: 80px;
  }

  .chapter-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-quiet);
    font-size: 11px;
    align-self: start;
    position: sticky;
    top: 96px;
  }

  .chapter-num { color: var(--accent); }
  .chapter-place { color: var(--ink-primary); }

  .chapter-main h2 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
    text-wrap: balance;
  }

  .chapter-body {
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.7;
    color: var(--ink-secondary);
    max-width: 36em;
  }

  .chapter-body :global(p) { margin: 0 0 1.2em; text-wrap: pretty; }
  .chapter-body :global(p:last-child) { margin-bottom: 0; }
  .chapter-body :global(strong) { color: var(--ink-primary); font-weight: 600; }

  .chapter-body :global(a) {
    color: var(--ink-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
    transition: color var(--dur-fast);
  }

  .chapter-body :global(a:hover) { color: var(--accent); }

  /* Off the clock */
  .off-clock,
  .useful,
  .record,
  .contact { margin-top: clamp(72px, 9vw, 120px); }

  .off-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 40px;
  }

  .off-grid h3 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 30px;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }

  .off-grid p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-secondary);
    margin: 0 0 16px;
  }

  .off-grid a { color: var(--ink-primary); font-size: 11px; transition: color var(--dur-fast); }
  .off-grid a:hover { color: var(--accent); }

  /* Useful */
  .useful-lede {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 32em;
    margin: 0 0 20px;
  }

  .useful-not { color: var(--ink-quiet); font-size: 16px; margin: 0; }

  /* Record */
  .record { scroll-margin-top: 80px; }

  .record-head { color: var(--ink-secondary); font-weight: 400; font-size: 11px; margin: 32px 0 4px; }

  .record-list { list-style: none; margin: 0; padding: 0; }

  .record-list li {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
    gap: 4px 24px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--surface-line);
  }

  .r-org { font-family: var(--font-serif); font-size: 20px; }
  .r-role { color: var(--ink-secondary); font-size: 16px; }
  .r-when { color: var(--ink-quiet); font-size: 11px; text-align: right; }

  .certs { color: var(--ink-secondary); font-size: 15px; line-height: 1.7; margin: 8px 0 0; }

  /* Contact */
  .contact-email {
    display: inline-block;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(34px, 7vw, 96px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
    overflow-wrap: anywhere;
    transition: color var(--dur-fast);
  }

  .contact-email:hover { color: var(--accent); }
  .contact p { color: var(--ink-quiet); margin: 20px 0 0; font-size: 16px; }

  @media (max-width: 760px) {
    .chapter { grid-template-columns: minmax(0, 1fr); }
    .chapter-meta { position: static; flex-direction: row; flex-wrap: wrap; gap: 6px 16px; }
    .record-list li { grid-template-columns: minmax(0, 1fr); }
    .r-when { text-align: left; }
  }

  @media print {
    .head-links, .chapter-index, .contact { display: none !important; }
  }
</style>
