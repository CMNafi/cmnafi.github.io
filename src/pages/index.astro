---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LifeCircuit from '@/components/telemetry/LifeCircuit.astro';
import NoteRow from '@/components/NoteRow.astro';
import {getCollection} from 'astro:content';
import {homepageNotes,isPublicNote,isProject,projectUrl} from '@/config/editorial';
const notes=(await getCollection('field-notes')).filter(isPublicNote).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const featured=notes.find(n=>n.slug==='uber-the-32-billion-hole')||notes[0];
const selected=homepageNotes.map(slug=>notes.find(n=>n.slug===slug)).filter((n):n is typeof notes[number]=>!!n&&n.slug!==featured?.slug).slice(0,6);
const projects=(await getCollection('projects')).filter(isProject);
const live=projects.filter(p=>p.data.status==='live'&&projectUrl(p)&&!['world-cup-corner','form-adv-data-finder','adv-screener','caia-corner'].includes(p.slug)).sort((a,b)=>b.data.priority-a.data.priority).slice(0,4);
const counts=[...new Set(notes.map(n=>n.data.category))].map(c=>`${c} ${notes.filter(n=>n.data.category===c).length}`);
---
<BaseLayout title="Capital, code, cricket" canonical="/" description="C M Nafi. Solutions engineer at Dasseti, writing about capital, technology, and cricket, and building tools to understand the systems behind them.">
<div class="page-container home-editorial"><section class="home-hero"><div class="hero-title"><span class="eyebrow">C M Nafi · Tampa, Florida</span><h1>Capital,<br/>code,<br/><em>cricket.</em></h1></div><div class="hero-route"><LifeCircuit/></div><div class="hero-copy"><p>Solutions Engineer at <a href="/story/#stint-dasseti">Dasseti</a>. Previously <a href="/story/#stint-blackrock">BlackRock</a>, <a href="/story/#stint-skybridge">SkyBridge</a>, and <a href="/story/#stint-mayoclinic">Mayo Clinic</a>. I build tools and write about the systems behind capital, technology, and the games we play.</p><div class="hero-actions"><a class="action" href="/field-notes/">Read the field notes <span>↗</span></a><a class="text-link" href="/garage/">Enter the garage ↗</a></div></div></section>
<section class="home-section"><div class="section-rule"><h2>Sector 01 / Field Notes</h2><span>{notes.length} published · {counts.join(' / ')}</span></div>{featured&&<a class="featured-essay" href={`/field-notes/${featured.slug}/`}><span class="eyebrow">Selected essay / {featured.data.category}</span><h2>{featured.data.title}<span aria-hidden="true"> ↗</span></h2><p>{featured.data.excerpt}</p></a>}<div>{selected.map(note=><NoteRow note={note}/>)}</div><a class="text-link section-end" href="/field-notes/">All {notes.length} field notes →</a></section>
<section class="home-section"><div class="section-rule"><h2>Sector 02 / Garage</h2><span>{projects.length} projects / tools & experiments</span></div><div class="home-projects">{live.map(project=><a href={projectUrl(project)!} data-astro-reload><span class="eyebrow"><span class="status-dot"/> {project.data.category} / live</span><h3>{project.data.title}</h3><p>{project.data.summary}</p><span class="text-link">Open ↗</span></a>)}</div><a class="text-link section-end" href="/garage/">The whole garage →</a></section>
<section class="home-section home-story"><div class="section-rule"><h2>Sector 03 / Story</h2><span>Bangladesh → China → Iowa → Florida</span></div><p>Grew up in <em>Dinajpur.</em> Left home at sixteen on a full scholarship to a United World College in <em>Changshu.</em> Studied data science in <em>Decorah.</em> Now in <em>Tampa,</em> where the F1, the cricket, and the work all happen to sit.</p><a class="text-link" href="/story/">Read the full story →</a></section>
<section class="home-close"><span class="eyebrow">A good conversation starts somewhere.</span><a href="mailto:nafi@cmnafi.com">nafi@cmnafi.com <span>↗</span></a></section></div></BaseLayout>
<style>
.home-editorial{padding-top:45px}.home-hero{display:grid;grid-template-columns:.9fr 1.1fr;grid-template-areas:'title route' 'copy route';column-gap:50px;min-height:680px;align-items:center}.hero-title{grid-area:title}.hero-title h1{font-size:clamp(80px,10vw,144px);line-height:.92;letter-spacing:-.065em;margin:30px 0}.hero-title em{font-weight:300}.hero-route{grid-area:route}.hero-copy{grid-area:copy;max-width:540px;align-self:start}.hero-copy p{font-size:18px;color:var(--ink-secondary);margin:8px 0 24px}.hero-copy p a{color:var(--ink-primary)}.hero-actions{display:flex;gap:26px;align-items:center;flex-wrap:wrap}.home-section{margin-top:95px}.featured-essay{display:block;padding:25px 0 55px;max-width:980px}.featured-essay h2{font-size:clamp(42px,6.5vw,88px);margin:22px 0;line-height:1.02}.featured-essay h2 span{font-size:.55em}.featured-essay p{font-size:22px;max-width:740px;color:var(--ink-secondary)}.section-end{margin-top:22px}.home-projects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.home-projects>a{padding:22px 0;border-bottom:1px solid var(--surface-line);display:flex;flex-direction:column}.home-projects h3{font-size:36px;margin:25px 0 16px}.home-projects p{font-size:16px;color:var(--ink-secondary);flex:1}.status-dot{display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%;margin-right:5px}.home-story>p{font-size:clamp(28px,4vw,52px);line-height:1.25;letter-spacing:-.035em;margin:25px 0}.home-close{padding:75px 0 20px;margin-top:80px;border-top:1px solid var(--surface-line)}.home-close>a{display:block;font-size:clamp(28px,5.7vw,78px);letter-spacing:-.04em;line-height:1.2;margin-top:20px}.home-close>a span{font-size:.6em}@media(max-width:850px){.home-hero{grid-template-columns:1fr;grid-template-areas:'title' 'route' 'copy';min-height:0}.hero-title h1{font-size:clamp(76px,17vw,115px)}.hero-route{margin:25px 0 30px}.hero-copy{max-width:650px}.home-section{margin-top:65px}.home-projects{grid-template-columns:1fr}.home-projects>a{padding:15px 0}.home-close{margin-top:55px;padding-top:40px}}
</style>
