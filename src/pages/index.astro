---
/**
 * Homepage: who Nafi is, the three things he keeps doing, the latest writing,
 * the tools that are live, and how to reach him. Copy follows STORY.md.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

const notes = (await getCollection('field-notes'))
  .filter((n) => !n.data.draft && n.data.category.trim() !== 'Brewing')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const recent = notes.slice(0, 5);

const tools = (await getCollection('projects'))
  .filter((p) => p.data.status === 'live' && !['play', 'world-cup-corner'].includes(p.slug))
  .sort((a, b) => b.data.priority - a.data.priority || a.data.title.localeCompare(b.data.title))
  .slice(0, 4);

const day = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
const firstSentence = (text: string) => text.match(/^.*?[.?!](?=\s|$)/)?.[0] ?? text;

const habits = [
  {
    habit: 'Numbers into stories',
    name: 'Field Notes',
    href: '/field-notes',
    note: `${notes.length} notes on how capital moves, the books I read, and the close finishes in league cricket.`
  },
  {
    habit: 'Problems into tools',
    name: 'Garage',
    href: '/garage',
    note: 'Small tools I wanted and couldn’t find. I build them with AI coding tools.'
  },
  {
    habit: 'Matches into memory',
    name: 'Play',
    href: '/play',
    note: 'League cricket in Florida, Formula 1, and a fantasy football squad I have to live with every week.'
  }
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.author,
  url: siteConfig.siteUrl,
  jobTitle: 'Solutions Engineer',
  worksFor: { '@type': 'Organization', name: 'Dasseti' },
  sameAs: siteConfig.socialLinks.filter((l) => l.href.startsWith('http')).map((l) => l.href)
};
---

<BaseLayout canonical="/">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </Fragment>

  <div class="s-page home">
    <section class="home-intro">
      <div class="home-intro__text">
        <p class="s-eyebrow">Solutions engineer · Land O’ Lakes, Florida</p>
        <h1 class="s-title">Learn the room. <em>Then translate.</em></h1>
        <p class="s-lede">
          I’m Nafi. I work at Dasseti, where I sit between investment teams and the software they run due
          diligence on, and translate in both directions. Before that I worked at BlackRock, SkyBridge and
          Mayo Clinic.
        </p>
        <p class="s-lede">
          I left home at twelve for military school and have been learning new places since.
          <a href="/story">Read the story</a>, or <a href={`mailto:${siteConfig.email}`}>send me an email</a>.
        </p>
      </div>
      <img
        class="home-intro__photo"
        src="/profile.jpg"
        alt="C M Nafi"
        width="1080"
        height="1080"
        decoding="async"
      />
    </section>

    <section class="s-section" aria-labelledby="home-habits">
      <div class="s-section-head">
        <h2 id="home-habits">The same habit, three places</h2>
      </div>
      <div class="home-habits">
        {habits.map((h) => (
          <a class="home-habit" href={h.href}>
            <span class="home-habit__habit">{h.habit}</span>
            <span class="home-habit__name">{h.name} <span aria-hidden="true">→</span></span>
            <span class="home-habit__note">{h.note}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="s-section" aria-labelledby="home-writing">
      <div class="s-section-head">
        <h2 id="home-writing">Recent writing</h2>
        <a class="s-more" href="/field-notes">All {notes.length} notes</a>
      </div>
      <ul class="s-rows" role="list">
        {recent.map((note) => (
          <li>
            <a class="s-row" href={`/field-notes/${note.slug}`}>
              <time class="s-row__meta" datetime={note.data.publishedAt.toISOString()}>{day(note.data.publishedAt)}</time>
              <span>
                <span class="s-row__title">{note.data.title}</span>
                <span class="s-row__note">{note.data.excerpt}</span>
              </span>
              <span class="s-row__tag">{note.data.category.trim()}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="s-section" aria-labelledby="home-tools">
      <div class="s-section-head">
        <h2 id="home-tools">Tools you can try</h2>
        <a class="s-more" href="/garage">The whole Garage</a>
      </div>
      <ul class="s-rows" role="list">
        {tools.map((tool) => (
          <li>
            <a class="s-row" href={tool.slug === 'form-adv-data-finder' ? `/garage/${tool.slug}` : tool.data.liveUrl || `/garage/${tool.slug}`}>
              <span class="s-row__meta">{tool.data.category}</span>
              <span>
                <span class="s-row__title">{tool.data.title}</span>
                <span class="s-row__note">{firstSentence(tool.data.summary)}</span>
              </span>
              <span class="s-row__tag s-row__tag--live">Live</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="s-section home-contact" aria-labelledby="home-contact">
      <h2 class="home-contact__title" id="home-contact">Say hello.</h2>
      <p class="s-lede">
        If something here was useful, or wrong, I’d like to hear about it. A question about a Field Note
        or a cricket match is welcome too.
      </p>
      <a class="home-contact__email" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </section>
  </div>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(200px, 26vw, 320px);
    align-items: end;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }

  .home-intro__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-card);
    border: 1px solid var(--surface-line);
  }

  .home-habits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-habit {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem 1.75rem 1.75rem 0;
    border-bottom: 1px solid var(--surface-line);
  }

  .home-habit + .home-habit {
    padding-left: 1.75rem;
    border-left: 1px solid var(--surface-line);
  }

  .home-habit__habit {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }

  .home-habit__name {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
    transition: color var(--dur-fast) var(--ease-mechanical);
  }

  .home-habit__name span {
    display: inline-block;
    font-size: 0.7em;
    color: var(--ink-tertiary);
    transition: transform var(--dur-base) var(--ease-instrument), color var(--dur-fast) var(--ease-mechanical);
  }

  .home-habit:hover .home-habit__name,
  .home-habit:focus-visible .home-habit__name,
  .home-habit:hover .home-habit__name span,
  .home-habit:focus-visible .home-habit__name span {
    color: var(--accent);
  }

  .home-habit:hover .home-habit__name span,
  .home-habit:focus-visible .home-habit__name span {
    transform: translateX(4px);
  }

  .home-habit__note {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-secondary);
  }

  .home-contact__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink-primary);
  }

  .home-contact__email {
    display: inline-block;
    margin-top: 1.5rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--accent);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    color: var(--ink-primary);
    transition: color var(--dur-fast) var(--ease-mechanical);
  }

  .home-contact__email:hover,
  .home-contact__email:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .home-intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-intro__photo {
      order: -1;
      width: 132px;
      aspect-ratio: 1;
    }

    .home-habits {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-habit,
    .home-habit + .home-habit {
      padding: 1.4rem 0;
      border-left: 0;
    }
  }
</style>
