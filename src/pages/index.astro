---
import { getCollection, type CollectionEntry } from 'astro:content';
import FormAdvMiniExplorer from '@/components/codex/islands/FormAdvMiniExplorer.astro';
import CricketFieldingTactician from '@/components/codex/islands/CricketFieldingTactician.astro';
import '@/styles/home-hub.css';
import JourneyScrollytellingHero from '@/components/islands/JourneyScrollytellingHero.astro';
const entries: CollectionEntry<'field-notes'>[] = await getCollection('field-notes');
const notes = entries.filter(n => !n.data.draft).sort((a,b) => b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const slugs = ['retail-software-landscape','uber-the-32-billion-hole','the-open-syllabus','adv-universe','gamestop-bid-for-ebay','capital-lens-16','four-wickets-and-a-chase-blazehawks-vs-go-leopards','one-of-those-days-swat-vs-tampa-telugu-titans','seven-to-defend-swat-vs-royal-phoenix','going-infinite','good-to-great'];
const selected = slugs.map(slug => notes.find(n=>n.slug===slug)).filter((n): n is NonNullable<typeof n> => Boolean(n));
const stream = (n: typeof notes[number]) => n.slug==='the-open-syllabus' ? 'finance' : n.data.category.toLowerCase();
const streams = [{id:'all',name:'All selected'},{id:'finance',name:'Capital & systems'},{id:'cricket',name:'Cricket logs'},{id:'books',name:'Book notes'}];
const latest = notes[0];
const builds = [
  {id:'claude',name:'The editorial monograph',description:'A warm reading-first version, with generous margins and a curated research archive.',focus:'Narrative pacing and long-form reading'},
  {id:'gem',name:'The interactive systems lab',description:'An experiment in bringing the tools and the stories behind them into the same room.',focus:'Interactive demos and structured ledgers'},
  {id:'codex',name:'The editorial workbench',description:'A paper-and-dark workspace for source-linked adviser snapshots, cricket tactics, and thoughtful writing.',focus:'Real data, simple controls, and a clear index'}
];
const chapters = [
  {id:'dasseti',context:'Institutional fintech',organization:'Dasseti',period:'2023 to now',title:'Translating between teams and software',body:'I work as a solutions engineer at Dasseti, working in institutional fintech. The job is to understand the investment team’s question and help the product answer it in language that makes sense to them.',lesson:'Learn how the room talks before deciding what it needs.',href:'/story/#dasseti'},
  {id:'blackrock',context:'Asset management',organization:'BlackRock',period:'2022 to 2023',title:'A trillion dollars is a storytelling problem',body:'At BlackRock, I worked in Data & AI. Numbers mattered, but so did the way people understood them. An application mix-up between Blackstone and BlackRock became part of how I found that room.',lesson:'The names can be similar. The businesses behind them are not.',href:'/field-notes/blackstone-vs-blackrock/'},
  {id:'skybridge',context:'Alternative investments',organization:'SkyBridge Associates',period:'2021 to 2022',title:'Narrative is translation',body:'My internship at SkyBridge connected alternative investments with the questions people actually ask about a manager. It was also where a recommendation to read Good to Great stayed with me.',lesson:'A useful story helps someone see what the numbers are saying.',href:'/field-notes/good-to-great/'},
  {id:'mayo',context:'Healthcare & research',organization:'Mayo Clinic',period:'2021 to 2022',title:'Messy data is the job',body:'Working with healthcare data at Mayo Clinic taught me to pay attention to the seams: what a field means, where it comes from, and what changes when it passes from one system to another.',lesson:'The work begins with understanding the data you have.',href:'/story/#rochester-mayo'},
  {id:'origins',context:'Education & data science',organization:'School & college',period:'Childhood to 2022',title:'The newest person in the room',body:'I left home at twelve for Rangpur Cadet College. At sixteen, a full scholarship took me to UWC Changshu. At Luther College, I studied data science with a computer science minor.',lesson:'Listen first. Learn the room. Then make yourself useful.',href:'/story/'}
];
const initial = chapters[0];
const title='C M Nafi | Curiosities, Systems & Stories';
const description='Solutions engineer at Dasseti in institutional fintech. Notes on capital, books and cricket, tools from the Garage, and three live website redesign experiments.';
---
<!doctype html>
<html lang="en" data-theme="paper">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href="https://www.cmnafi.com/" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content="https://www.cmnafi.com/" /><meta property="og:type" content="website" /><meta property="og:image" content="https://www.cmnafi.com/og-default.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&amp;family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400&amp;display=swap" rel="stylesheet" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content="#FAF8F5" />
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('cmnafi.home.theme')==='dark'?'dark':'paper'}catch{}</script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-W7QGKS85CP"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-W7QGKS85CP');</script>
</head>
<body id="top">
  <a class="home-skip" href="#main">Skip to content</a>
  <div class="beta-ribbon"><div class="beta-ribbon-inner"><div><span class="beta-badge">The redesign notebook</span><span class="ribbon-copy">One brief. Three different versions. Take a look.</span></div><nav class="beta-links" aria-label="Beta builds">{builds.map(build=><a class="beta-pill" href={`/${build.id}/`}>/{build.id} ↗</a>)}</nav></div></div>
  <header class="site-header"><div class="brand"><a href="/" class="brand-name">C M Nafi</a><span class="brand-tag">Curiosities, systems & stories</span></div><nav class="nav-row" aria-label="Primary navigation"><a href="/garage/">The Garage</a><a href="/field-notes/">Field Notes</a><a href="/play/">Play</a><a href="/story/">My Story</a><a href="/connect/">Connect</a><button class="theme-btn" id="home-theme-toggle" type="button">Theme: Paper</button></nav></header>
  <main id="main">
    <JourneyScrollytellingHero />
    <section class="hero" id="home-notebook" aria-labelledby="hero-title"><div><div class="hero-kicker">Solutions engineer · Numbers, tools, and matches</div><h2 class="hero-title" id="hero-title">Building the tools I wish existed.<br />Writing down what I learn <em>along the way.</em></h2><p class="hero-prose">I’m Nafi, a solutions engineer at <strong>Dasseti</strong> in institutional fintech. Before this, I worked at <strong>BlackRock</strong> in asset management, <strong>SkyBridge Associates</strong> in alternative investments, and <strong>Mayo Clinic</strong> in healthcare and research. Different rooms, the same habit: understand the question before trying to answer it.</p><p class="hero-prose">I left home at twelve for <strong>Rangpur Cadet College</strong>, moved to <strong>UWC Changshu</strong> on a full scholarship at sixteen, and studied data science at <strong>Luther College</strong>. These days I translate between investment teams and software, write about capital, and turn up for weekend cricket.</p><blockquote class="hero-quote">Learn the room. Then translate.</blockquote></div><aside class="now-card" aria-label="Current notebook"><div class="now-header"><span>Current notebook</span><span>Institutional fintech</span></div><ul class="now-list"><li><span class="now-item-label">Day job</span><div class="now-item-val">Solutions Engineer at Dasseti</div><div class="now-item-sub">Investment teams, due diligence, and the software they use.</div></li><li><span class="now-item-label">On the workbench</span><a class="now-item-val" href="/garage/">Regulatory Lens & cricket tools ↗</a><div class="now-item-sub">Small tools for questions I keep coming back to.</div></li><li><span class="now-item-label">Latest field note</span><a class="now-item-val" href={`/field-notes/${latest.slug}/`}>{latest.data.title} ↗</a><div class="now-item-sub">{latest.data.excerpt}</div></li><li><span class="now-item-label">Off the clock</span><a class="now-item-val" href="/play/">Cricket, FPL, and Formula 1 ↗</a><div class="now-item-sub">The teams I turn up for and the games I follow.</div></li></ul></aside></section>
    <section class="section-block latest-report" aria-labelledby="latest-report-title"><div class="section-head"><div><span class="hero-kicker">New research · October 14, 2026</span><h2 class="section-title" id="latest-report-title">The retail software stack.</h2><p class="section-subtitle">Who runs the till, the pumps, and the back office, and where the workflow breaks. A full report across six retail verticals, with searchable pricing tables and an analysis of the manual steps AI could help with.</p></div><a class="btn-launch" href="/field-notes/retail-software-landscape/">Read the interactive report ↗</a></div></section>
    <section class="section-block" id="beta-lab" aria-labelledby="beta-title"><div class="section-head"><div><h2 class="section-title" id="beta-title">Three ways to tell the same story.</h2><p class="section-subtitle">I gave Claude, Gemini, and Codex the same redesign brief. Their builds are here to explore. Which one feels most like a place you would come back to?</p></div><span class="section-link" id="home-vote-status" role="status">Save a preference in this browser.</span></div><div class="beta-grid">{builds.map((build,i)=><article class="beta-card"><div><div class="beta-card-top"><span class="beta-route">cmnafi.com/{build.id}</span><span class="beta-status">Build {i+1}</span></div><h3>{build.name}</h3><p>{build.description}</p><p class="beta-traits">{build.focus}</p></div><div class="beta-card-actions"><a class="btn-launch" href={`/${build.id}/`}>Open /{build.id} ↗</a><button class="btn-vote" data-build={build.id} aria-pressed="false" type="button">My favorite</button></div></article>)}</div><p class="local-choice-note">Your choice stays on this device. It is not a public vote tally.</p></section>
    <section class="section-block" id="story" aria-labelledby="chapters-title"><div class="section-head"><div><h2 class="section-title" id="chapters-title">What each room taught me.</h2><p class="section-subtitle">A few chapters from home, college, and work. Click a chapter to read the part that stayed with me.</p></div><a class="section-link" href="/story/">The full story →</a></div><div class="story-explorer"><div class="stop-tabs" role="group" aria-label="Career chapters">{chapters.map((chapter,i)=><button class:list={['stop-btn',{active:i===0}]} data-chapter={i} aria-pressed={i===0?'true':'false'} type="button"><span><span class="stop-place">{chapter.organization}</span><span class="stop-org">{chapter.context}</span></span><span class="stop-years">{chapter.period}</span></button>)}</div><div class="stop-detail-panel" aria-live="polite"><div><div class="stop-detail-kicker" data-chapter-kicker>{initial.context} · {initial.period}</div><h3 class="stop-detail-title" data-chapter-title>{initial.title}</h3><p class="stop-detail-body" data-chapter-body>{initial.body}</p><div class="stop-lesson-box"><strong>What stayed with me</strong><span data-chapter-lesson>{initial.lesson}</span></div></div><a class="section-link" data-chapter-link href={initial.href}>Related story or note →</a></div></div><script is:inline type="application/json" id="home-chapters" set:html={JSON.stringify(chapters).replaceAll('<','\u003c')} /></section>
    <section class="section-block" id="garage" aria-labelledby="tools-title"><div class="section-head"><div><h2 class="section-title" id="tools-title">Try the question for yourself.</h2><p class="section-subtitle">Source-linked adviser snapshots and a cricket field you can move around. Inspect the assumptions, change the inputs, and see what happens.</p></div><a class="section-link" href="/garage/">The whole Garage →</a></div><div class="workbench-grid"><div class="island-card"><FormAdvMiniExplorer /></div><div class="island-card"><CricketFieldingTactician /></div></div></section>
    <section class="section-block" id="field-notes" aria-labelledby="notes-title"><div class="section-head"><div><h2 class="section-title" id="notes-title">Selected Field Notes.</h2><p class="section-subtitle">Capital research, reading notes, and matches worth keeping. Choose a stream to find a place to start.</p></div><a class="section-link" href="/field-notes/">All {notes.length} published notes →</a></div><div class="filter-bar" role="group" aria-label="Filter selected writing">{streams.map(s=><button class:list={['firm-pill',{active:s.id==='all'}]} data-writing-filter={s.id} type="button" aria-pressed={s.id==='all'?'true':'false'}>{s.name} ({s.id==='all'?selected.length:selected.filter(n=>stream(n)===s.id).length})</button>)}</div><div class="home-ledger-scroll"><table class="ledger-table"><thead><tr><th scope="col">Date</th><th scope="col">Essay / note & core question</th><th scope="col">Stream</th><th scope="col">Read</th></tr></thead><tbody>{selected.map(note=><tr data-writing-stream={stream(note)}><td class="tabular"><time datetime={note.data.publishedAt.toISOString()}>{note.data.publishedAt.toISOString().slice(0,10)}</time></td><td><a class="essay-title-cell" href={`/field-notes/${note.slug}/`}>{note.data.title}</a><span class="essay-desc-cell">{note.data.excerpt}</span></td><td><span class="stream-tag">{note.slug==='the-open-syllabus'?'Systems & learning':note.data.category}</span></td><td class="tabular">{note.data.readingTime}</td></tr>)}</tbody></table></div></section>
    <section class="section-block home-contact" id="connect" aria-labelledby="hello-title"><div class="section-head"><div><h2 class="section-title" id="hello-title">Say hello.</h2><p class="section-subtitle">Happy to talk about allocator workflows, a good book, a close finish in cricket, or which beta build you liked best.</p></div><div><button class="btn-launch" id="home-copy-email" type="button">Copy nafi@cmnafi.com</button><p id="home-copy-status" role="status"></p></div></div><a class="section-link" href="/connect/">More ways to connect →</a></section>
  </main>
  <footer class="site-footer"><div>© {new Date().getFullYear()} C M Nafi · Notes, tools & weekend cricket</div><nav class="footer-links" aria-label="Footer"><a href="/sitemap/">Sitemap</a><a href="https://www.linkedin.com/in/cm-nafi/">LinkedIn ↗</a><a href="https://github.com/CMNafi">GitHub ↗</a><a href="mailto:nafi@cmnafi.com">Email</a></nav></footer>
</body></html>
<script>
  const themeButton=document.querySelector<HTMLButtonElement>('#home-theme-toggle');
  const showTheme=()=>{if(themeButton)themeButton.textContent=document.documentElement.dataset.theme==='dark'?'Theme: Dark':'Theme: Paper';};
  showTheme();themeButton?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'paper':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('cmnafi.home.theme',next)}catch{}showTheme();});
  const votes=[...document.querySelectorAll<HTMLButtonElement>('[data-build]')];
  const choose=(id:string)=>{votes.forEach(button=>{const active=button.dataset.build===id;button.classList.toggle('voted',active);button.setAttribute('aria-pressed',String(active));button.textContent=active?'Saved as my favorite':'My favorite';});const status=document.querySelector('#home-vote-status');if(status)status.textContent=`Your local preference: /${id}.`;};
  try{const saved=localStorage.getItem('cmnafi.home.build');if(saved&&votes.some(b=>b.dataset.build===saved))choose(saved)}catch{}
  votes.forEach(button=>button.addEventListener('click',()=>{const id=button.dataset.build!;choose(id);try{localStorage.setItem('cmnafi.home.build',id)}catch{const status=document.querySelector('#home-vote-status');if(status)status.textContent='Preference selected. This browser cannot save it.';}}));
  const chapters=JSON.parse(document.querySelector('#home-chapters')!.textContent!) as {context:string;period:string;title:string;body:string;lesson:string;href:string}[];
  document.querySelectorAll<HTMLButtonElement>('[data-chapter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-chapter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});const c=chapters[Number(button.dataset.chapter)];for(const [selector,value] of [['[data-chapter-kicker]',`${c.context} · ${c.period}`],['[data-chapter-title]',c.title],['[data-chapter-body]',c.body],['[data-chapter-lesson]',c.lesson]])document.querySelector(selector)!.textContent=value;document.querySelector<HTMLAnchorElement>('[data-chapter-link]')!.href=c.href;}));
  document.querySelectorAll<HTMLButtonElement>('[data-writing-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-writing-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});document.querySelectorAll<HTMLElement>('[data-writing-stream]').forEach(row=>{row.hidden=button.dataset.writingFilter!=='all'&&button.dataset.writingFilter!==row.dataset.writingStream;});}));
  document.querySelector('#home-copy-email')?.addEventListener('click',async()=>{const status=document.querySelector('#home-copy-status')!;try{await navigator.clipboard.writeText('nafi@cmnafi.com');status.textContent='Email copied.'}catch{status.textContent='Email: nafi@cmnafi.com';}});
</script>
