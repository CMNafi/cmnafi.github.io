---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LapTimer from '@/components/telemetry/LapTimer.astro';
import { getCollection } from 'astro:content';

// Copy on this page follows STORY.md. Layout follows the October 2026 homepage mockup.

const notes = (await getCollection('field-notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [leadNote, ...olderNotes] = notes;
const recentNotes = olderNotes.slice(0, 5);

const projects = (await getCollection('projects')).sort((a, b) => b.data.priority - a.data.priority);
const liveProjects = projects.filter((p) => p.data.status === 'live');
const tileProjects = liveProjects.slice(0, 3);
const alsoLive = liveProjects.slice(3);
const brewing = projects.filter(
  (p) => p.data.status === 'brewing' && !['homepage', 'more-tools-brewing'].includes(p.slug)
);
const projectHref = (p: (typeof projects)[number]) =>
  p.data.status === 'live' && p.data.liveUrl ? p.data.liveUrl : `/garage/${p.slug}`;

const nav = [
  { label: 'Field Notes', href: '/field-notes' },
  { label: 'Garage', href: '/garage' },
  { label: 'Story', href: '/story' },
  { label: 'Connect', href: '/connect' }
];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
const shortRead = (rt: string) => rt.replace(/\s*read$/i, '');

// One lap of the story. Positions are % of the track box (viewBox 50 20 1040 548).
const turns = [
  { no: '01', name: 'Dinajpur', place: 'Dinajpur, Bangladesh', when: 'Childhood', x: 5.58, y: 87.23, side: 'below',
    what: 'A house where reading was the default answer to boredom. The one room where I was never new.' },
  { no: '02', name: 'Rangpur', place: 'Rangpur, Bangladesh', when: 'Age 12', x: 5.19, y: 62.04, side: 'right',
    what: 'Left home for military school. Sixty-six kilometres away, and a very long way from home.' },
  { no: '03', name: 'Changshu', place: 'Changshu, China', when: '2016 · Age 16', x: 16.92, y: 14.6, side: 'above',
    what: 'UWC on a full scholarship. A new country, a language I didn’t speak, classmates from 100+ countries.' },
  { no: '04', name: 'Decorah', place: 'Decorah, Iowa', when: '2018 to 2022', x: 61.54, y: 8.76, side: 'above',
    what: 'Data Science in a town of eight thousand. Applied to Blackstone; the interview invitation said BlackRock.' },
  { no: '05', name: 'Rochester', place: 'Rochester, Minnesota', when: '2021 to 2022', x: 64.04, y: 33.58, side: 'left',
    what: 'Mayo Clinic, as an AI intern. Messy clinical data, and my first job that was mostly translation.' },
  { no: '06', name: 'Wilmington', place: 'Wilmington, Delaware', when: '2022 to 2023', x: 80.96, y: 49.64, side: 'left',
    what: 'BlackRock, after SkyBridge. A trillion dollars is a spreadsheet problem, a risk problem and a storytelling problem.' },
  { no: '07', name: 'New York', place: 'New York', when: 'Now', x: 51.92, y: 78.83, side: 'right',
    what: 'Solutions engineer at Dasseti, working remotely. Translating between investment teams and their software.' }
];
const currentTurn = turns[turns.length - 1];

const trackPath =
  'M330,520 C310,520 207,524 170,520 C133,516 131,519 108,498 C85,477 83,468 82,440 C81,412 93,389 104,360 C115,331 170,193 190,150 C210,107 205,115 226,100 C247,85 247,87 286,82 C325,77 442,73 460,72 C478,71 609,61 640,60 C671,59 672,55 690,68 C708,81 707,83 708,108 C709,133 692,134 694,160 C696,186 696,189 716,204 C736,219 750,215 770,218 C790,221 818,217 836,222 C854,227 865,232 876,246 C887,260 894,265 892,292 C890,319 889,321 870,336 C851,351 848,350 820,350 C792,350 726,341 700,338 C674,335 651,327 628,330 C605,333 599,333 584,352 C569,371 571,377 572,400 C573,423 587,426 590,452 C593,478 595,478 582,496 C569,514 562,513 540,518 C518,523 491,520 470,520 C449,520 350,520 330,520Z';
---

<BaseLayout
  title="C M Nafi"
  description="Solutions engineer at Dasseti, based in New York. I left home at twelve and have been learning new rooms ever since. Field notes on how capital moves, small tools, and cricket."
  hideHeader={true}
>
  <div class="home">
    <header class="home-header wrap">
      <a class="wordmark" href="/">C M Nafi</a>
      <nav class="home-nav" aria-label="Primary">
        {nav.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
      </nav>
      <div class="lap" aria-hidden="true">
        <span class="pulse-dot"></span>
        <span>Lap</span>
        <LapTimer id="home-lap-timer" isLive={true} />
      </div>
    </header>

    <section class="opening wrap" aria-labelledby="opening-title">
      <h1 id="opening-title" class="opening-title">
        <span class="rise" style="animation-delay: 0.05s">Learn the room.</span>
        <span class="rise" style="animation-delay: 0.18s">Then <em>translate.</em></span>
      </h1>

      <div class="opening-copy">
        <p class="opening-lede rise" style="animation-delay: 0.4s">
          I'm Nafi. I left home at twelve and have been the newest person in the room ever since. Now it's the
          job: as a solutions engineer at <a href="/story#dasseti">Dasseti</a>, I sit between investment teams and
          the software they run due diligence on, and translate in both directions.
        </p>
        <p class="opening-quiet rise" style="animation-delay: 0.5s">
          Before that: BlackRock, SkyBridge, Mayo Clinic. Based in New York, working remotely.
        </p>
        <div class="opening-actions rise" style="animation-delay: 0.6s">
          <a class="btn" href="/story">Read the story <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
          <a class="txt-link" href="/field-notes">Field notes <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
        </div>
      </div>

      <figure class="lap-map" aria-labelledby="lap-caption-title">
        <div class="lap-head">
          <span id="lap-caption-title">One lap · Dinajpur to New York</span>
          <span>15,984 km · seven stops</span>
        </div>

        <div class="track-box">
          <svg viewBox="50 20 1040 548" aria-hidden="true" class="track-svg">
            <path d={trackPath} class="track-bed"></path>
            <path d={trackPath} class="track-line"></path>
            <line x1="330" y1="505" x2="330" y2="535" class="start-line"></line>
            <g class="lap-dot" style={`offset-path: path('${trackPath}')`}>
              <circle cx="0" cy="0" r="17" class="lap-dot-halo"></circle>
              <circle cx="0" cy="0" r="6.5" class="lap-dot-core"></circle>
            </g>
          </svg>

          <span class="sf-label" aria-hidden="true">S/F</span>

          {turns.map((t, i) => (
            <button
              type="button"
              class:list={['turn', 'rise', `label-${t.side}`, { 'is-current': t === currentTurn }]}
              style={`left: ${t.x}%; top: ${t.y}%; animation-delay: ${1.4 + i * 0.12}s`}
              aria-label={`Stop ${t.no}, ${t.place}`}
              aria-pressed={t === currentTurn ? 'true' : 'false'}
              data-no={t.no}
              data-place={t.place}
              data-when={t.when}
              data-what={t.what}
            >
              <span class="ring"></span>
              <span class="turn-label">{t.no} <span class="turn-name">{t.name}</span></span>
            </button>
          ))}
        </div>

        <figcaption class="lap-caption" aria-live="polite">
          <span class="cap-no">Stop <span data-cap="no">{currentTurn.no}</span> of 07</span>
          <span class="cap-place" data-cap="place">{currentTurn.place}</span>
          <span class="cap-when" data-cap="when">{currentTurn.when}</span>
          <span class="cap-what" data-cap="what">{currentTurn.what}</span>
        </figcaption>
      </figure>
    </section>

    {leadNote && (
      <section class="sector wrap" aria-labelledby="notes-title">
        <div class="sector-head">
          <div class="sector-name">
            <span class="sector-no">Sector 1</span>
            <h2 id="notes-title">Field Notes</h2>
          </div>
          <span>{notes.length} published</span>
        </div>

        <p class="sector-intro">Every big number has a story behind it. These are the ones I went and found.</p>

        <a class="feature" href={`/field-notes/${leadNote.slug}`}>
          <span class="meta">Latest · {leadNote.data.category} · {shortRead(leadNote.data.readingTime)} · {formatDate(leadNote.data.publishedAt)}</span>
          <h3 class="feature-title">{leadNote.data.title}</h3>
          <p class="feature-excerpt">{leadNote.data.excerpt || leadNote.data.description}</p>
          <span class="read-link">Read the note <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>

        <div class="rows">
          {recentNotes.map((n) => (
            <a class="row" href={`/field-notes/${n.slug}`}>
              <span class="row-date">{formatDate(n.data.publishedAt)}</span>
              <span class="row-title">{n.data.title}</span>
              <span class="row-meta">
                <span>{n.data.category}</span>
                <span>{shortRead(n.data.readingTime)}</span>
                <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg>
              </span>
            </a>
          ))}
        </div>

        <a class="txt-link more" href="/field-notes">All {notes.length} field notes <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
      </section>
    )}

    <section class="sector wrap" aria-labelledby="garage-title">
      <div class="sector-head">
        <div class="sector-name">
          <span class="sector-no">Sector 2</span>
          <h2 id="garage-title">Garage</h2>
        </div>
        <span>Tools I wanted, so I built them</span>
      </div>

      <p class="sector-intro">
        I'm not a software engineer. I build these the way I do the day job: describe exactly what should exist,
        then keep going until it does.
      </p>

      <div class="tiles">
        {tileProjects.map((p) => (
          <a class="tile" href={projectHref(p)}>
            <span class="tile-meta"><span class="dot live"></span><span class="tile-status">Live</span><span>{p.data.category}</span></span>
            <h3 class="tile-title">{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <span class="read-link">Open <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
          </a>
        ))}
        <a class="tile" href="/caia">
          <span class="tile-meta"><span class="dot live"></span><span class="tile-status">Live</span><span>Study hub</span></span>
          <h3 class="tile-title">CAIA Corner</h3>
          <p>An exam-aligned study hub for alternative investments: hedge funds, private equity, private debt and real assets.</p>
          <span class="read-link">Open <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>
      </div>

      {(alsoLive.length > 0 || brewing.length > 0) && (
        <div class="also">
          <span class="also-label">Also in the garage</span>
          {alsoLive.length > 0 && (
            <span class="also-item"><span class="dot live"></span>Live: {alsoLive.map((p) => p.data.title).join(', ')}</span>
          )}
          {brewing.length > 0 && (
            <span class="also-item"><span class="dot brewing"></span>Brewing: {brewing.map((p) => p.data.title).join(', ')}</span>
          )}
        </div>
      )}

      <a class="txt-link more" href="/garage">The whole garage <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
    </section>

    <section class="sector wrap" aria-labelledby="story-title">
      <div class="sector-head">
        <div class="sector-name">
          <span class="sector-no">Sector 3</span>
          <h2 id="story-title">Story</h2>
        </div>
        <span>Bangladesh · China · United States</span>
      </div>

      <p class="story-para">
        Grew up in <em>Dinajpur</em>. Left home at twelve for military school in <em>Rangpur</em>, and at sixteen for
        <em>Changshu</em>, on a full scholarship, without the language. Studied data science in <em>Decorah</em>, a town
        of eight thousand. Learned at <em>BlackRock</em> that a trillion dollars is a storytelling problem. Now in
        <em>New York</em>, translating for a living.
      </p>

      <a class="txt-link more" href="/story">Read all nine chapters <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
    </section>

    <section class="hello wrap" aria-labelledby="hello-title">
      <h2 id="hello-title" class="hello-label">Open to conversations</h2>
      <a class="hello-email" href="mailto:nafi@cmnafi.com">nafi@cmnafi.com</a>
      <p class="hello-note">
        Especially about due diligence, allocator workflows, and how investment teams actually adopt software.
      </p>
      <div class="hello-links">
        <a class="nav-link" href="https://www.linkedin.com/in/cm-nafi/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="nav-link" href="https://github.com/CMNafi" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="nav-link" href="/connect">Connect</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    --ink-quiet: #8f8475;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    container-type: inline-size;
    background: var(--surface-base);
    color: var(--ink-primary);
    font-family: var(--font-serif);
    overflow-x: clip;
  }

  .wrap {
    max-width: 1360px;
    margin: 0 auto;
    box-sizing: border-box;
    padding-left: clamp(16px, 4cqw, 56px);
    padding-right: clamp(16px, 4cqw, 56px);
  }

  .home a { color: var(--ink-primary); text-decoration: none; }

  .home :is(a, button):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Shared mono label voice */
  .home-nav,
  .lap,
  .btn,
  .txt-link,
  .read-link,
  .lap-head,
  .sf-label,
  .turn-label,
  .cap-no,
  .cap-when,
  .sector-head,
  .meta,
  .row-date,
  .row-meta,
  .tile-meta,
  .also,
  .hello-label,
  .hello-links {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Header */
  .home-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .wordmark { font-size: 22px; letter-spacing: -0.01em; padding: 8px 0; }

  .home-nav { display: flex; flex-wrap: wrap; gap: 0 clamp(18px, 2.5cqw, 36px); font-size: 12px; }

  .nav-link { color: var(--ink-secondary) !important; padding: 14px 0; transition: color var(--dur-fast); }
  .nav-link:hover { color: var(--ink-primary) !important; }

  .lap { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--ink-secondary); }

  .lap :global(.lap-timer) {
    background: none;
    border: 0;
    padding: 0;
    font-size: 12px;
    color: var(--ink-primary);
    min-width: 78px;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }

  /* Hero */
  .opening {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    grid-template-areas:
      'title title'
      'copy  map';
    gap: clamp(32px, 4cqw, 56px) clamp(32px, 4cqw, 72px);
    align-items: start;
    padding-top: clamp(24px, 4cqw, 64px);
    padding-bottom: clamp(64px, 8cqw, 120px);
  }

  .opening-title {
    grid-area: title;
    margin: 0;
    font-size: clamp(52px, 9.4cqw, 136px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .opening-title span { display: block; }
  .opening-title em { font-style: italic; padding-right: 0.05em; }

  .opening-copy { grid-area: copy; display: flex; flex-direction: column; gap: 22px; padding-top: 8px; }

  .opening-lede {
    margin: 0;
    font-size: clamp(19px, 1.5cqw, 22px);
    line-height: 1.55;
    color: var(--ink-primary);
    text-wrap: pretty;
  }

  .opening-lede a {
    text-decoration: underline !important;
    text-decoration-color: var(--accent) !important;
    text-underline-offset: 4px;
  }

  .opening-quiet { margin: 0; font-size: 17px; line-height: 1.5; color: var(--ink-secondary); }

  .opening-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; margin-top: 8px; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 26px;
    border-radius: 2px;
    background: var(--ink-primary);
    color: var(--surface-base) !important;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    transition: background var(--dur-fast);
  }

  .btn:hover { background: #ffffff; }

  .txt-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    font-size: 13px;
    letter-spacing: 0.1em;
    transition: color var(--dur-fast);
  }

  .txt-link:hover { color: var(--accent) !important; }

  .arr { display: inline-block; flex: none; transition: transform 0.32s var(--ease), color var(--dur-fast); }

  .btn:hover .arr,
  .txt-link:hover .arr,
  .row:hover .arr,
  .tile:hover .arr,
  .feature:hover .arr { transform: translateX(6px); }

  .row:hover .arr,
  .tile:hover .arr,
  .feature:hover .arr { color: var(--accent); }

  /* Lap map */
  .lap-map { grid-area: map; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 20px; }

  .lap-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    font-size: 11px;
    color: var(--ink-quiet);
  }

  .track-box { position: relative; width: 100%; aspect-ratio: 1040 / 548; container-type: inline-size; }

  .track-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .track-bed { fill: none; stroke: var(--ink-primary); stroke-opacity: 0.07; stroke-width: 30; stroke-linejoin: round; }

  .track-line {
    fill: none;
    stroke: var(--ink-primary);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 2280;
    animation: draw 2.4s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
  }

  .start-line { stroke: var(--ink-primary); stroke-width: 2; }

  .lap-dot { offset-rotate: 0deg; animation: lap 28s linear 2.4s infinite both; }
  .lap-dot-halo { fill: var(--accent); fill-opacity: 0.16; }
  .lap-dot-core { fill: var(--accent); }

  .sf-label {
    position: absolute;
    left: 26.92%;
    top: 95.6%;
    transform: translateX(-50%);
    font-size: 10px;
    color: var(--ink-quiet);
  }

  .turn {
    position: absolute;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    border: 0;
    background: none;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .ring {
    width: 11px;
    height: 11px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 1.5px solid var(--ink-primary);
    background: var(--surface-base);
    transition: transform var(--dur-fast), background var(--dur-fast), border-color var(--dur-fast);
  }

  .turn:hover .ring,
  .turn:focus-visible .ring,
  .turn[aria-pressed='true'] .ring {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.4);
  }

  .turn-label {
    position: absolute;
    display: flex;
    gap: 8px;
    white-space: nowrap;
    font-size: 11px;
    color: var(--ink-primary);
  }

  .turn-name { color: var(--ink-secondary); transition: color var(--dur-fast); }

  .turn:hover .turn-name,
  .turn:focus-visible .turn-name,
  .turn[aria-pressed='true'] .turn-name { color: var(--ink-primary); }

  .label-below .turn-label { top: 46px; left: 6px; }
  .label-above .turn-label { bottom: 40px; left: 6px; }
  .label-right .turn-label { left: 38px; top: 50%; transform: translateY(-50%); }
  .label-left .turn-label { right: 38px; top: 50%; transform: translateY(-50%); }

  .lap-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    padding-top: 18px;
    border-top: 1px solid var(--surface-line);
    min-height: 88px;
  }

  .cap-no { font-size: 11px; color: var(--accent); }
  .cap-place { font-size: 22px; letter-spacing: -0.01em; }
  .cap-when { font-size: 11px; color: var(--ink-quiet); }
  .cap-what { flex: 1 1 100%; font-size: 17px; line-height: 1.5; color: var(--ink-secondary); }

  /* Sectors */
  .sector { padding-top: clamp(48px, 6cqw, 88px); padding-bottom: clamp(48px, 6cqw, 88px); }

  .sector-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--surface-line);
    font-size: 12px;
    color: var(--ink-quiet);
  }

  .sector-name { display: flex; align-items: baseline; gap: 20px; }
  .sector-no { color: var(--ink-primary); }
  .sector-name h2 { margin: 0; font: inherit; letter-spacing: inherit; color: var(--ink-quiet); }

  .sector-intro {
    margin: clamp(32px, 4cqw, 56px) 0 0;
    max-width: 30em;
    font-size: clamp(24px, 2.6cqw, 36px);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .read-link { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: 0.1em; }
  .more { margin-top: 20px; }

  /* Field Notes feature + rows */
  .feature {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(36px, 4.5cqw, 64px) 0;
    border-bottom: 1px solid var(--surface-line);
  }

  .meta { font-size: 12px; color: var(--ink-quiet); }

  .feature-title {
    margin: 0;
    max-width: 18em;
    font-size: clamp(36px, 5.4cqw, 80px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
    transition: transform 0.32s var(--ease);
  }

  .feature:hover .feature-title { transform: translateX(8px); }

  .feature-excerpt {
    margin: 0;
    max-width: 36em;
    font-size: clamp(18px, 1.45cqw, 21px);
    line-height: 1.55;
    color: var(--ink-secondary);
  }

  .rows { display: flex; flex-direction: column; }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--surface-line);
  }

  .row-date { flex: 0 0 128px; font-size: 12px; letter-spacing: 0.1em; color: var(--ink-quiet); }

  .row-title {
    flex: 1 1 420px;
    min-width: 0;
    font-size: clamp(21px, 2.1cqw, 28px);
    font-weight: 350;
    line-height: 1.2;
    letter-spacing: -0.015em;
    transition: transform 0.32s var(--ease);
  }

  .row:hover .row-title { transform: translateX(12px); }

  .row-meta { flex: 0 0 auto; display: flex; align-items: center; gap: 20px; font-size: 12px; letter-spacing: 0.1em; color: var(--ink-quiet); }

  /* Garage tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 40px;
    margin-top: clamp(28px, 3cqw, 40px);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 0 44px;
    border-top: 1px solid var(--surface-line);
  }

  .tile-meta { display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--ink-quiet); }
  .tile-status { color: var(--ink-primary); }

  .tile-title {
    margin: 0;
    font-size: clamp(28px, 2.6cqw, 36px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
    transition: transform 0.32s var(--ease);
  }

  .tile:hover .tile-title { transform: translateX(8px); }
  .tile p { margin: 0; flex: 1; font-size: 17px; line-height: 1.5; color: var(--ink-secondary); }

  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .dot.live { background: var(--accent); }
  .dot.brewing { background: var(--status-warn); }

  .also {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 36px;
    padding-top: 22px;
    border-top: 1px solid var(--surface-line);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--ink-secondary);
  }

  .also-label { letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-quiet); }
  .also-item { display: flex; align-items: center; gap: 10px; }

  /* Story paragraph */
  .story-para {
    margin: clamp(40px, 5cqw, 72px) 0 0;
    max-width: 1120px;
    font-size: clamp(28px, 3.9cqw, 54px);
    font-weight: 300;
    line-height: 1.16;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .story-para em { font-style: italic; }

  /* Hello */
  .hello {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: clamp(56px, 7cqw, 104px);
    padding-bottom: clamp(56px, 7cqw, 104px);
    border-top: 1px solid var(--surface-line);
  }

  .hello-label { margin: 0; font-size: 12px; font-weight: 400; color: var(--ink-quiet); }

  .hello-email {
    align-self: flex-start;
    max-width: 100%;
    font-size: clamp(34px, 8cqw, 116px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    transition: color var(--dur-fast);
  }

  .hello-email:hover { color: var(--accent) !important; }
  .hello-note { margin: 0; max-width: 34em; font-size: 18px; line-height: 1.5; color: var(--ink-secondary); }
  .hello-links { display: flex; flex-wrap: wrap; gap: 0 32px; font-size: 12px; letter-spacing: 0.1em; }

  /* Motion */
  .rise { animation: rise 1.1s var(--ease) both; }

  @keyframes rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  @keyframes draw { from { stroke-dashoffset: 2280; } to { stroke-dashoffset: 0; } }
  @keyframes lap { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* Responsive */
  @container (max-width: 1100px) {
    .opening {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'title' 'copy' 'map';
    }
    .opening-copy { max-width: 640px; }
  }

  @container (max-width: 1180px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @container (max-width: 860px) {
    .home-nav { order: 3; flex-basis: 100%; }
  }

  @container (max-width: 560px) {
    .row-date { flex-basis: 100%; }
    .tiles { grid-template-columns: minmax(0, 1fr); }
  }

  /* .track-box is its own container: drop stop names when the map gets small */
  @container (max-width: 480px) {
    .turn-name { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-line,
    .lap-dot,
    .rise,
    .pulse-dot { animation: none; }
  }
</style>

<script>
  // Hovering, focusing or tapping a stop on the lap map tells that part of the story
  function initLapMap() {
    const turns = document.querySelectorAll<HTMLButtonElement>('.turn');
    const fields = {
      no: document.querySelector<HTMLElement>('[data-cap="no"]'),
      place: document.querySelector<HTMLElement>('[data-cap="place"]'),
      when: document.querySelector<HTMLElement>('[data-cap="when"]'),
      what: document.querySelector<HTMLElement>('[data-cap="what"]')
    };

    const select = (turn: HTMLButtonElement) => {
      turns.forEach((t) => t.setAttribute('aria-pressed', String(t === turn)));
      (Object.keys(fields) as (keyof typeof fields)[]).forEach((key) => {
        const el = fields[key];
        if (el) el.textContent = turn.dataset[key] ?? '';
      });
    };

    turns.forEach((turn) => {
      turn.addEventListener('mouseenter', () => select(turn));
      turn.addEventListener('focus', () => select(turn));
      turn.addEventListener('click', () => select(turn));
    });
  }

  document.addEventListener('astro:page-load', initLapMap);
</script>
