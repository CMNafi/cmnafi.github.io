---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HistoryMap from '@/components/telemetry/HistoryMap.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('field-notes')).filter(n => !n.data.draft && n.data.category !== 'Brewing').sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,3);
---
<BaseLayout title="Home" description="C M Nafi on technology history, engineering, and finance. Follow the connections between people, companies, and products." canonical="/">
  <div class="home-shell">
    <section class="intro"><span class="eyebrow">C M NAFI / NOTES FROM A CURIOUS MIND</span><h1>Building systems.<br />Following <em>their stories.</em></h1><div class="intro-bottom"><p>I’m a solutions engineer interested in technology, finance, and how things came to be. This is where I share what I build, what I read, and the connections I find along the way.</p><a class="text-link" href="/story/">A little about me ↗</a></div></section>
    <section class="history-feature" aria-labelledby="history-heading"><div class="section-heading"><div><span class="eyebrow">A NEW THREAD / TECHNOLOGY HISTORY</span><h2 id="history-heading">Ideas have ancestors.</h2></div><p>Behind every product is a network of people, companies, and earlier ideas. Follow a connection. Find the next story.</p></div><HistoryMap /><div class="feature-footer"><span>An evolving atlas. The first essays are on their way.</span><a class="text-link" href="/technology-history/">Explore technology history →</a></div></section>
    <section class="writing" aria-labelledby="writing-heading"><div class="section-heading"><div><span class="eyebrow">FROM THE NOTEBOOK</span><h2 id="writing-heading">Recent writing</h2></div><a class="text-link" href="/field-notes/">All field notes →</a></div><div class="note-grid">{notes.map(note=><article><span class="eyebrow muted">{note.data.category} / {note.data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span><h3><a href={`/field-notes/${note.slug}/`}>{note.data.title}</a></h3><p>{note.data.excerpt}</p><a class="text-link" href={`/field-notes/${note.slug}/`}>Read the essay ↗</a></article>)}</div></section>
    <aside class="explore"><div><span class="eyebrow">THE REST OF THE WORKSHOP</span><h2>Tools, experiments,<br />and other rabbit holes.</h2></div><div><p>A collection of projects and side interests, always taking shape.</p><a class="text-link" href="/garage/">Step into the Garage →</a></div></aside>
  </div>
</BaseLayout>
<style>
  .home-shell{max-width:1120px;margin:auto;padding:65px 24px 90px}.eyebrow{font:10px var(--font-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.muted{color:var(--ink-secondary)}h1{font:400 clamp(48px,7.5vw,94px)/1.06 var(--font-serif);letter-spacing:-.05em;margin:28px 0 36px}h1 em{color:var(--accent);font-weight:400}.intro-bottom{display:flex;align-items:center;justify-content:space-between;gap:40px}.intro-bottom p{max-width:660px;font-size:19px;line-height:1.8;color:var(--ink-secondary);margin:0}.text-link{font:12px/1.8 var(--font-mono);color:var(--accent)}.intro{padding-bottom:75px;border-bottom:1px solid var(--surface-line)}.history-feature,.writing{margin-top:70px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:45px;margin-bottom:30px}h2{font:400 clamp(30px,4vw,46px)/1.15 var(--font-serif);letter-spacing:-.04em;margin:16px 0 0}.section-heading p{max-width:370px;line-height:1.8;color:var(--ink-secondary);font-size:15px;margin:0}.feature-footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:22px;color:var(--ink-secondary);font-size:13px}.note-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.note-grid article{border-top:1px solid var(--surface-line);padding-top:24px;display:flex;flex-direction:column}h3{font:400 26px/1.3 var(--font-serif);margin:18px 0}.note-grid p{font-size:14px;line-height:1.8;color:var(--ink-secondary);margin:0 0 25px}.note-grid .text-link{margin-top:auto}.explore{display:grid;grid-template-columns:1fr 1fr;gap:60px;border-top:1px solid var(--surface-line);margin-top:80px;padding-top:40px}.explore p{color:var(--ink-secondary);line-height:1.8}@media(max-width:700px){.home-shell{padding:36px 20px 65px}.intro-bottom,.section-heading{display:block}.intro-bottom .text-link{display:inline-block;margin-top:20px}.intro{padding-bottom:45px}.history-feature,.writing{margin-top:45px}.section-heading p,.section-heading>.text-link{display:block;margin-top:20px}.note-grid,.explore{grid-template-columns:1fr}.note-grid{gap:35px}.explore{gap:15px;margin-top:50px}}
</style>
