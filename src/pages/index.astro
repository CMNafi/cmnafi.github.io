<script>
  function setupHomepage() {
    // 1. Lap map interaction
    const turns = document.querySelectorAll<HTMLButtonElement>('.turn');
    const fields = {
      no: document.querySelector<HTMLElement>('[data-cap="no"]'),
      place: document.querySelector<HTMLElement>('[data-cap="place"]'),
      when: document.querySelector<HTMLElement>('[data-cap="when"]'),
      what: document.querySelector<HTMLElement>('[data-cap="what"]')
    };

    const select = (turn: HTMLButtonElement) => {
      turns.forEach((t) => t.setAttribute('aria-pressed', String(t === turn)));
      (Object.keys(fields) as (keyof typeof fields)[]).forEach((key) => {
        const el = fields[key];
        if (el) el.textContent = turn.dataset[key] ?? '';
      });
    };

    turns.forEach((turn) => {
      turn.addEventListener('mouseenter', () => select(turn));
      turn.addEventListener('focus', () => select(turn));
      turn.addEventListener('click', () => select(turn));
    });

    // 2. Back to top button
    const backToTopBtn = document.getElementById('back-to-top');
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          backToTopBtn.classList.add('is-visible');
        } else {
          backToTopBtn.classList.remove('is-visible');
        }
      }, { passive: true });

      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 3. Cmd+K Search Modal
    const searchModal = document.getElementById('cmd-k-modal') as HTMLDialogElement | null;
    const searchTrigger = document.getElementById('cmd-k-trigger');
    const searchClose = document.getElementById('cmd-k-close');
    const searchBackdrop = document.getElementById('modal-backdrop');
    const searchInput = document.getElementById('cmd-k-input') as HTMLInputElement | null;
    const searchResults = document.getElementById('search-results-list');
    const searchDataScript = document.getElementById('search-notes-data');

    let allNotes: Array<{ title: string; slug: string; category: string; excerpt: string; readingTime: string }> = [];
    if (searchDataScript && searchDataScript.textContent) {
      try {
        allNotes = JSON.parse(searchDataScript.textContent);
      } catch (e) {
        console.error('Failed to parse search notes payload', e);
      }
    }

    function openSearch() {
      if (!searchModal) return;
      searchModal.showModal();
      document.body.style.overflow = 'hidden';
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        renderResults('');
      }
    }

    function closeSearch() {
      if (!searchModal) return;
      searchModal.close();
      document.body.style.overflow = '';
    }

    function renderResults(query: string) {
      if (!searchResults) return;
      const cleanQ = query.trim().toLowerCase();
      const filtered = cleanQ === ''
        ? allNotes.slice(0, 6)
        : allNotes.filter((n) =>
            n.title.toLowerCase().includes(cleanQ) ||
            n.category.toLowerCase().includes(cleanQ) ||
            n.excerpt.toLowerCase().includes(cleanQ)
          ).slice(0, 10);

      if (filtered.length === 0) {
        searchResults.innerHTML = `<div class="search-empty">No notes found for "${query}". Try searching for BlackRock, VC, cricket, or portfolio.</div>`;
        return;
      }

      searchResults.innerHTML = filtered.map((item, idx) => `
        <a href="/field-notes/${item.slug}" class="search-item ${idx === 0 ? 'is-selected' : ''}" role="option" tabindex="0">
          <div class="search-item-top">
            <span class="search-item-title">${item.title}</span>
            <span class="search-item-badge">${item.category}</span>
          </div>
          ${item.excerpt ? `<div class="search-item-desc">${item.excerpt}</div>` : ''}
        </a>
      `).join('');
    }

    if (searchTrigger) {
      searchTrigger.addEventListener('click', openSearch);
    }

    if (searchClose) {
      searchClose.addEventListener('click', closeSearch);
    }

    if (searchBackdrop) {
      searchBackdrop.addEventListener('click', closeSearch);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        renderResults((e.target as HTMLInputElement).value);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (!searchResults) return;
        const items = Array.from(searchResults.querySelectorAll<HTMLAnchorElement>('.search-item'));
        const activeIndex = items.findIndex((el) => el.classList.contains('is-selected'));

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const nextIndex = (activeIndex + 1) % items.length;
          items.forEach((it, i) => it.classList.toggle('is-selected', i === nextIndex));
          items[nextIndex]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prevIndex = (activeIndex - 1 + items.length) % items.length;
          items.forEach((it, i) => it.classList.toggle('is-selected', i === prevIndex));
          items[prevIndex]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter') {
          if (activeIndex >= 0 && items[activeIndex]) {
            e.preventDefault();
            items[activeIndex].click();
          }
        }
      });
    }

    // Global keyboard listener for Cmd+K and Ctrl+K
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (searchModal?.open) {
          closeSearch();
        } else {
          openSearch();
        }
      } else if (e.key === 'Escape' && searchModal?.open) {
        closeSearch();
      }
    });
  }

  document.addEventListener('astro:page-load', setupHomepage);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupHomepage();
  }
</script>
