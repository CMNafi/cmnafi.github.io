---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Copy follows STORY.md. Ground truth: Nafi, Land O' Lakes, Florida, Solutions Engineer at Dasseti.
// Layout rule for this page: one idea above the fold, then a quiet index. Resist adding sections.

const notes = (await getCollection('field-notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latestNotes = notes.slice(0, 5);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.status === 'live')
  .sort((a, b) => b.data.priority - a.data.priority)
  .slice(0, 3);

// One-line descriptions for the homepage list; anything not listed falls back to the project summary
const taglines: Record<string, string> = {
  worldview: 'An atlas of everyday choices, and the evidence behind them.',
  'form-adv-data-finder': "An investment adviser's filings, joined into one profile.",
  'style-fielding': 'Cricket fielding plans for every phase of a match.',
  'captains-view': 'A tactical cricket fielding planner.'
};

const building = [
  ...projects.map((p) => ({
    title: p.data.title,
    line: taglines[p.slug] ?? p.data.summary,
    href: p.data.liveUrl ?? `/garage/${p.slug}`
  })),
  { title: 'CAIA Corner', line: 'A study hub for alternative investments.', href: '/caia' }
];

const route = ['Dinajpur', 'Rangpur', 'Changshu', 'Decorah', 'Rochester', 'Wilmington', "Land O' Lakes"];

const nav = [
  { label: 'Field Notes', href: '/field-notes' },
  { label: 'Garage', href: '/garage' },
  { label: 'Play', href: '/play' },
  { label: 'Story', href: '/story' },
  { label: 'Connect', href: '/connect' }
];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });

// Search dataset for the Cmd+K dialog
const searchPayload = notes.map((n) => ({
  title: n.data.title,
  slug: n.slug,
  category: n.data.category,
  excerpt: n.data.excerpt || n.data.description || ''
}));
---

<BaseLayout
  title="C M Nafi"
  description="Solutions Engineer at Dasseti, living in Land O' Lakes, Florida. I grew up in Dinajpur, Bangladesh, left home at twelve, and translate between investment teams and software."
  hideHeader={true}
>
  <div class="home">
    <header class="top wrap">
      <a class="wordmark" href="/">C M Nafi</a>
      <nav class="top-nav" aria-label="Primary">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <button type="button" id="cmd-k-trigger" class="search-btn" aria-label="Search field notes (Ctrl or Command + K)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </button>
    </header>

    <section class="intro wrap-narrow" aria-labelledby="intro-title">
      <h1 id="intro-title" class="intro-title">
        <span class="rise">Learn the room.</span>
        <span class="rise" style="animation-delay: 0.12s">Then <em>translate.</em></span>
      </h1>

      <p class="intro-lede rise" style="animation-delay: 0.3s">
        I'm Nafi, a solutions engineer at Dasseti. I left home at twelve for military school in Bangladesh and have
        been the newest person in the room ever since. These days I live in Florida and translate between investment
        teams and the software they run due diligence on.
      </p>

      <p class="route rise" style="animation-delay: 0.4s">
        {route.map((place, i) => (
          <>
            <span>{place}</span>
            {i < route.length - 1 && <span class="route-sep" aria-hidden="true">→</span>}
          </>
        ))}
      </p>

      <div class="intro-actions rise" style="animation-delay: 0.5s">
        <a class="btn" href="/story">Read the story <span class="arr" aria-hidden="true">→</span></a>
        <a class="quiet-link" href="/field-notes">Field notes <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </section>

    <div class="index wrap-narrow">
      <section class="block" aria-labelledby="writing-title">
        <h2 id="writing-title" class="block-label">Writing</h2>
        <div class="block-body">
          <ul class="list">
            {latestNotes.map((n) => (
              <li>
                <a class="item" href={`/field-notes/${n.slug}`}>
                  <span class="item-date">{formatDate(n.data.publishedAt)}</span>
                  <span class="item-title">{n.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="more" href="/field-notes">All {notes.length} field notes <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="block" aria-labelledby="building-title">
        <h2 id="building-title" class="block-label">Building</h2>
        <div class="block-body">
          <ul class="list">
            {building.map((b) => (
              <li>
                <a class="item item-project" href={b.href}>
                  <span class="item-title">{b.title}</span>
                  <span class="item-line">{b.line}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="more" href="/garage">The whole garage <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="block" aria-labelledby="hello-title">
        <h2 id="hello-title" class="block-label">Say hello</h2>
        <div class="block-body">
          <p class="hello">
            Happy to talk about due diligence, allocator workflows, or a close finish in cricket.
            <a href="mailto:nafi@cmnafi.com">nafi@cmnafi.com</a>
          </p>
        </div>
      </section>
    </div>

    <dialog id="cmd-k-modal" class="search-modal" aria-label="Search field notes">
      <div class="search-box">
        <div class="search-head">
          <input
            type="search"
            id="cmd-k-input"
            class="search-field"
            placeholder="Search field notes"
            aria-label="Search field notes"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" id="cmd-k-close" class="search-close" aria-label="Close search">Esc</button>
        </div>
        <div id="search-results-list" class="search-results" role="listbox" aria-label="Results"></div>
      </div>
    </dialog>

    <script id="search-notes-data" type="application/json" set:html={JSON.stringify(searchPayload)}></script>
  </div>
</BaseLayout>

<style>
  .home {
    --ink-quiet: #8f8475;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--surface-base);
    color: var(--ink-primary);
    font-family: var(--font-serif);
  }

  .wrap,
  .wrap-narrow {
    margin: 0 auto;
    box-sizing: border-box;
    padding-left: clamp(16px, 5vw, 48px);
    padding-right: clamp(16px, 5vw, 48px);
  }

  .wrap { max-width: 1200px; }
  .wrap-narrow { max-width: 1040px; }

  .home a { color: var(--ink-primary); text-decoration: none; }

  .home :is(a, button):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Header */
  .top {
    display: flex;
    align-items: center;
    gap: 8px 28px;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .wordmark { font-size: 20px; letter-spacing: -0.01em; margin-right: auto; }

  .top-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px; }

  .top-nav a,
  .block-label,
  .item-date,
  .route,
  .btn,
  .quiet-link,
  .more {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .top-nav a {
    color: var(--ink-secondary) !important;
    padding: 10px 0;
    transition: color var(--dur-fast);
  }

  .top-nav a:hover { color: var(--ink-primary) !important; }

  .search-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-left: -8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: color var(--dur-fast);
  }

  .search-btn:hover { color: var(--ink-primary); }

  /* Hero */
  .intro {
    padding-top: clamp(56px, 12vh, 140px);
    padding-bottom: clamp(72px, 12vh, 140px);
  }

  .intro-title {
    margin: 0 0 clamp(28px, 4vw, 44px);
    font-size: clamp(46px, 8vw, 104px);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .intro-title span { display: block; }
  .intro-title em { font-style: italic; color: var(--accent); padding-right: 0.04em; }

  .intro-lede {
    margin: 0 0 28px;
    max-width: 34em;
    font-size: clamp(19px, 1.9vw, 23px);
    line-height: 1.55;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .route {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0 0 40px;
    font-size: 11px;
    color: var(--ink-quiet);
  }

  .route-sep { color: var(--ink-tertiary); }

  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 24px;
    border-radius: 2px;
    background: var(--ink-primary);
    color: var(--surface-base) !important;
    font-weight: 500;
    transition: background var(--dur-fast);
  }

  .btn:hover { background: #ffffff; }

  .quiet-link { color: var(--ink-secondary) !important; transition: color var(--dur-fast); }
  .quiet-link:hover { color: var(--ink-primary) !important; }

  .arr { display: inline-block; transition: transform 0.3s var(--ease); }
  .btn:hover .arr,
  .quiet-link:hover .arr,
  .more:hover .arr { transform: translateX(5px); }

  /* Index: label column + content column */
  .index { padding-bottom: clamp(72px, 10vh, 120px); }

  .block {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 16px 40px;
    padding: 40px 0;
    border-top: 1px solid var(--surface-line);
  }

  .block-label { margin: 0; padding-top: 6px; font-weight: 400; color: var(--ink-quiet); }

  .list { list-style: none; margin: 0; padding: 0; }

  .item {
    display: flex;
    align-items: baseline;
    gap: 6px 28px;
    padding: 12px 0;
  }

  .item-date { flex: 0 0 120px; font-size: 11px; color: var(--ink-quiet); }

  .item-title {
    font-size: clamp(19px, 1.8vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color var(--dur-fast);
  }

  .item:hover .item-title { color: var(--accent); }

  .item-project { flex-direction: column; gap: 4px; }
  .item-line { font-size: 16px; line-height: 1.5; color: var(--ink-secondary); }

  .more {
    display: inline-flex;
    gap: 10px;
    margin-top: 16px;
    font-size: 11px;
    color: var(--ink-secondary) !important;
    transition: color var(--dur-fast);
  }

  .more:hover { color: var(--ink-primary) !important; }

  .hello { margin: 0; max-width: 34em; font-size: 20px; line-height: 1.55; color: var(--ink-secondary); }

  .hello a {
    display: inline-block;
    color: var(--ink-primary);
    text-decoration: underline !important;
    text-decoration-color: var(--accent) !important;
    text-underline-offset: 5px;
  }


  /* Search dialog */
  .search-modal {
    width: min(600px, calc(100vw - 32px));
    margin: clamp(56px, 14vh, 140px) auto auto;
    padding: 0;
    border: 1px solid var(--surface-line);
    border-radius: 6px;
    background: var(--surface-raised);
    color: var(--ink-primary);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);
  }

  .search-modal::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(6px); }

  .search-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--surface-line);
  }

  .search-field {
    flex: 1;
    border: 0;
    outline: none;
    background: none;
    color: var(--ink-primary);
    font-family: var(--font-serif);
    font-size: 18px;
  }

  .search-field::placeholder { color: var(--ink-quiet); }

  .search-close {
    border: 1px solid var(--surface-line);
    border-radius: 3px;
    padding: 2px 6px;
    background: none;
    color: var(--ink-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    cursor: pointer;
  }

  .search-results { max-height: min(420px, 60vh); overflow-y: auto; padding: 8px; }

  .search-results :global(.search-item) {
    display: block;
    padding: 10px 12px;
    border-radius: 4px;
    color: var(--ink-primary);
    text-decoration: none;
  }

  .search-results :global(.search-item:hover),
  .search-results :global(.search-item.is-selected) { background: var(--accent-dim); }

  .search-results :global(.search-item-title) { display: block; font-size: 16px; }

  .search-results :global(.search-item-meta) {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }

  .search-results :global(.search-empty) { padding: 32px 12px; text-align: center; color: var(--ink-quiet); }

  /* Motion */
  .rise { animation: rise 0.9s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  /* Small screens: nav drops to its own row, search stays beside the name */
  @media (max-width: 640px) {
    .top { display: grid; grid-template-columns: 1fr auto; padding-bottom: 12px; }
    .search-btn { margin-left: 0; margin-right: -8px; }
    .top-nav { grid-column: 1 / -1; grid-row: 2; gap: 4px 22px; }
  }

  /* Small screens: labels sit above their lists */
  @media (max-width: 720px) {
    .block { grid-template-columns: minmax(0, 1fr); padding: 32px 0; }
    .block-label { padding-top: 0; }
    .item { flex-wrap: wrap; }
    .item-date { flex-basis: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
  }
</style>

<script>
  type Note = { title: string; slug: string; category: string; excerpt: string };

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  let shortcutBound = false;

  function setupSearch() {
    const modal = document.getElementById('cmd-k-modal') as HTMLDialogElement | null;
    const trigger = document.getElementById('cmd-k-trigger');
    const close = document.getElementById('cmd-k-close');
    const input = document.getElementById('cmd-k-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results-list');
    const data = document.getElementById('search-notes-data');
    if (!modal || !input || !results || modal.dataset.ready) return;
    modal.dataset.ready = 'true';

    let notes: Note[] = [];
    try {
      notes = JSON.parse(data?.textContent || '[]');
    } catch {
      notes = [];
    }

    const render = (query: string) => {
      const q = query.trim().toLowerCase();
      const found = q
        ? notes.filter((n) => `${n.title} ${n.category} ${n.excerpt}`.toLowerCase().includes(q)).slice(0, 8)
        : notes.slice(0, 6);

      results.innerHTML = found.length
        ? found
            .map(
              (n, i) =>
                `<a href="/field-notes/${n.slug}" class="search-item${i === 0 ? ' is-selected' : ''}" role="option">` +
                `<span class="search-item-title">${escapeHtml(n.title)}</span>` +
                `<span class="search-item-meta">${escapeHtml(n.category)}</span></a>`
            )
            .join('')
        : `<div class="search-empty">Nothing for “${escapeHtml(query)}”.</div>`;
    };

    const open = () => {
      input.value = '';
      render('');
      modal.showModal();
      input.focus();
    };

    trigger?.addEventListener('click', open);
    close?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close(); // click on the backdrop
    });

    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (e) => {
      const items = Array.from(results.querySelectorAll<HTMLAnchorElement>('.search-item'));
      if (!items.length) return;
      const current = items.findIndex((el) => el.classList.contains('is-selected'));
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const next = (current + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
        items.forEach((el, i) => el.classList.toggle('is-selected', i === next));
        items[next].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && current >= 0) {
        e.preventDefault();
        items[current].click();
      }
    });

    // One global shortcut listener for the whole session, even across page transitions
    if (!shortcutBound) {
      shortcutBound = true;
      window.addEventListener('keydown', (e) => {
        if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
        const dialog = document.getElementById('cmd-k-modal') as HTMLDialogElement | null;
        const opener = document.getElementById('cmd-k-trigger');
        if (!dialog || !opener) return;
        e.preventDefault();
        if (dialog.open) dialog.close();
        else opener.click();
      });
    }
  }

  document.addEventListener('astro:page-load', setupSearch);
</script>
