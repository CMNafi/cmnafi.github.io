---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LapTimer from '@/components/telemetry/LapTimer.astro';
import { getCollection } from 'astro:content';

// Copy on this page follows STORY.md. Ground truth: Nafi, Land O' Lakes, Florida, Solutions Engineer at Dasseti.

const notes = (await getCollection('field-notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [leadNote, ...olderNotes] = notes;
const recentNotes = olderNotes.slice(0, 5);

const projects = (await getCollection('projects')).sort((a, b) => b.data.priority - a.data.priority);
const liveProjects = projects.filter((p) => p.data.status === 'live');
const tileProjects = liveProjects.slice(0, 3);
const alsoLive = liveProjects.slice(3);
const brewing = projects.filter(
  (p) => p.data.status === 'brewing' && !['homepage', 'more-tools-brewing'].includes(p.slug)
);
const projectHref = (p: (typeof projects)[number]) =>
  p.data.status === 'live' && p.data.liveUrl ? p.data.liveUrl : `/garage/${p.slug}`;

const nav = [
  { label: 'Journey', href: '#journey' },
  { label: 'Start Here', href: '#start-here' },
  { label: 'Field Notes', href: '#field-notes' },
  { label: 'Garage', href: '#garage' },
  { label: 'Story', href: '/story' },
  { label: 'Sitemap', href: '/sitemap' },
  { label: 'Connect', href: '/connect' }
];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
const shortRead = (rt: string) => rt.replace(/\s*read$/i, '');

// One lap of the story. Positions are % of the track box (viewBox 50 20 1040 548).
const turns = [
  { no: '01', name: 'Dinajpur', place: 'Dinajpur, Bangladesh', when: 'Childhood', x: 5.58, y: 87.23, side: 'below',
    what: 'A house where reading was the default answer to boredom. The one room where I was never new.' },
  { no: '02', name: 'Rangpur', place: 'Rangpur, Bangladesh', when: 'Age 12', x: 5.19, y: 62.04, side: 'right',
    what: 'Left home for military school. Sixty-six kilometres away, and a very long way from home.' },
  { no: '03', name: 'Changshu', place: 'Changshu, China', when: '2016 · Age 16', x: 16.92, y: 14.6, side: 'above',
    what: 'UWC on a full scholarship. A new country, a language I didn’t speak, classmates from 100+ countries.' },
  { no: '04', name: 'Decorah', place: 'Decorah, Iowa', when: 'Aug 2018 to May 2022', x: 61.54, y: 8.76, side: 'above',
    what: 'Data Science at Luther College (GPA 3.5). Applied to Blackstone; the interview invitation said BlackRock.' },
  { no: '05', name: 'Rochester', place: 'Rochester, Minnesota', when: '2021 to 2022', x: 64.04, y: 33.58, side: 'left',
    what: 'Mayo Clinic, as an AI intern. Messy clinical data, and my first job that was mostly translation.' },
  { no: '06', name: 'Wilmington', place: 'Wilmington, Delaware', when: '2022 to 2023', x: 80.96, y: 49.64, side: 'left',
    what: 'BlackRock, after SkyBridge. A trillion dollars is a spreadsheet problem, a risk problem and a storytelling problem.' },
  { no: '07', name: "Land O' Lakes", place: 'Florida', when: 'Now', x: 51.92, y: 78.83, side: 'right',
    what: 'Solutions engineer at Dasseti, working remotely. Translating between investment teams and their software.' }
];
const currentTurn = turns[turns.length - 1];

const trackPath =
  'M330,520 C310,520 207,524 170,520 C133,516 131,519 108,498 C85,477 83,468 82,440 C81,412 93,389 104,360 C115,331 170,193 190,150 C210,107 205,115 226,100 C247,85 247,87 286,82 C325,77 442,73 460,72 C478,71 609,61 640,60 C671,59 672,55 690,68 C708,81 707,83 708,108 C709,133 692,134 694,160 C696,186 696,189 716,204 C736,219 750,215 770,218 C790,221 818,217 836,222 C854,227 865,232 876,246 C887,260 894,265 892,292 C890,319 889,321 870,336 C851,351 848,350 820,350 C792,350 726,341 700,338 C674,335 651,327 628,330 C605,333 599,333 584,352 C569,371 571,377 572,400 C573,423 587,426 590,452 C593,478 595,478 582,496 C569,514 562,513 540,518 C518,523 491,520 470,520 C449,520 350,520 330,520Z';

// Search dataset for Cmd+K search dialog
const searchPayload = notes.map((n) => ({
  title: n.data.title,
  slug: n.slug,
  category: n.data.category,
  excerpt: n.data.excerpt || n.data.description || '',
  readingTime: shortRead(n.data.readingTime || '5 min')
}));
---

<BaseLayout
  title="C M Nafi"
  description="Solutions Engineer at Dasseti, living in Land O' Lakes, Florida. I grew up in Dinajpur, Bangladesh, left home at twelve, and translate between investment teams and software."
  hideHeader={true}
>
  <div id="top" class="home">
    <!-- Sticky minimal navigation with smooth scroll anchors and Cmd+K search trigger -->
    <header class="home-sticky-header">
      <div class="wrap nav-inner">
        <a class="wordmark" href="#top" aria-label="C M Nafi Home">C M Nafi</a>
        
        <nav class="home-nav" aria-label="Primary Navigation">
          {nav.map((item) => (
            <a class="nav-link" href={item.href}>{item.label}</a>
          ))}
        </nav>

        <div class="nav-actions">
          <button
            type="button"
            id="cmd-k-trigger"
            class="cmd-k-btn"
            aria-label="Open search dialog (Press Command plus K)"
          >
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="cmd-k-text">Search</span>
            <kbd class="kbd-pill">⌘K</kbd>
          </button>

          <div class="lap" aria-hidden="true">
            <span class="pulse-dot"></span>
            <LapTimer id="home-lap-timer" isLive={true} />
          </div>
        </div>
      </div>
    </header>

    <!-- Hero / Opening section -->
    <section class="opening wrap" aria-labelledby="opening-title">
      <h1 id="opening-title" class="opening-title">
        <span class="rise" style="animation-delay: 0.05s">Learn the room.</span>
        <span class="rise" style="animation-delay: 0.18s">Then <em>translate.</em></span>
      </h1>

      <div class="opening-copy">
        <p class="opening-lede rise" style="animation-delay: 0.35s">
          I'm Nafi. I grew up in Dinajpur, Bangladesh, left home at twelve for military school, and have been learning new rooms ever since. Today I live in Land O' Lakes, Florida and work remotely as a Solutions Engineer at <a href="/story#dasseti">Dasseti</a>, translating between investment teams and their due-diligence software.
        </p>
        <p class="opening-quiet rise" style="animation-delay: 0.45s">
          Before that: BlackRock, SkyBridge, Mayo Clinic. Studied Data Science at Luther College (GPA 3.5). On this site I write about how capital moves, build small tools I wanted, and write up match notes from Florida cricket.
        </p>
        <div class="opening-actions rise" style="animation-delay: 0.55s">
          <a class="btn" href="#start-here">Start here <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
          <a class="txt-link" href="/story">Read the story <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
          <a class="txt-link" href="#field-notes">Field notes <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
        </div>
      </div>

      <!-- Dinajpur to Florida Journey Visual -->
      <figure id="journey" class="lap-map" aria-labelledby="lap-caption-title">
        <div class="lap-head">
          <span id="lap-caption-title">One lap · Dinajpur to Florida</span>
          <span>16,240 km · seven stops</span>
        </div>

        <div class="track-box">
          <svg viewBox="50 20 1040 548" aria-hidden="true" class="track-svg">
            <path d={trackPath} class="track-bed"></path>
            <path d={trackPath} class="track-line"></path>
            <line x1="330" y1="505" x2="330" y2="535" class="start-line"></line>
            <g class="lap-dot" style={`offset-path: path('${trackPath}')`}>
              <circle cx="0" cy="0" r="17" class="lap-dot-halo"></circle>
              <circle cx="0" cy="0" r="6.5" class="lap-dot-core"></circle>
            </g>
          </svg>

          <span class="sf-label" aria-hidden="true">S/F</span>

          {turns.map((t, i) => (
            <button
              type="button"
              class:list={['turn', 'rise', `label-${t.side}`, { 'is-current': t === currentTurn }]}
              style={`left: ${t.x}%; top: ${t.y}%; animation-delay: ${1.0 + i * 0.1}s`}
              aria-label={`Stop ${t.no}, ${t.place}`}
              aria-pressed={t === currentTurn ? 'true' : 'false'}
              data-no={t.no}
              data-place={t.place}
              data-when={t.when}
              data-what={t.what}
            >
              <span class="ring"></span>
              <span class="turn-label">{t.no} <span class="turn-name">{t.name}</span></span>
            </button>
          ))}
        </div>

        <figcaption class="lap-caption" aria-live="polite">
          <span class="cap-no">Stop <span data-cap="no">{currentTurn.no}</span> of 07</span>
          <span class="cap-place" data-cap="place">{currentTurn.place}</span>
          <span class="cap-when" data-cap="when">{currentTurn.when}</span>
          <span class="cap-what" data-cap="what">{currentTurn.what}</span>
        </figcaption>
      </figure>
    </section>

    <!-- Start Here: Guided Onboarding Path for First-Time Visitors -->
    <section id="start-here" class="sector wrap start-here-section" aria-labelledby="start-here-title">
      <div class="sector-head">
        <div class="sector-name">
          <span class="sector-no">Start Here</span>
          <h2 id="start-here-title">Orientation</h2>
        </div>
        <span>First time visiting? Three ways in</span>
      </div>

      <p class="sector-intro">
        If you are new here, these three paths give you the clearest sense of how I think and what I build.
      </p>

      <div class="start-grid">
        <a class="start-card" href="/story">
          <div class="start-badge">01 · The Narrative</div>
          <h3 class="start-title">The newest person in the room</h3>
          <p class="start-desc">
            Nine chapters across Bangladesh, China, Iowa, Delaware, and Florida. Leaving home at twelve, learning to listen before speaking, and turning translation into a career.
          </p>
          <span class="start-link">Read the story <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>

        <a class="start-card" href="/field-notes/blackstone-vs-blackrock">
          <div class="start-badge">02 · The Flagship Essay</div>
          <h3 class="start-title">Blackstone vs. BlackRock</h3>
          <p class="start-desc">
            A job application mix-up in Iowa that opened up modern finance: how two titans with nearly identical roots evolved into completely different market powerhouses.
          </p>
          <span class="start-link">Read the note <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>

        <a class="start-card" href="/caia">
          <div class="start-badge">03 · The Study Hub</div>
          <h3 class="start-title">CAIA Corner & Garage Tools</h3>
          <p class="start-desc">
            An open study curriculum for alternative investments, alongside interactive regulatory data extractors and tactical cricket simulators built to solve real gaps.
          </p>
          <span class="start-link">Explore the tools <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>
      </div>
    </section>

    <!-- Sector 1: Field Notes -->
    {leadNote && (
      <section id="field-notes" class="sector wrap" aria-labelledby="notes-title">
        <div class="sector-head">
          <div class="sector-name">
            <span class="sector-no">Sector 1</span>
            <h2 id="notes-title">Field Notes</h2>
          </div>
          <span>{notes.length} published essays</span>
        </div>

        <p class="sector-intro">Every big number has a story behind it. These are the ones I went and found.</p>

        <a class="feature" href={`/field-notes/${leadNote.slug}`}>
          <span class="meta">Latest · {leadNote.data.category} · {shortRead(leadNote.data.readingTime)} · {formatDate(leadNote.data.publishedAt)}</span>
          <h3 class="feature-title">{leadNote.data.title}</h3>
          <p class="feature-excerpt">{leadNote.data.excerpt || leadNote.data.description}</p>
          <span class="read-link">Read the note <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>

        <div class="rows">
          {recentNotes.map((n) => (
            <a class="row" href={`/field-notes/${n.slug}`}>
              <span class="row-date">{formatDate(n.data.publishedAt)}</span>
              <span class="row-title">{n.data.title}</span>
              <span class="row-meta">
                <span>{n.data.category}</span>
                <span>{shortRead(n.data.readingTime)}</span>
                <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg>
              </span>
            </a>
          ))}
        </div>

        <a class="txt-link more" href="/field-notes">All {notes.length} field notes <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
      </section>
    )}

    <!-- Sector 2: Garage -->
    <section id="garage" class="sector wrap" aria-labelledby="garage-title">
      <div class="sector-head">
        <div class="sector-name">
          <span class="sector-no">Sector 2</span>
          <h2 id="garage-title">Garage</h2>
        </div>
        <span>Tools I wanted, so I built them</span>
      </div>

      <p class="sector-intro">
        I am not a software engineer. I build these tools the same way I do the day job: describe exactly what should exist, then keep going until it does.
      </p>

      <div class="tiles">
        {tileProjects.map((p) => (
          <a class="tile" href={projectHref(p)}>
            <span class="tile-meta"><span class="dot live"></span><span class="tile-status">Live</span><span>{p.data.category}</span></span>
            <h3 class="tile-title">{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <span class="read-link">Open <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
          </a>
        ))}
        <a class="tile" href="/caia">
          <span class="tile-meta"><span class="dot live"></span><span class="tile-status">Live</span><span>Study hub</span></span>
          <h3 class="tile-title">CAIA Corner</h3>
          <p>An exam-aligned study hub for alternative investments: hedge funds, private equity, private debt and real assets.</p>
          <span class="read-link">Open <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></span>
        </a>
      </div>

      {(alsoLive.length > 0 || brewing.length > 0) && (
        <div class="also">
          <span class="also-label">Also in the garage</span>
          {alsoLive.length > 0 && (
            <span class="also-item"><span class="dot live"></span>Live: {alsoLive.map((p) => p.data.title).join(', ')}</span>
          )}
          {brewing.length > 0 && (
            <span class="also-item"><span class="dot brewing"></span>Brewing: {brewing.map((p) => p.data.title).join(', ')}</span>
          )}
        </div>
      )}

      <a class="txt-link more" href="/garage">The whole garage <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
    </section>

    <!-- Sector 3: Story -->
    <section id="story" class="sector wrap" aria-labelledby="story-title">
      <div class="sector-head">
        <div class="sector-name">
          <span class="sector-no">Sector 3</span>
          <h2 id="story-title">Story</h2>
        </div>
        <span>Bangladesh · China · United States</span>
      </div>

      <p class="story-para">
        Grew up in <em>Dinajpur</em>. Left home at twelve for military school in <em>Rangpur</em>, and at sixteen for
        <em>Changshu</em>, on a full scholarship, without the language. Studied data science in <em>Decorah</em>, a town
        of eight thousand. Learned at <em>BlackRock</em> that a trillion dollars is a storytelling problem. Now in
        <em>Land O' Lakes, Florida</em>, translating for a living.
      </p>

      <a class="txt-link more" href="/story">Read all nine chapters <svg class="arr" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg></a>
    </section>

    <!-- Contact & Footer -->
    <section id="contact" class="hello wrap" aria-labelledby="hello-title">
      <h2 id="hello-title" class="hello-label">Open to conversations</h2>
      <a class="hello-email" href="mailto:nafi@cmnafi.com">nafi@cmnafi.com</a>
      <p class="hello-note">
        Especially about due diligence, allocator workflows, and how investment teams actually adopt software.
      </p>
      <div class="hello-links">
        <a class="nav-link" href="https://www.linkedin.com/in/cm-nafi/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class="nav-link" href="https://github.com/CMNafi" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="nav-link" href="/connect">Connect</a>
        <a class="nav-link" href="/sitemap">Sitemap</a>
      </div>
    </section>

    <!-- Floating Back to Top Button -->
    <button id="back-to-top" class="back-to-top" aria-label="Back to top of page" title="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
      <span class="sr-only">Back to top</span>
    </button>

    <!-- Cmd+K Search Modal Dialog -->
    <dialog id="cmd-k-modal" class="search-modal" aria-labelledby="modal-search-label">
      <div class="search-modal-backdrop" id="modal-backdrop"></div>
      <div class="search-dialog-box" role="document">
        <div class="search-bar-header">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="cmd-k-input"
            class="search-input"
            placeholder="Search field notes by title, topic, or keyword..."
            aria-label="Search field notes"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" id="cmd-k-close" class="close-btn" aria-label="Close search dialog">
            <kbd class="esc-pill">Esc</kbd>
          </button>
        </div>

        <div id="search-results-list" class="search-results" role="listbox" aria-label="Search suggestions">
          <!-- Filled dynamically by JavaScript -->
        </div>

        <div class="search-modal-footer">
          <span>Navigate with <kbd>↑</kbd> <kbd>↓</kbd></span>
          <span>Open with <kbd>↵</kbd></span>
          <span>Close with <kbd>Esc</kbd></span>
        </div>
      </div>
    </dialog>

    <script id="search-notes-data" type="application/json" set:html={JSON.stringify(searchPayload)}></script>
  </div>
</BaseLayout>

<style>
  html {
    scroll-behavior: smooth;
  }

  .home {
    --ink-quiet: #8f8475;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    container-type: inline-size;
    background: var(--surface-base);
    color: var(--ink-primary);
    font-family: var(--font-serif);
    overflow-x: clip;
    min-height: 100vh;
  }

  .wrap {
    max-width: 1360px;
    margin: 0 auto;
    box-sizing: border-box;
    padding-left: clamp(16px, 4cqw, 56px);
    padding-right: clamp(16px, 4cqw, 56px);
  }

  .home a { color: var(--ink-primary); text-decoration: none; }

  .home :is(a, button):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Shared monospace label voice */
  .home-nav,
  .lap,
  .btn,
  .txt-link,
  .read-link,
  .start-link,
  .lap-head,
  .sf-label,
  .turn-label,
  .cap-no,
  .cap-when,
  .sector-head,
  .meta,
  .row-date,
  .row-meta,
  .tile-meta,
  .start-badge,
  .also,
  .hello-label,
  .hello-links,
  .cmd-k-btn,
  .search-modal-footer {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Sticky Header */
  .home-sticky-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(14, 14, 15, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background var(--dur-fast), border-color var(--dur-fast);
  }

  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .wordmark {
    font-size: 20px;
    letter-spacing: -0.01em;
    font-weight: 400;
  }

  .home-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(14px, 2cqw, 28px);
    font-size: 11px;
  }

  .nav-link {
    color: var(--ink-secondary) !important;
    padding: 8px 0;
    transition: color var(--dur-fast);
  }
  .nav-link:hover { color: var(--ink-primary) !important; }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Cmd+K trigger button */
  .cmd-k-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.04);
