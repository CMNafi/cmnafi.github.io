---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist on cmnafi.com.">
  <div class="s-page">
    <p class="s-eyebrow">404</p>
    <h1 class="s-title">That page <em>isn’t here.</em></h1>
    <p class="s-lede">
      The link may be old, or the page may have moved. Start again from the <a href="/">front page</a>, browse
      the <a href="/field-notes">Field Notes</a>, or see <a href="/fab">everything on one map</a>.
    </p>
  </div>
</BaseLayout>
