---
import {getCollection} from 'astro:content';import CaiaLayout from '@/layouts/CaiaLayout.astro';
const topics=(await getCollection('caia')).sort((a,b)=>a.data.topicNumber-b.data.topicNumber);
---
<CaiaLayout title="CAIA Corner" description="Study notes, formulas, and a glossary for alternative investments."><header class="page-masthead"><span class="eyebrow">Study / Alternative investments</span><h1>CAIA Corner.</h1><p class="lead">A working reference for alternative investment study. Read by topic, revisit the formulas, or look up a term.</p><p class="meta" id="study-progress" aria-live="polite">{topics.length} study chapters · Review history stays in this browser.</p></header>{['I','II'].map(level=><section id={`level-${level}`} class="study-level"><div class="section-rule"><h2>Level {level}</h2><span>{topics.filter(t=>t.data.level===level).length} chapters</span></div>{topics.filter(t=>t.data.level===level).map(t=><a class="study-row" href={`/caia/${t.slug}/`} data-study-topic={t.slug}><span class="meta">{String(t.data.topicNumber).padStart(2,'0')}</span><span>{t.data.title}</span><span aria-hidden="true">→</span></a>)}</section>)}</CaiaLayout>
<style>.study-level{margin:40px 0}.study-row{display:grid;grid-template-columns:30px 1fr 20px;gap:16px;border-top:1px solid var(--surface-line);padding:18px 0;font-size:22px}</style>
<script>function progress(){const rows=[...document.querySelectorAll<HTMLElement>('[data-study-topic]')];if(!rows.length)return;try{const reviewed=rows.filter(r=>localStorage.getItem('caia-lr-'+r.dataset.studyTopic)).length;const label=document.querySelector('#study-progress');if(label&&reviewed)label.textContent=`${reviewed} of ${rows.length} chapters reviewed in this browser.`;}catch{}}progress();document.addEventListener('astro:page-load',progress);</script>
