---
/**
 * Brewing: notes and projects that are not finished yet.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const notes = (await getCollection('field-notes'))
  .filter((n) => !n.data.draft && n.data.category.trim() === 'Brewing')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const projects = (await getCollection('projects'))
  .filter((p) => p.data.status !== 'live')
  .sort((a, b) => b.data.priority - a.data.priority || a.data.title.localeCompare(b.data.title));

const day = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Brewing"
  description="Notes and projects by C M Nafi that are still in progress."
  canonical="/brewing"
>
  <div class="s-page">
    <header>
      <p class="s-eyebrow">Brewing · not finished yet</p>
      <h1 class="s-title">What I am still <em>working out.</em></h1>
      <p class="s-lede">
        Early notes and projects in development. Finished writing is in <a href="/field-notes">Field Notes</a>;
        tools you can use today are in the <a href="/garage">Garage</a>.
      </p>
    </header>

    {projects.length > 0 && (
      <section class="s-section" aria-labelledby="brewing-projects">
        <div class="s-section-head"><h2 id="brewing-projects">Projects in development</h2></div>
        <ul class="s-rows" role="list">
          {projects.map((project) => (
            <li>
              <a class="s-row" href={`/garage/${project.slug}`}>
                <span class="s-row__meta">{project.data.category}</span>
                <span>
                  <span class="s-row__title">{project.data.title}</span>
                  <span class="s-row__note">{project.data.summary}</span>
                </span>
                <span class="s-row__tag s-row__tag--wip">{project.data.status === 'parked' ? 'Paused' : 'In development'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {notes.length > 0 && (
      <section class="s-section" aria-labelledby="brewing-notes">
        <div class="s-section-head"><h2 id="brewing-notes">Early notes</h2></div>
        <ul class="s-rows" role="list">
          {notes.map((note) => (
            <li>
              <a class="s-row" href={`/field-notes/${note.slug}`}>
                <time class="s-row__meta" datetime={note.data.publishedAt.toISOString()}>{day(note.data.publishedAt)}</time>
                <span>
                  <span class="s-row__title">{note.data.title}</span>
                  <span class="s-row__note">{note.data.excerpt}</span>
                </span>
                <span class="s-row__tag">{note.data.readingTime.replace(' read', '')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
