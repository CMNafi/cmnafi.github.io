---
import WorldCupLayout from '@/layouts/WorldCupLayout.astro';
const pages=[['Teams','Team profiles and background.','teams'],['Groups','Explore the group-stage setup.','groups'],['Matches','The fixture list stored with this project.','matches'],['Bracket','Experiment with knockout-stage predictions.','knockouts']];
---
<WorldCupLayout title="World Cup Corner — Archive"><header class="page-masthead"><span class="eyebrow">From the Garage / 2026</span><h1>World Cup Corner.</h1><p class="lead">A research and prediction project built around the 2026 World Cup. Kept here as an archive of the tools and ideas.</p></header><div class="archive-grid">{pages.map(([name,description,slug])=><a href={`/world-cup-2026/${slug}/`}><h2>{name} ↗</h2><p>{description}</p></a>)}</div></WorldCupLayout>
<style>.archive-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px 50px}.archive-grid a{border-top:1px solid var(--surface-line);padding:24px 0}.archive-grid h2{font-size:32px}.archive-grid p{color:var(--ink-secondary)}@media(max-width:600px){.archive-grid{grid-template-columns:1fr}}</style>
