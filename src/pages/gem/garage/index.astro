---
import GemLayout from '../../../layouts/GemLayout.astro';
import { projects } from '../../../data/gem/projects';
import ProjectCard from '../../../components/gem/catalog/ProjectCard.astro';
import FormAdvMiniExplorer from '../../../components/gem/islands/FormAdvMiniExplorer.astro';
import CaiaFrontierSandbox from '../../../components/gem/islands/CaiaFrontierSandbox.astro';

const categories = [
  { id: 'all', label: `All Projects (${projects.length})` },
  { id: 'fintech-sec', label: `FinTech & SEC Data (${projects.filter((p) => p.category === 'fintech-sec').length})` },
  { id: 'cricket-sports', label: `Cricket & Sports (${projects.filter((p) => p.category === 'cricket-sports').length})` },
  { id: 'knowledge-systems', label: `Decision Models (${projects.filter((p) => p.category === 'knowledge-systems').length})` }
];
---

<GemLayout
  title="Projects & Tools | The Systems Workbench · C M Nafi"
  description="Eight working tools across SEC regulatory intelligence, alternative investments, league cricket tactics, and decision models."
  currentPath="/gem/garage/"
>
  <div class="workbench-page">
    <!-- Masthead -->
    <header class="workbench-masthead">
      <span class="eyebrow-tag">Editorial Systems Lab · Tools & Projects</span>
      <h1 class="page-title">The Systems Workbench</h1>
      <p class="masthead-intro">
        I build tools to answer problems I run into in my work and life. As a solutions engineer, my skill is describing exactly what should exist and shaping it with modern AI tools. Below are eight working projects spanning SEC regulatory due diligence, alternative investments, cricket field planning, and cultural decision models.
      </p>

      <!-- Category Filter Tabs -->
      <div class="category-tabs-bar" data-workbench-tabs>
        {categories.map((c, idx) => (
          <button
            type="button"
            class:list={['filter-tab', { active: idx === 0 }]}
            data-filter={c.id}
          >
            {c.label}
          </button>
        ))}
      </div>
    </header>

    <!-- Projects Grid -->
    <section class="projects-grid-section" data-projects-grid>
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </section>

    <!-- Interactive Diligence Workbench Section (Mounted Islands) -->
    <section class="workbench-islands-section editorial-section">
      <div class="section-head-row">
        <div>
          <span class="eyebrow-tag">Interactive Micro-Tool 01 · Institutional Due Diligence</span>
          <h2>SEC Form ADV & 13F Intelligence Sandbox</h2>
        </div>
        <a href="/gem/field-notes/" class="section-link-more">Read "The Universe of Form ADV" Essay →</a>
      </div>
      <p style="color:var(--text-secondary);font-size:14px;line-height:1.7;margin:0 0 20px;max-width:var(--max-w-prose)">
        In institutional diligence at Dasseti, understanding an investment adviser begins with Form ADV Part 1A. This sandbox lets you examine entity structure, regulatory AUM, and fee models across 8 major firms, with a side-by-side diff to compare traditional asset managers against private equity allocators.
      </p>
      <FormAdvMiniExplorer />
    </section>

    <section class="workbench-islands-section editorial-section">
      <div class="section-head-row">
        <div>
          <span class="eyebrow-tag">Interactive Micro-Tool 02 · Alternative Asset Allocation</span>
          <h2>CAIA Portfolio Frontier & Covariance Engine</h2>
        </div>
        <a href="/caia/" class="section-link-more">Open CAIA Knowledge Hub →</a>
      </div>
      <p style="color:var(--text-secondary);font-size:14px;line-height:1.7;margin:0 0 20px;max-width:var(--max-w-prose)">
        Developed during my CAIA charter studies and alternative investment research at SkyBridge. Adjust the allocation weights across equities, private debt, and real assets to see how non-correlated returns bend the Markowitz efficient frontier upward, expanding return for given levels of volatility.
      </p>
      <CaiaFrontierSandbox />
    </section>
  </div>
</GemLayout>

<script>
  function initWorkbenchFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-workbench-tabs] .filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.project-system-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';

        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        cards.forEach((card) => {
          const cat = card.getAttribute('data-category') || '';
          card.style.display = filter === 'all' || cat === filter ? 'flex' : 'none';
        });
      });
    });
  }

  initWorkbenchFilters();
  document.addEventListener('astro:page-load', initWorkbenchFilters);
</script>

<style>
  .workbench-page {
    padding-top: 48px;
  }

  .workbench-masthead {
    margin-bottom: 40px;
  }

  .page-title {
    font-size: clamp(38px, 4.5vw, 60px);
    margin: 0 0 16px;
    font-weight: 400;
  }

  .masthead-intro {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: var(--max-w-prose);
    margin: 0 0 28px;
  }

  .category-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 16px;
  }

  .filter-tab {
    padding: 8px 14px;
    font-size: 12px;
    font-family: var(--font-sans);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-tab:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .filter-tab.active {
    background: var(--accent-primary);
    color: var(--bg-canvas);
    border-color: var(--accent-primary);
  }

  .projects-grid-section {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
    margin-bottom: 56px;
  }

  .workbench-islands-section {
    margin-top: 24px;
  }

  @media (max-width: 768px) {
    .projects-grid-section {
      grid-template-columns: 1fr;
    }
  }
</style>
