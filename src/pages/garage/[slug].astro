---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TelemetryGrid from '@/components/telemetry/TelemetryGrid.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---
<BaseLayout title={project.data.title}>
  <div class="garage-detail">
    <article class="paddock-article">
      <header class="article-header">
        <p class="note-meta">
          <a href="/garage">Garage</a>
          <span aria-hidden="true">/</span>
          <span>{project.data.category}</span>
          <span aria-hidden="true">·</span>
          <span>{project.data.status === 'live' ? 'Live' : project.data.status === 'brewing' ? 'In development' : 'Paused'}</span>
        </p>
        <h1>{project.data.title}</h1>
        <p class="summary">{project.data.summary}</p>
        <div class="telemetry-bar">
          <TelemetryGrid 
              updated={(project.data.updatedAt || project.data.startedAt)?.toLocaleDateString() || '--'}
              status={project.data.status as any}
              stack={project.data.stack?.join(', ') || 'N/A'}
              link={project.data.status === 'live' ? project.data.liveUrl || project.data.repoUrl : project.data.repoUrl}
              linkLabel={project.data.status === "live" && project.data.liveUrl ? "VIEW PROJECT →" : "VIEW SOURCE →"}
            />
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .note-meta {
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    margin: 0 0 1.75rem;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .note-meta a { color: var(--accent); }
  .note-meta a:hover { color: var(--ink-primary); }

  .paddock-article { max-width: 760px; margin: 0 auto; padding: clamp(2.5rem, 6vw, 4.5rem) 1rem 6rem; }
  .article-header { border-bottom: 1px solid var(--carbon); padding-bottom: 3rem; margin-bottom: 3rem; }
  .article-header h1 { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.02em; font-size: clamp(2.3rem, 4.6vw, 3.6rem); margin: 0 0 1rem; color: var(--pitlane-white); line-height: 1.1; }
  .summary { font-family: var(--font-body); font-size: 1.25rem; color: var(--muted); margin-bottom: 3rem; line-height: 1.6; max-width: 650px; }
  .prose { font-family: var(--font-body); font-size: 1.15rem; line-height: 1.8; color: var(--text); }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 400; font-size: 1.8rem; line-height: 1.2; letter-spacing: -0.015em; margin-top: 3.5rem; margin-bottom: 1.25rem; color: var(--ink-primary); }
  .prose :global(h3) { font-family: var(--font-display); font-weight: 500; font-size: 1.3rem; margin-top: 2.5rem; margin-bottom: 1rem; color: var(--pitlane-white); }
  .prose :global(p) { margin-bottom: 1.5rem; }
  .prose :global(ul) { margin-bottom: 1.5rem; padding-left: 1.5rem; }
  .prose :global(li) { margin-bottom: 0.5rem; }
</style>
