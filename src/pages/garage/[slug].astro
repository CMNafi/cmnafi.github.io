---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import ProjectGlyph from '@/components/ProjectGlyph.astro';import {projectUrl,isProject,formatDate} from '@/config/editorial';
export async function getStaticPaths(){return(await getCollection('projects')).map(project=>({params:{slug:project.slug},props:{project}}))}
const {project}=Astro.props;
const {Content}=await project.render();
const url=projectUrl(project);
const related=(await getCollection('projects')).filter(p=>isProject(p)&&p.slug!==project.slug).slice(0,2);
---
<BaseLayout title={project.data.title} description={project.data.description}><div class="reading-shell"><nav class="breadcrumbs"><a href="/garage/">← Garage</a><span>{project.data.status} / {project.data.category}</span></nav><header><h1>{project.data.title}</h1><p class="standfirst">{project.data.summary}</p>{url&&url.replace(/\/$/,'')!==`/garage/${project.slug}`?<a class="action" href={url} data-astro-reload>Open project ↗</a>:<span class="meta">{project.data.status==='live'?'Project overview':'Not public yet'}</span>}<p class="meta">{formatDate(project.data.updatedAt||project.data.startedAt)} · {project.data.stack.join(' / ')}</p></header><div class="reading-body"><ProjectGlyph slug={project.slug}/><section><h2>The problem</h2><p>{project.data.problem}</p></section><section><h2>What I built</h2><p>{project.data.solution}</p></section><section><h2>Who it is for</h2><p>{project.data.whoItsFor}</p></section>{project.data.keyFeatures.length>0&&<section><h2>Key features</h2><ul>{project.data.keyFeatures.map(f=><li>{f}</li>)}</ul></section>}{project.data.roadmap.length>0&&<section><h2>What is next</h2><ul>{project.data.roadmap.map(f=><li>{f}</li>)}</ul></section>}<div class="project-original"><Content/></div><h2>Keep exploring</h2>{related.map(p=><p><a href={`/garage/${p.slug}/`}>{p.data.title} →</a></p>)}<a class="text-link" href="/field-notes/">Read the field notes →</a></div></div></BaseLayout>
