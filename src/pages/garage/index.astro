---
/**
 * Garage index: every project in one list, with its honest status.
 * Live tools open the tool; everything else opens its write-up.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.status === 'live') - Number(a.data.status === 'live') ||
    b.data.priority - a.data.priority ||
    a.data.title.localeCompare(b.data.title)
);

const statusLabel = { live: 'Live', brewing: 'In development', parked: 'Paused' } as const;
const filters = (['live', 'brewing', 'parked'] as const).filter((s) => projects.some((p) => p.data.status === s));
const hrefOf = (p: (typeof projects)[number]) =>
  p.slug !== 'form-adv-data-finder' && p.data.status === 'live' && p.data.liveUrl ? p.data.liveUrl : `/garage/${p.slug}`;
---

<BaseLayout
  title="Garage"
  description="Independent tools and project notes from C M Nafi: adviser research, cricket fielding, sports dashboards, and a guide to everyday choices."
  canonical="/garage"
>
  <div class="s-page" data-garage>
    <header>
      <p class="s-eyebrow">Garage · {projects.length} projects</p>
      <h1 class="s-title">Small tools I wanted and <em>couldn’t find.</em></h1>
      <p class="s-lede">
        At work I translate between investors and software. Here I try my own ideas: clearer adviser research,
        better fielding decisions, questions from my reading. I build these with AI coding tools, on my own time;
        none of them were made for an employer.
      </p>
    </header>

    <div class="garage-controls">
      <div class="s-chips" role="group" aria-label="Filter projects">
        <button class="s-chip" type="button" data-garage-filter="all" aria-pressed="true">All <span>{projects.length}</span></button>
        {filters.map((s) => (
          <button class="s-chip" type="button" data-garage-filter={s} aria-pressed="false">
            {statusLabel[s]} <span>{projects.filter((p) => p.data.status === s).length}</span>
          </button>
        ))}
      </div>
    </div>

    <ul class="s-rows garage-rows" role="list">
      {projects.map((project) => (
        <li data-garage-project data-status={project.data.status}>
          <a class="s-row" href={hrefOf(project)} data-astro-reload>
            <span class="s-row__meta">{project.data.category}</span>
            <span>
              <span class="s-row__title">{project.data.title}</span>
              <span class="s-row__note">{project.data.summary}</span>
            </span>
            <span class:list={['s-row__tag', project.data.status === 'live' ? 's-row__tag--live' : 's-row__tag--wip']}>
              {statusLabel[project.data.status]}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="s-lede garage-note">
      Have a thought on any of these? <a href="/connect">Tell me</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .garage-controls {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .garage-rows {
    margin-top: 1.25rem;
    border-top: 1px solid var(--surface-line);
  }

  [data-garage-project][hidden] {
    display: none;
  }

  .garage-note {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
</style>

<script>
  function initGarage() {
    const root = document.querySelector<HTMLElement>('[data-garage]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-garage-filter]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-garage-project]'));
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const filter = chip.dataset.garageFilter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        rows.forEach((row) => (row.hidden = filter !== 'all' && row.dataset.status !== filter));
      })
    );
  }

  document.addEventListener('astro:page-load', initGarage);
</script>
