---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import ProjectGlyph from '@/components/ProjectGlyph.astro';import {isProject,projectUrl} from '@/config/editorial';
const order={live:0,brewing:1,parked:2};const projects=(await getCollection('projects')).filter(isProject).sort((a,b)=>order[a.data.status]-order[b.data.status]||(b.data.updatedAt||b.data.startedAt).valueOf()-(a.data.updatedAt||a.data.startedAt).valueOf());
---
<BaseLayout title="Garage" description="Tools, research projects, and experiments by C M Nafi."><div class="page-container" data-project-index><header class="page-masthead"><span class="eyebrow">The Garage / {projects.length} projects</span><h1>Curiosity,<br/>made <em>tangible.</em></h1><p class="lead">Small questions. Deep rabbit holes. Tools, interactive worlds, and ideas you can step inside.</p></header><div class="filter-bar">{['all','live','brewing','parked'].map(state=><a href={`?status=${state}`} data-status-filter={state} aria-current={state==='all'?'page':undefined}>{state} {state==='all'?projects.length:projects.filter(p=>p.data.status===state).length}</a>)}</div><div class="project-list">{projects.map(project=><article data-project-state={project.data.status}><a href={`/garage/${project.slug}/`}><ProjectGlyph slug={project.slug}/><span class="meta"><i class:list={['project-dot',project.data.status]}/>{project.data.status} / {project.data.category}</span><h2>{project.data.title}</h2><p>{project.data.summary}</p></a><div class="project-actions"><a class="text-link" href={`/garage/${project.slug}/`}>About the project →</a>{projectUrl(project)&&<a class="text-link" href={projectUrl(project)!} data-astro-reload>Open ↗</a>}</div></article>)}</div><p data-project-empty hidden>No projects in this group yet.</p><aside class="garage-links"><h2>Other corners</h2><a class="text-link" href="/caia/">CAIA study notes →</a><a class="text-link" href="/technology-history/">Technology history →</a><a class="text-link" href="/field-notes/">Field Notes →</a></aside></div></BaseLayout>
<style>.project-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:42px 35px}.project-list article{border-top:1px solid var(--surface-line);padding:18px 0;display:flex;flex-direction:column}.project-list article>a{display:block;flex:1}.project-list h2{font-size:34px;margin:20px 0 15px}.project-list p{font-size:16px;color:var(--ink-secondary)}.project-dot{display:inline-block;width:7px;height:7px;border:1px solid var(--ink-secondary);border-radius:50%;margin-right:9px}.project-dot.live{background:var(--accent);border-color:var(--accent)}.project-dot.brewing{background:var(--status-warn);border-color:var(--status-warn)}.project-actions{display:flex;justify-content:space-between;gap:12px}.garage-links{margin-top:65px;border-top:1px solid var(--surface-line);padding-top:25px}.garage-links .text-link{margin-right:28px}@media(max-width:850px){.project-list{grid-template-columns:1fr 1fr}}@media(max-width:600px){.project-list{grid-template-columns:1fr}}</style>
<script>function initProjects(){const root=document.querySelector<HTMLElement>('[data-project-index]');if(!root||root.dataset.ready)return;root.dataset.ready='true';const apply=(status:string)=>{let count=0;root.querySelectorAll<HTMLElement>('[data-project-state]').forEach(p=>{p.hidden=status!=='all'&&p.dataset.projectState!==status;if(!p.hidden)count++});root.querySelectorAll('[data-status-filter]').forEach(a=>a.toggleAttribute('aria-current',(a as HTMLElement).dataset.statusFilter===status));(root.querySelector('[data-project-empty]')as HTMLElement).hidden=count>0;};apply(new URLSearchParams(location.search).get('status')||'all');root.querySelectorAll<HTMLAnchorElement>('[data-status-filter]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const status=a.dataset.statusFilter!;apply(status);history.replaceState(null,'',`?status=${status}`)}))}initProjects();document.addEventListener('astro:page-load',initProjects);</script>
