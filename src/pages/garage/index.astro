---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectFeature from '@/components/telemetry/ProjectFeature.astro';
import SectorBadge from '@/components/telemetry/SectorBadge.astro';
const projects = (await getCollection('projects')).sort((a,b) => b.data.priority - a.data.priority || a.data.title.localeCompare(b.data.title));
const featured = projects.find(p => p.data.featured && p.data.status === 'live');
const filters = ['all', 'live', 'brewing', 'parked'];
---
<BaseLayout title="The Garage — Projects & experiments" description="A growing collection of interactive experiences, research tools, and experiments by C M Nafi. Explore Worldview and see what is taking shape next.">
  <div class="collection-shell">
    <header class="collection-intro">
      <div><SectorBadge variant="p1" label="THE GARAGE / INDEPENDENT PROJECTS" /><h1>Curiosity,<br />made <em>tangible.</em></h1></div>
      <div class="intro-aside"><p>Small questions. Deep rabbit holes.<br />A growing collection of tools, interactive worlds, and ideas you can step inside.</p><a href="#collection">Explore the collection <span aria-hidden="true">↓</span></a><span class="collection-count">{String(projects.length).padStart(2,'0')} PROJECTS / ALWAYS EVOLVING</span></div>
    </header>
    {featured && <ProjectFeature project={featured} />}
    <section class="collection" id="collection" aria-labelledby="collection-title">
      <div class="collection-heading"><div><span class="eyebrow">THE COLLECTION</span><h2 id="collection-title">Ideas in the wild.</h2></div><p>Open a project. Follow a thread.<br />See where it takes you.</p></div>
      <div class="filter-row" aria-label="Filter projects">
        {filters.map(filter => <button type="button" data-filter={filter} aria-pressed={filter==='all'}>{filter==='all'?'All projects':filter}<span>{filter==='all'?projects.length:projects.filter(p=>p.data.status===filter).length}</span></button>)}
        <span class="result-count" aria-live="polite" id="project-count">{projects.length} projects</span>
      </div>
      <div class="project-grid">
        {projects.map((project,index) => <article class="project-card" data-project-status={project.data.status}>
          <a class="project-link" href={project.data.status==='live' && project.data.liveUrl ? project.data.liveUrl : `/garage/${project.slug}`} data-astro-reload>
            <div class="card-art">{project.data.image ? <img src={project.data.image} alt="" loading="lazy" /> : <div class="card-diagram" aria-hidden="true"><span class="diagram-number">{String(index+1).padStart(2,'0')}</span><span class="diagram-line"></span><span class="diagram-category">{project.data.category}</span></div>}<span class="open-arrow" aria-hidden="true">↗</span></div>
            <div class="card-copy"><div class="card-meta"><span>{project.data.category}</span><span class:list={['project-state',project.data.status]}>{project.data.status}</span></div><h3>{project.data.title}</h3><p>{project.data.summary}</p><span class="card-action">{project.data.status==='live'?'Explore project':'Inside the project'} <span aria-hidden="true">→</span></span></div>
          </a>
        </article>)}
      </div>
      <p class="empty-message" hidden>No projects in this category yet. Explore the rest of the collection.</p>
    </section>
    <aside class="collection-note"><span class="eyebrow">AN OPEN WORKSHOP</span><p>Some ideas become tools.<br />Others become the next question.</p><a href="/connect">Have a thought? Let’s talk ↗</a></aside>
  </div>
</BaseLayout>
<script>
function initProjectFilters() {
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-status]');
  buttons.forEach(button => { button.onclick = () => {
    const filter = button.dataset.filter;
    buttons.forEach(item => item.setAttribute('aria-pressed',String(item===button)));
    let count=0;
    cards.forEach(card => {card.hidden=filter!=='all' && card.dataset.projectStatus!==filter;if(!card.hidden) count++;});
    const output=document.getElementById('project-count');if(output) output.textContent=`${count} ${count===1?'project':'projects'}`;
    const empty=document.querySelector<HTMLElement>('.empty-message');if(empty) empty.hidden=count!==0;
  };});
}
document.addEventListener('astro:page-load',initProjectFilters);
initProjectFilters();
</script>
<style>
.collection-shell{max-width:1240px;margin:auto;padding:70px 32px 80px}.collection-intro{display:grid;grid-template-columns:1.3fr 1fr;align-items:end;gap:70px;margin-bottom:64px}h1{font:400 clamp(54px,7.5vw,104px)/1.02 var(--font-serif);letter-spacing:-.065em;margin:28px 0 0}h1 em{font-weight:400;color:var(--accent)}.intro-aside{padding-bottom:8px}.intro-aside p{font-size:19px;line-height:1.75;color:var(--ink-secondary);margin:0 0 24px}.intro-aside a{font:12px var(--font-mono);display:flex;gap:35px}.collection-count{display:block;font:10px var(--font-mono);letter-spacing:.12em;color:var(--ink-secondary);margin-top:40px}.collection{padding-top:100px;scroll-margin-top:30px}.collection-heading{display:flex;justify-content:space-between;gap:25px;align-items:end;margin-bottom:34px}.eyebrow{font:10px var(--font-mono);letter-spacing:.13em;color:var(--accent)}h2{font:400 clamp(32px,4vw,48px)/1.15 var(--font-serif);letter-spacing:-.04em;margin:13px 0 0}.collection-heading p{color:var(--ink-secondary);font-size:15px;line-height:1.7;margin:0}.filter-row{display:flex;align-items:center;gap:8px;border-top:1px solid var(--surface-line);padding:22px 0 30px;flex-wrap:wrap}.filter-row button{padding:10px 14px;background:transparent;border:1px solid var(--surface-line);border-radius:2px;color:var(--ink-secondary);font:11px var(--font-mono);text-transform:capitalize}.filter-row button span{margin-left:14px;opacity:.65}.filter-row button[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:var(--surface-base)}.result-count{margin-left:auto;font:10px var(--font-mono);color:var(--ink-secondary)}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.project-card{border:1px solid var(--surface-line);border-radius:var(--radius-card);overflow:hidden;background:var(--surface-raised);transition:transform var(--dur-base),border-color var(--dur-base)}.project-card:hover{transform:translateY(-4px);border-color:var(--accent)}.project-card[hidden]{display:none}.project-link{display:flex;flex-direction:column;height:100%}.card-art{height:215px;position:relative;overflow:hidden;border-bottom:1px solid var(--surface-line);background:var(--surface-base)}.card-art img{width:100%;height:100%;object-fit:cover}.open-arrow{position:absolute;right:17px;top:15px;color:var(--accent);font-size:22px}.card-diagram{height:100%;padding:24px 30px;display:flex;flex-direction:column;justify-content:center;background-image:linear-gradient(var(--surface-line) 1px,transparent 1px),linear-gradient(90deg,var(--surface-line) 1px,transparent 1px);background-size:35px 35px}.diagram-number{font:italic 74px/1 var(--font-serif);color:var(--ink-secondary)}.diagram-line{width:55%;height:1px;background:var(--accent);margin:20px 0 14px}.diagram-category{font:9px var(--font-mono);text-transform:uppercase;letter-spacing:.2em;color:var(--accent)}.card-copy{padding:24px;display:flex;flex-direction:column;flex:1}.card-meta{display:flex;justify-content:space-between;gap:10px;font:9px var(--font-mono);text-transform:uppercase;letter-spacing:.06em;color:var(--ink-secondary)}.project-state.live{color:var(--accent)}.project-state.brewing{color:var(--status-warn)}h3{font:400 27px/1.2 var(--font-serif);letter-spacing:-.03em;margin:22px 0 14px}.card-copy p{font-size:15px;line-height:1.75;color:var(--ink-secondary);margin:0 0 26px}.card-action{font:11px var(--font-mono);display:flex;justify-content:space-between;margin-top:auto;padding-top:20px;border-top:1px solid var(--surface-line)}.card-action span{color:var(--accent)}.collection-note{margin-top:80px;padding:46px 0 0;border-top:1px solid var(--surface-line)}.collection-note p{font:400 clamp(27px,4vw,42px)/1.3 var(--font-serif);letter-spacing:-.035em}.collection-note a{font:12px var(--font-mono);color:var(--ink-secondary)}.empty-message{color:var(--ink-secondary);padding:30px 0}@media(max-width:960px){.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.collection-intro{gap:30px;grid-template-columns:1fr 1fr}}@media(max-width:700px){.collection-shell{padding:38px 20px 60px}.collection-intro{grid-template-columns:1fr;gap:26px;margin-bottom:35px}.collection-count{margin-top:25px}.collection-heading{display:block}.collection-heading p{margin-top:18px}.collection{padding-top:60px}.project-grid{grid-template-columns:1fr}.result-count{width:100%;margin:10px 0 0}.card-art{height:230px}.collection-note{margin-top:50px}}@media(prefers-reduced-motion:reduce){.project-card{transition:none}.project-card:hover{transform:none}}
</style>
