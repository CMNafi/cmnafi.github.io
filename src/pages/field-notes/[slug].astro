---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import NoteRow from '@/components/NoteRow.astro';import {formatDate,readingTime,isPublicNote} from '@/config/editorial';import {siteConfig} from '@/config/site';
export async function getStaticPaths(){return (await getCollection('field-notes')).filter(n=>!n.data.draft&&!['capital-lens-16','capital-lens-17','adv-universe'].includes(n.slug)).map(note=>({params:{slug:note.slug},props:{note}}))}
const {note}=Astro.props;const {Content,headings}=await note.render();const notes=(await getCollection('field-notes')).filter(isPublicNote).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());const siblings=note.data.category==='Books'?notes.filter(n=>n.data.category==='Books'):notes;const index=siblings.findIndex(n=>n.slug===note.slug);const older=siblings[index+1],newer=siblings[index-1];const related=notes.filter(n=>n.slug!==note.slug&&n.data.category===note.data.category).slice(0,3);const embeddedTitle=/<h1[\s>]/i.test(note.body)||/^\s*# /.test(note.body);const dataEssay=note.data.series==='Capital Lens';const toc=headings.filter(h=>h.depth===2);const url=new URL(`/field-notes/${note.slug}/`,siteConfig.siteUrl).href;
const ld={'@context':'https://schema.org','@type':'BlogPosting',headline:note.data.title,description:note.data.description,datePublished:note.data.publishedAt.toISOString(),dateModified:(note.data.updatedAt||note.data.publishedAt).toISOString(),author:{'@type':'Person',name:'C M Nafi',url:siteConfig.siteUrl},url};
---
<BaseLayout title={note.data.seoTitle||note.data.title} description={note.data.seoDescription||note.data.description} type="article"><Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld)}/></Fragment><article class:list={['reading-shell',{'data-essay':dataEssay}]}><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/field-notes/">Field Notes</a><span>/</span><a href={`/field-notes/category/${note.data.category.toLowerCase().replace(/\s+/g,'-')}/`}>{note.data.category}</a></nav><header><p class="meta">{note.data.series&&<><a href={note.data.series==='Capital Lens'?'/field-notes/capital-lens/':`/field-notes/series/${note.data.series.toLowerCase().replace(/\s+/g,'-')}/`}>{note.data.series}</a> · </>}{formatDate(note.data.publishedAt)} · {readingTime(note.data.readingTime)}</p>{!embeddedTitle&&<><h1>{note.data.title}</h1><p class="standfirst">{note.data.description}</p></>}</header>{toc.length>2&&note.data.category!=='Books'&&<details class="article-contents"><summary>Contents</summary><nav aria-label="Article contents">{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}<div class:list={['reading-body',{'data-body':dataEssay}]}><Content components={embeddedTitle?{}:{h1:'h2'}}/></div><div class="article-end"><p class="meta">{note.data.tags.join(' / ')}</p><a class="text-link" href="https://www.linkedin.com/in/cm-nafi/">Reply on LinkedIn ↗</a><nav class="adjacent-notes" aria-label="Adjacent notes">{older&&<a href={`/field-notes/${older.slug}/`}><span>← Previous {note.data.category==='Books'?'book':'note'}</span>{older.data.title}</a>}{newer&&<a href={`/field-notes/${newer.slug}/`}><span>Next {note.data.category==='Books'?'book':'note'} →</span>{newer.data.title}</a>}</nav><h2>Keep reading</h2>{related.map(n=><NoteRow note={n}/>)}</div></article></BaseLayout>
<script>function wrapTables(){document.querySelectorAll<HTMLTableElement>('.reading-body table').forEach(table=>{if(table.parentElement?.classList.contains('table-scroll'))return;const wrapper=document.createElement('div');wrapper.className='table-scroll';wrapper.tabIndex=0;wrapper.setAttribute('role','region');wrapper.setAttribute('aria-label','Scrollable table');table.before(wrapper);wrapper.append(table)})}wrapTables();document.addEventListener('astro:page-load',wrapTables);</script>
<style is:global>.reading-body .cl-masthead{display:none}.reading-body .cl-hero{margin-bottom:35px}.reading-body .cl-hero h1{font-size:clamp(38px,6vw,66px)}.data-body{max-width:850px}.reading-body .cl-deck{font-size:22px;color:var(--ink-secondary)}.reading-body :is(.cl-meta,.cl-category,.cl-section-num){font:12px var(--font-mono);color:var(--ink-secondary)}.reading-body .cl-content-wrap{display:block}.reading-body .cl-sidebar{border-top:1px solid var(--surface-line);margin-top:35px;padding-top:20px}.reading-body :is(.cl-stat-grid,.cl-stats){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.reading-body :is(.cl-stat,.cl-stat-card){border-top:1px solid var(--surface-line);padding:20px 0}.reading-body .cl-stat-number{font:36px var(--font-mono)}.reading-body .cl-pull-quote{margin:35px 0;border-left:2px solid var(--accent);padding-left:24px}.reading-body .cl-footer{display:none}.reading-body :is(.cl-callout,.cl-verdict){padding:24px 0;border-block:1px solid var(--surface-line);margin:30px 0}.reading-body table{display:block;overflow:auto;max-width:100%}.article-end .note-row{grid-template-columns:100px 1fr 24px}.article-end .note-row .row-meta{display:none}</style>
