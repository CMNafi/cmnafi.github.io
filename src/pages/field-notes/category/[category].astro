---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import NotesIndex from '@/components/NotesIndex.astro';import {categorySlug,isPublicNote} from '@/config/editorial';
export async function getStaticPaths(){const notes=(await getCollection('field-notes')).filter(isPublicNote);return [...new Set(notes.map(n=>n.data.category))].map(category=>({params:{category:categorySlug(category)},props:{category}}))}const {category}=Astro.props;
---
<BaseLayout title={`${category} · Field Notes`} description={`C M Nafi's notes and essays on ${category.toLowerCase()}.`}><NotesIndex category={category}/></BaseLayout>
