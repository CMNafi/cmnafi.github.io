---
/**
 * One page per Field Notes category, in the same list style as the index.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const slugify = (value: string) => value.trim().toLowerCase().replace(/\s+/g, '-');

export async function getStaticPaths() {
  const notes = (await getCollection('field-notes')).filter((n) => !n.data.draft);
  const categories = [...new Set(notes.map((n) => n.data.category.trim()))];
  return categories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: {
      category,
      notes: notes
        .filter((n) => n.data.category.trim() === category)
        .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()),
      categories: categories.filter((c) => c !== 'Brewing')
    }
  }));
}

const { category, notes, categories } = Astro.props;
const blurbs: Record<string, string> = {
  Finance: 'How capital moves: funds, filings, and the numbers behind the headlines.',
  Books: 'Notes on the books that stayed with me.',
  Cricket: 'Write-ups of the close finishes in Florida league cricket.',
  Brewing: 'What I am still working out.'
};
const day = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={`Field Notes: ${category}`}
  description={`${notes.length} Field Notes on ${category.toLowerCase()} by C M Nafi. ${blurbs[category] ?? ''}`}
  canonical={`/field-notes/category/${slugify(category)}`}
>
  <div class="s-page">
    <header>
      <p class="s-eyebrow"><a href="/field-notes">Field Notes</a> · {notes.length} in {category}</p>
      <h1 class="s-title">{category}</h1>
      <p class="s-lede">{blurbs[category]}</p>
    </header>

    <nav class="s-chips cat-chips" aria-label="Categories">
      <a class="s-chip" href="/field-notes">All</a>
      {categories.map((c) => (
        <a class="s-chip" href={`/field-notes/category/${slugify(c)}`} aria-current={c === category ? 'page' : undefined}>{c}</a>
      ))}
    </nav>

    <ul class="s-rows cat-rows" role="list">
      {notes.map((note) => (
        <li>
          <a class="s-row" href={`/field-notes/${note.slug}`}>
            <time class="s-row__meta" datetime={note.data.publishedAt.toISOString()}>{day(note.data.publishedAt)}</time>
            <span>
              <span class="s-row__title">{note.data.title}</span>
              <span class="s-row__note">{note.data.excerpt}</span>
            </span>
            <span class="s-row__tag">{note.data.readingTime.replace(' read', '')}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .cat-chips {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .cat-rows {
    margin-top: 1.25rem;
    border-top: 1px solid var(--surface-line);
  }
</style>
