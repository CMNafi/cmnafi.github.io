---
import FieldNotesConstellation from '../../components/islands/FieldNotesConstellation.astro';
import {getFieldNotesGraph} from '../../lib/field-notes-graph';
import '../../styles/home-hub.css';
const graph=await getFieldNotesGraph(),notes=graph.nodes.filter(n=>n.nodeType!=='tool');
const description='Explore C M Nafi’s connected archive of capital research, book notes, and cricket reports through an idea constellation, a chronological river, or six curated reading tracks.';
const collectionLd={'@context':'https://schema.org','@type':'CollectionPage',name:'Field Notes',url:'https://www.cmnafi.com/field-notes/',description,author:{'@type':'Person',name:'C M Nafi',url:'https://www.cmnafi.com/'},hasPart:notes.map(n=>({'@type':'BlogPosting',headline:n.title,url:'https://www.cmnafi.com'+n.href,datePublished:n.publishedAt}))};
---
<!doctype html><html lang="en" data-theme="paper"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Field Notes | C M Nafi</title><meta name="description" content={description}/><link rel="canonical" href="https://www.cmnafi.com/field-notes/"/><meta property="og:title" content="Field Notes | C M Nafi"/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content="https://www.cmnafi.com/field-notes/"/><meta property="og:image" content="https://www.cmnafi.com/og-default.svg"/><meta name="twitter:card" content="summary_large_image"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&amp;family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400&amp;display=swap" rel="stylesheet"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('cmnafi.home.theme')==='dark'?'dark':'paper'}catch{}</script><script is:inline type="application/ld+json" set:html={JSON.stringify(collectionLd).replaceAll('<','\u003c')}/><script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-W7QGKS85CP"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-W7QGKS85CP');</script></head><body><a class="home-skip" href="#main">Skip to archive</a><header class="site-header"><div class="brand"><a href="/" class="brand-name">C M Nafi</a><span class="brand-tag">Curiosities, systems & stories</span></div><nav class="nav-row" aria-label="Primary navigation"><a href="/garage/">The Garage</a><a href="/field-notes/" aria-current="page">Field Notes</a><a href="/play/">Play</a><a href="/story/">My Story</a><a href="/connect/">Connect</a><button class="theme-btn" data-archive-theme type="button">Theme: Paper</button></nav></header><main id="main"><header class="archive-intro"><p class="archive-kicker">Field Notes / {notes.length} published notes</p><h1>Follow an idea.<br/><em>See what it becomes.</em></h1><div><p>Books become questions. Questions become essays. Some questions become tools. This is a way into the connections between them.</p><p>Start with a title, follow a shared company or concept, or settle into a reading track. The complete index is always one scroll away.</p></div></header><FieldNotesConstellation/></main><footer class="site-footer"><span>© {new Date().getFullYear()} C M Nafi · Notes, tools & weekend cricket</span><nav aria-label="Footer"><a href="/">Home</a><a href="/garage/">The Garage</a><a href="/connect/">Connect</a></nav></footer></body></html>
<script>
const button=document.querySelector<HTMLButtonElement>('[data-archive-theme]');if(button){const apply=(value:string)=>{document.documentElement.dataset.theme=value;button.textContent=`Theme: ${value==='dark'?'Dark':'Paper'}`;};apply(document.documentElement.dataset.theme??'paper');button.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'paper':'dark';apply(next);try{localStorage.setItem('cmnafi.home.theme',next);}catch{}});}
</script>
<style>.archive-intro{padding:4rem 0 3.5rem;display:grid;grid-template-columns:1.2fr 1fr;gap:1rem 4rem;border-bottom:1px solid var(--border-hairline);margin-bottom:3rem}.archive-kicker{grid-column:1/-1;font:10px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.1em;color:var(--accent-primary)}.archive-intro h1{font:450 clamp(3.5rem,7vw,6rem)/.98 'Newsreader',Georgia,serif;letter-spacing:-.04em}.archive-intro h1 em{font-weight:400}.archive-intro>div{align-self:end;max-width:420px}.archive-intro>div p{font-size:14px;line-height:1.8;color:var(--text-secondary);margin-top:1rem}@media(max-width:700px){.archive-intro{padding:2.5rem 0;grid-template-columns:1fr;gap:1rem;margin-bottom:2rem}.archive-intro h1{font-size:3.4rem}.archive-intro>div p{font-size:13px}.archive-kicker{font-size:9px}}</style>
