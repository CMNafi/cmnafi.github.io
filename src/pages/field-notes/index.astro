---
/**
 * Field Notes index: every published note, newest first, grouped by year,
 * with one filter. The idea map lives at /field-notes/atlas.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const notes = (await getCollection('field-notes'))
  .filter((n) => !n.data.draft && n.data.category.trim() !== 'Brewing')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categories = ['Finance', 'Books', 'Cricket'];
const countOf = (c: string) => notes.filter((n) => n.data.category.trim() === c).length;

const years = [...new Set(notes.map((n) => n.data.publishedAt.getUTCFullYear()))];
const byYear = years.map((year) => ({
  year,
  notes: notes.filter((n) => n.data.publishedAt.getUTCFullYear() === year)
}));

const day = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' });
const description =
  'Field Notes by C M Nafi: how capital moves, the books that stayed with me, and match reports from league cricket.';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Field Notes',
  url: 'https://www.cmnafi.com/field-notes/',
  description,
  hasPart: notes.map((n) => ({
    '@type': 'BlogPosting',
    headline: n.data.title,
    url: `https://www.cmnafi.com/field-notes/${n.slug}/`,
    datePublished: n.data.publishedAt.toISOString()
  }))
};
---

<BaseLayout title="Field Notes" description={description} canonical="/field-notes">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionLd).replaceAll('<', '\\u003c')} />
  </Fragment>

  <div class="s-page" data-fn>
    <header>
      <p class="s-eyebrow">Field Notes · {notes.length} published</p>
      <h1 class="s-title">Every big number has a <em>story behind it.</em></h1>
      <p class="s-lede">
        I started with book notes. Work gave me questions about managers, markets and how money moves.
        Weekend cricket gave me close finishes worth remembering. All of it is here, newest first.
      </p>
    </header>

    <div class="fn-controls">
      <div class="s-chips" role="group" aria-label="Filter notes">
        <button class="s-chip" type="button" data-fn-filter="all" aria-pressed="true">All <span>{notes.length}</span></button>
        {categories.map((c) => (
          <button class="s-chip" type="button" data-fn-filter={c} aria-pressed="false">{c} <span>{countOf(c)}</span></button>
        ))}
      </div>
      <a class="s-more" href="/field-notes/atlas">Browse as an idea map</a>
    </div>

    {byYear.map((group) => (
      <section class="fn-year" data-fn-year aria-labelledby={`fn-${group.year}`}>
        <div class="s-section-head">
          <h2 id={`fn-${group.year}`}>{group.year}</h2>
          <span class="fn-year__count" data-fn-count>{group.notes.length}</span>
        </div>
        <ul class="s-rows" role="list">
          {group.notes.map((note) => (
            <li data-fn-note data-cat={note.data.category.trim()}>
              <a class="s-row" href={`/field-notes/${note.slug}`}>
                <time class="s-row__meta" datetime={note.data.publishedAt.toISOString()}>{day(note.data.publishedAt)}</time>
                <span>
                  <span class="s-row__title">{note.data.title}</span>
                  <span class="s-row__note">{note.data.excerpt}</span>
                </span>
                <span class="s-row__tag">{note.data.subCategory && note.data.subCategory !== 'General' ? note.data.subCategory : note.data.category.trim()} · {note.data.readingTime.replace(' read', '')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .fn-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .fn-year {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .fn-year[hidden],
  [data-fn-note][hidden] {
    display: none;
  }

  .fn-year :global(.s-section-head h2) {
    font-size: 0.8125rem;
    color: var(--ink-primary);
  }

  .fn-year__count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-tertiary);
  }
</style>

<script>
  function initFieldNotes() {
    const root = document.querySelector<HTMLElement>('[data-fn]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fn-filter]'));
    const years = Array.from(root.querySelectorAll<HTMLElement>('[data-fn-year]'));

    function apply(filter: string) {
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.fnFilter === filter)));
      for (const year of years) {
        let shown = 0;
        year.querySelectorAll<HTMLElement>('[data-fn-note]').forEach((note) => {
          note.hidden = filter !== 'all' && note.dataset.cat !== filter;
          if (!note.hidden) shown += 1;
        });
        year.hidden = shown === 0;
        const count = year.querySelector('[data-fn-count]');
        if (count) count.textContent = String(shown);
      }
    }

    chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.fnFilter || 'all')));
    const wanted = new URLSearchParams(location.search).get('category');
    const match = chips.find((chip) => chip.dataset.fnFilter?.toLowerCase() === wanted?.toLowerCase());
    if (match) apply(match.dataset.fnFilter || 'all');
  }

  document.addEventListener('astro:page-load', initFieldNotes);
</script>
