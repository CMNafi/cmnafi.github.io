---
// /claude/garage/ : "The Systems Workbench" (Agent 2).
// One catalog of every real project, filterable by category, with three in-page demos.
import ClaudeLayout from '@/layouts/ClaudeLayout.astro';
import ProjectCard from '@/components/claude/catalog/ProjectCard.astro';
import FormAdvMiniExplorer from '@/components/claude/islands/FormAdvMiniExplorer.astro';
import CaiaFrontierSandbox from '@/components/claude/islands/CaiaFrontierSandbox.astro';
import CricketFieldingTactician from '@/components/claude/islands/CricketFieldingTactician.astro';
import { CATEGORY_LABELS, getProjectCatalog } from '@/data/claude/projects';
import type { ProjectCategory } from '@/types/claude-site';

const catalog = await getProjectCatalog();

// Live first, then active R&D; the catalog order is kept within each group.
const ordered = [
  ...catalog.filter((p) => p.lifecycle === 'live'),
  ...catalog.filter((p) => p.lifecycle !== 'live'),
];

const categories = Object.keys(CATEGORY_LABELS) as ProjectCategory[];
const filters = [
  { id: 'all', label: 'All', count: catalog.length },
  ...categories.map((c) => ({ id: c, label: CATEGORY_LABELS[c], count: catalog.filter((p) => p.category === c).length })),
].filter((f) => f.count > 0);

const liveCount = catalog.filter((p) => p.lifecycle === 'live').length;
const rdCount = catalog.length - liveCount;

const titleOf = (id: string) => catalog.find((p) => p.id === id)?.title;

const demos = [
  {
    id: 'demo-form-adv',
    title: 'Form ADV explorer',
    intro:
      'A compact explorer for the adviser data that Regulatory Lens and ADV Screener are built on. Open Regulatory Lens for the full profiles, brochures and 13F holdings.',
    island: 'form-adv',
    forIds: ['form-adv-data-finder', 'adv-screener'],
  },
  {
    id: 'demo-caia',
    title: 'Portfolio allocation sandbox',
    intro:
      'A hands-on companion to the portfolio allocation material in the CAIA notes. The hub itself has the topic notes, the formula sheet and the glossary.',
    island: 'caia',
    forIds: ['caia'],
  },
  {
    id: 'demo-fielding',
    title: 'Fielding tactician',
    intro:
      'A small fielding board in the spirit of Captains View and the Playbook. Open either one for the full ground, roster and presets.',
    island: 'fielding',
    forIds: ['captains-view', 'style-fielding'],
  },
].map((d) => ({ ...d, related: d.forIds.map(titleOf).filter((t): t is string => Boolean(t)) }));
---
<ClaudeLayout
  title="Garage: The Systems Workbench"
  description="Every project in one catalog: SEC data tools, cricket planners, a study hub and an atlas of everyday choices, with live links and in-page demos."
  activePath="/claude/garage/"
>
  <div class="gw cl-container">
    <header class="gw-hero">
      <p class="gw-eyebrow">Garage</p>
      <h1 class="gw-title">The Systems Workbench</h1>
      <p class="gw-lede">
        Small tools I wanted and couldn’t find. Most start with a filing, a fixture list or a field
        plan that took too many tabs to read. I build them with AI coding tools; my part is describing
        exactly what should exist and checking that it does.
      </p>
      <dl class="gw-facts">
        <div><dt>Projects</dt><dd>{catalog.length}</dd></div>
        <div><dt>Live</dt><dd>{liveCount}</dd></div>
        <div><dt>Active R&amp;D</dt><dd>{rdCount}</dd></div>
        <div><dt>Demos on this page</dt><dd>{demos.length}</dd></div>
      </dl>
    </header>

    <section class="gw-catalog" aria-labelledby="gw-catalog-title">
      <div class="gw-section-head">
        <h2 id="gw-catalog-title" class="gw-h2">Catalog</h2>
        <div class="gw-filters" role="group" aria-label="Filter projects by category" data-gw-filters>
          {filters.map((f, i) => (
            <button
              type="button"
              class="gw-filter"
              data-filter={f.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span>{f.label}</span>
              <span class="gw-count">{f.count}<span class="cl-sr-only"> projects</span></span>
            </button>
          ))}
        </div>
      </div>
      <p class="cl-sr-only" aria-live="polite" data-gw-status>Showing all {catalog.length} projects.</p>

      <ul class="gw-grid" role="list" data-gw-grid>
        {ordered.map((project) => (
          <li class="gw-cell" data-category={project.category}>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    </section>

    <section class="gw-demos" aria-labelledby="gw-demos-title">
      <div class="gw-section-head gw-section-head--stacked">
        <h2 id="gw-demos-title" class="gw-h2">Try it here</h2>
        <p class="gw-section-lede">
          Three working demos, built for this page. Each one sits beside the project it comes from, so
          you can get a feel for the idea before opening the full tool.
        </p>
      </div>

      {demos.map((demo) => (
        <article class="gw-demo" id={demo.id} aria-labelledby={`${demo.id}-title`} tabindex="-1">
          <header class="gw-demo-head">
            <div>
              <p class="gw-demo-for">
                Demo for{' '}
                {demo.related.map((title, i) => (
                  <>
                    {i > 0 && (i === demo.related.length - 1 ? ' and ' : ', ')}
                    <span class="gw-demo-project">{title}</span>
                  </>
                ))}
              </p>
              <h3 id={`${demo.id}-title`} class="gw-demo-title">{demo.title}</h3>
            </div>
            <p class="gw-demo-intro">{demo.intro}</p>
          </header>
          <div class="gw-demo-body">
            {demo.island === 'form-adv' && <FormAdvMiniExplorer />}
            {demo.island === 'caia' && <CaiaFrontierSandbox />}
            {demo.island === 'fielding' && <CricketFieldingTactician />}
          </div>
          <p class="gw-demo-back"><a href="#gw-catalog-title">Back to the catalog <span aria-hidden="true">↑</span></a></p>
        </article>
      ))}
    </section>
  </div>
</ClaudeLayout>

<script>
  function initGarageFilters() {
    const group = document.querySelector<HTMLElement>('[data-gw-filters]');
    const grid = document.querySelector<HTMLElement>('[data-gw-grid]');
    const status = document.querySelector<HTMLElement>('[data-gw-status]');
    if (!group || !grid) return;

    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const cells = Array.from(grid.querySelectorAll<HTMLElement>('.gw-cell'));

    const apply = (filter: string) => {
      let shown = 0;
      cells.forEach((cell) => {
        const match = filter === 'all' || cell.dataset.category === filter;
        cell.hidden = !match;
        if (match) shown += 1;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      if (status) {
        const active = buttons.find((b) => b.dataset.filter === filter);
        const name = active?.querySelector('span')?.textContent ?? '';
        status.textContent =
          filter === 'all' ? `Showing all ${shown} projects.` : `Showing ${shown} ${shown === 1 ? 'project' : 'projects'} in ${name}.`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
    });
  }

  // Move focus to a demo when a card's "Try the demo" link is followed, so keyboard users land in it.
  function initDemoFocus() {
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#demo-"]').forEach((link) => {
      link.addEventListener('click', () => {
        const target = document.getElementById(link.hash.slice(1));
        if (target) window.setTimeout(() => target.focus({ preventScroll: true }), 0);
      });
    });
  }

  initGarageFilters();
  initDemoFocus();
</script>

<style>
  .gw {
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 8vw, 112px);
    font-family: var(--font-sans);
    color: var(--text-primary);
  }

  /* ---------- Hero ---------- */
  .gw-hero {
    display: grid;
    gap: 18px;
    max-width: 820px;
    padding-bottom: clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .gw-eyebrow {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent-highlight);
  }

  .gw-title {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.04;
    font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4.25rem);
  }

  .gw-lede {
    max-width: 62ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .gw-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 6px 0 0;
  }

  .gw-facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }

  .gw-facts dt {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .gw-facts dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--text-primary);
  }

  /* ---------- Section heads ---------- */
  .gw-catalog,
  .gw-demos {
    padding-top: clamp(36px, 5vw, 64px);
  }

  .gw-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    margin-bottom: 24px;
  }

  .gw-section-head--stacked {
    display: grid;
    justify-content: start;
    gap: 10px;
    max-width: 720px;
  }

  .gw-h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.375rem);
  }

  .gw-section-lede {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ---------- Filters ---------- */
  .gw-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .gw-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 7px 12px 7px 14px;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    transition: background-color var(--duration-fast, 140ms) var(--ease-standard, ease),
      border-color var(--duration-fast, 140ms) var(--ease-standard, ease),
      color var(--duration-fast, 140ms) var(--ease-standard, ease);
  }

  .gw-filter:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .gw-filter[aria-pressed='true'] {
    border-color: var(--text-primary);
    background: var(--text-primary);
    color: var(--bg-surface);
  }

  .gw-count {
    min-width: 1.6em;
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .gw-filter[aria-pressed='true'] .gw-count {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  /* ---------- Grid ---------- */
  .gw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gw-cell[hidden] {
    display: none;
  }

  /* ---------- Demos ---------- */
  .gw-demo {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    padding: clamp(18px, 3vw, 32px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    scroll-margin-top: calc(var(--header-h, 64px) + 16px);
  }

  .gw-demo:focus-visible {
    outline: 2px solid var(--focus-ring, var(--accent-blue));
    outline-offset: 4px;
  }

  .gw-demo-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 12px 40px;
    align-items: end;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .gw-demo-for {
    margin-bottom: 6px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .gw-demo-project {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .gw-demo-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .gw-demo-intro {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .gw-demo-body {
    min-width: 0;
  }

  .gw-demo-back {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .gw-demo-back a {
    color: var(--text-secondary);
  }

  @media (max-width: 760px) {
    .gw-demo-head {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gw-filter {
      transition: none;
    }
  }
</style>
