---
/**
 * /claude/ homepage: a short hello and a clean index of links.
 * Everything lives on its own page; this page only points to it.
 */
import ClaudeLayout from '@/layouts/ClaudeLayout.astro';

type LinkItem = { label: string; note: string; href: string };
type Group = { id: string; title: string; links: LinkItem[] };

const groups: Group[] = [
  {
    id: 'about',
    title: 'About me',
    links: [
      { label: 'My story', note: 'From Dinajpur to Florida, in four chapters', href: '/claude/story/' },
      { label: 'Get in touch', note: 'Email, LinkedIn, GitHub and X', href: '/claude/connect/' },
    ],
  },
  {
    id: 'writing',
    title: 'Writing',
    links: [
      { label: 'Essays & notes', note: 'Everything I have written, in one place', href: '/claude/field-notes/' },
      { label: 'Finance essays', note: 'How money moves, one big number at a time', href: '/claude/field-notes/#essays' },
      { label: 'Cricket match reports', note: 'The close finishes from league cricket', href: '/claude/field-notes/#cricket' },
      { label: 'Reading shelf', note: 'Notes on the books that stayed with me', href: '/claude/field-notes/#shelf' },
    ],
  },
  {
    id: 'try',
    title: 'Try on this site',
    links: [
      { label: 'Form ADV explorer', note: 'Look inside an investment adviser’s SEC filing', href: '/claude/garage/#demo-form-adv' },
      { label: 'Fielding tactician', note: 'Set the field in three of my matches', href: '/claude/garage/#demo-fielding' },
      { label: 'Portfolio sandbox', note: 'See how private markets change risk and return', href: '/claude/garage/#demo-caia' },
      { label: 'Journey map', note: 'Four places, about 16,000 km', href: '/claude/story/' },
    ],
  },
  {
    id: 'projects',
    title: 'Projects',
    links: [
      { label: 'All projects', note: 'Small tools I wanted and couldn’t find', href: '/claude/garage/' },
      { label: 'Regulatory Lens', note: 'Every adviser’s filings in one profile', href: '/garage/form-adv-data-finder/' },
      { label: 'Captains View', note: 'A cricket fielding planner', href: '/garage/captains-view/' },
      { label: 'CAIA Knowledge Hub', note: 'Study notes for alternative investments', href: '/caia/' },
      { label: 'Worldview', note: 'An atlas of everyday choices', href: '/projects/worldview/' },
      { label: 'Play', note: 'The games and teams I follow', href: '/play/' },
    ],
  },
];
---
<ClaudeLayout
  title="C M Nafi · Systems & Capital"
  description="Hi, I’m Nafi, a solutions engineer with a few interests: finance, small tools, cricket and books. Start here."
  activePath="/claude/"
>
  <div class="hm cl-container">
    <header class="hm-hello">
      <h1 class="hm-hello__title">Hi, welcome to my personal website.</h1>
      <p class="hm-hello__text">
        I’m Nafi, a solutions engineer at Dasseti, living in Florida. I have a few interests I keep coming back to:
        how money moves, small tools that make data easier to read, cricket, and books. Everything is one click
        away.
      </p>
    </header>

    <nav class="hm-index" aria-label="Everything on this site">
      {groups.map((group) => (
        <section class="hm-group" aria-labelledby={`hm-${group.id}`}>
          <h2 id={`hm-${group.id}`} class="hm-group__title">{group.title}</h2>
          <ul class="hm-links" role="list">
            {group.links.map((link) => (
              <li>
                <a class="hm-link" href={link.href}>
                  <span class="hm-link__label">
                    {link.label} <span class="hm-link__arrow" aria-hidden="true">→</span>
                  </span>
                  <span class="hm-link__note">{link.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  </div>
</ClaudeLayout>

<style>
  .hm {
    padding-top: clamp(48px, 9vw, 112px);
    padding-bottom: clamp(56px, 9vw, 120px);
  }

  /* Hello */
  .hm-hello {
    max-width: 40rem;
    margin-bottom: clamp(48px, 7vw, 88px);
  }

  .hm-hello__title {
    margin: 0 0 20px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .hm-hello__text {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Link index: two columns on wide screens, one on phones */
  .hm-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 5vw, 56px) clamp(32px, 6vw, 80px);
  }

  .hm-group__title {
    margin: 0 0 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .hm-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hm-links li {
    border-bottom: 1px solid var(--border-subtle);
  }

  .hm-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 0;
    color: var(--text-primary);
    text-decoration: none;
  }

  .hm-link__label {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .hm-link__arrow {
    display: inline-block;
    color: var(--text-secondary);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .hm-link__note {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .hm-link:hover .hm-link__label,
  .hm-link:focus-visible .hm-link__label {
    color: var(--accent-primary);
  }

  .hm-link:hover .hm-link__arrow,
  .hm-link:focus-visible .hm-link__arrow {
    transform: translateX(4px);
    color: var(--accent-primary);
  }

  @media (max-width: 720px) {
    .hm-index {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-link__arrow {
      transition: none;
    }
  }
</style>
