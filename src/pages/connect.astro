---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Connect" description="Get in touch with C M Nafi about finance, data infrastructure, engineering, and interesting technical problems."><div class="page-container connect-page"><div><span class="eyebrow">Connect</span><h1>Say <em>hello.</em></h1><p>I read all messages and try to respond if there is a clear strategic overlap or an interesting technical problem being solved.</p><a class="text-link" href="/story/">More about my work →</a></div><div><a class="email" href="mailto:nafi@cmnafi.com">nafi@cmnafi.com ↗</a><button type="button" class="text-link copy-email">Copy email</button><nav aria-label="Social profiles"><a href="https://www.linkedin.com/in/cm-nafi/"><span>LinkedIn</span><span>/in/cm-nafi ↗</span></a><a href="https://github.com/CMNafi"><span>GitHub</span><span>CMNafi ↗</span></a><a href="https://x.com/naficm01"><span>X</span><span>@naficm01 ↗</span></a></nav><p class="meta copy-status" aria-live="polite"></p></div></div></BaseLayout>
<style>.connect-page{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;min-height:70vh}.connect-page h1{font-size:clamp(64px,8vw,112px);margin:20px 0}.connect-page p{color:var(--ink-secondary);max-width:490px}.email{font-size:clamp(25px,3vw,40px);letter-spacing:-.035em}.copy-email{background:none;border:0;color:var(--ink-secondary);cursor:pointer;display:block;margin:12px 0 35px}.connect-page nav a{display:flex;justify-content:space-between;gap:15px;padding:20px 0;border-top:1px solid var(--surface-line)}.connect-page nav a span:last-child{font:12px var(--font-mono);align-self:center;color:var(--ink-secondary)}@media(max-width:700px){.connect-page{grid-template-columns:1fr;gap:35px;min-height:0}}</style>
<script>function initCopy(){document.querySelector<HTMLButtonElement>('.copy-email')?.addEventListener('click',async e=>{const b=e.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText('nafi@cmnafi.com');b.textContent='Copied';setTimeout(()=>{b.textContent='Copy email'},2000)}catch{document.querySelector('.copy-status')!.textContent='Email: nafi@cmnafi.com'}})}initCopy();document.addEventListener('astro:page-load',initCopy);</script>
