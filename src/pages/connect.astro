---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Connect"
  description="Email is the fastest way to reach Nafi. Most useful on due diligence, allocator workflows, and how investment teams adopt software."
>
  <div class="connect-viewport">
    <div class="comms-panel">
      <h1>Say hello.</h1>
      <p>
        Email is the fastest way to reach me. I read everything and reply within two business days. I'm most
        useful on due diligence, allocator workflows, and how investment teams actually adopt software, but a
        good question about a Field Note or a cricket match is just as welcome.
      </p>

      <div class="comms-grid">
        <a href="mailto:nafi@cmnafi.com" class="comms-link">
          <span class="c-label">Email</span>
          <span class="c-val">nafi@cmnafi.com</span>
        </a>
        <a href="https://www.linkedin.com/in/cm-nafi/" target="_blank" rel="noopener" class="comms-link">
          <span class="c-label">LinkedIn</span>
          <span class="c-val">/in/cm-nafi</span>
        </a>
        <a href="https://x.com/naficm01" target="_blank" rel="noopener" class="comms-link">
          <span class="c-label">X</span>
          <span class="c-val">@naficm01</span>
        </a>
        <a href="https://github.com/CMNafi" target="_blank" rel="noopener" class="comms-link">
          <span class="c-label">GitHub</span>
          <span class="c-val">CMNafi</span>
        </a>
      </div>

      <p class="comms-foot">Based in New York, working remotely.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .connect-viewport {
    min-height: 80vh;
    background: var(--paddock-black);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
  }

  .comms-panel {
    max-width: 640px;
    width: 100%;
  }

  .comms-panel h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--pitlane-white);
    margin: 0 0 1.5rem;
  }

  .comms-panel p {
    font-family: var(--font-body);
    font-size: 1.15rem;
    color: var(--ink-secondary);
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  .comms-grid {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--surface-line);
  }

  .comms-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--surface-line);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  .comms-link:hover .c-val { color: var(--accent); }

  .c-label {
    font-family: var(--font-mono);
    color: var(--ink-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .c-val {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--pitlane-white);
    transition: color var(--dur-fast);
  }

  .comms-panel .comms-foot {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-tertiary);
    margin: 2rem 0 0;
  }

  @media (max-width: 600px) {
    .comms-link { flex-direction: column; gap: 0.35rem; }
  }
</style>
