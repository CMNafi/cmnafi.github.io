---
import CodexLayout from '../../../layouts/CodexLayout.astro';
import { getWritingItems,flagshipSlugs } from '../../../data/codex/writing-curated';
import EssayLedgerTable from '../../../components/codex/catalog/EssayLedgerTable.astro';
import CricketScorecardList from '../../../components/codex/catalog/CricketScorecardList.astro';
import BookshelfGrid from '../../../components/codex/catalog/BookshelfGrid.astro';
const writing=await getWritingItems();
const flagship=flagshipSlugs.map(slug=>writing.find(item=>item.slug===slug)).filter((item):item is NonNullable<typeof item>=>Boolean(item));
const cricket=writing.filter(item=>item.stream==='cricket');
const books=writing.filter(item=>item.stream==='books');
const compendiums=writing.filter(item=>item.featuredTier==='archive-listicle');
const essays=writing.filter(item=>item.stream!=='books'&&item.stream!=='cricket'&&item.featuredTier==='standard');
const streams=[{id:'all',label:'All streams',count:writing.length},{id:'essays',label:'Capital & systems essays',count:flagship.length+essays.length+compendiums.length},{id:'cricket',label:'Cricket match logs',count:cricket.length},{id:'books',label:'Reading shelf',count:books.length}];
---
<CodexLayout title="Essays, Match Logs & Bookshelf" description="A curated writing archive of capital research, systems, Tampa cricket and personal reading notes.">
  <header class="page-intro"><p class="eyebrow">Essays & notes</p><h1>A ledger of things<br/>worth understanding.</h1><p>Company histories, filings, books and the occasional last-over chase. An archive organized by the kind of attention each piece asks for.</p><p class="archive-count">{writing.length} published pieces · Each appears once in this index.</p></header>
  <div data-writing-streams><div class="stream-tabs" role="group" aria-label="Choose a writing stream">{streams.map(stream=><button type="button" data-stream={stream.id} aria-pressed={stream.id==='all'?'true':'false'}>{stream.label} <span>({stream.count})</span></button>)}</div><p data-stream-status class="stream-status" aria-live="polite">Showing all streams</p>
  <div data-stream-section="essays"><section class="flagships" aria-labelledby="flagship-title"><div class="section-heading"><h2 id="flagship-title">Start with the deep dives</h2><p>Six longer investigations into capital, infrastructure and how we learn.</p></div><div class="flagship-grid">{flagship.map((item,index)=><article class:list={['flagship',{lead:index===0}]}><p class="metadata"><time datetime={item.publishedAt}>{item.publishedAt}</time> · {item.readingMinutes} min read</p><h3><a href={`/field-notes/${item.slug}/`}>{item.title}</a></h3><p>{item.summary}</p><a class="read" href={`/field-notes/${item.slug}/`}>Read essay →</a></article>)}</div></section><EssayLedgerTable items={essays} compendiums={compendiums}/></div>
  <div data-stream-section="cricket" class="stream-section"><CricketScorecardList items={cricket}/></div>
  <div data-stream-section="books" class="stream-section"><BookshelfGrid items={books}/></div></div>
</CodexLayout>
<script>
  function initStreams(){document.querySelectorAll<HTMLElement>('[data-writing-streams]').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-stream]')];for(const button of buttons)button.addEventListener('click',()=>{for(const choice of buttons)choice.setAttribute('aria-pressed',String(choice===button));for(const section of root.querySelectorAll<HTMLElement>('[data-stream-section]'))section.hidden=button.dataset.stream!=='all'&&section.dataset.streamSection!==button.dataset.stream;root.querySelector('[data-stream-status]')!.textContent=button.dataset.stream==='all'?'Showing all streams':`Showing ${button.textContent?.trim()}`;});});}initStreams();document.addEventListener('astro:page-load',initStreams);
</script>
<style>
  .page-intro{max-width:800px;margin:64px 0 38px}.eyebrow{color:var(--accent-primary);font-size:.85rem}h1{font:400 clamp(2.7rem,6vw,4.7rem)/1.06 var(--font-serif);letter-spacing:-.02em;margin:16px 0 24px}.page-intro>p{color:var(--text-secondary);line-height:1.7}.page-intro>p:nth-last-child(2){font-size:1.15rem}.archive-count,.stream-status{font-size:.8rem;color:var(--text-muted)}.stream-tabs{display:flex;gap:8px;flex-wrap:wrap}.stream-tabs button{background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:var(--radius-sm);color:var(--text-secondary);font:inherit;font-size:.85rem;padding:12px 16px;cursor:pointer}.stream-tabs button[aria-pressed=true]{background:var(--accent-primary);color:var(--bg-canvas)}.stream-status{margin:18px 0 34px}.section-heading h2{font:400 2.5rem var(--font-serif);letter-spacing:-.02em}.section-heading p{color:var(--text-secondary)}.flagship-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:25px 0 64px}.flagship{padding:28px;background:var(--bg-surface);border:1px solid var(--border-subtle);display:flex;flex-direction:column;min-width:0}.lead{grid-column:1/-1;border-top:3px solid var(--accent-highlight);background:var(--bg-subtle)}.metadata{font:.75rem var(--font-mono);font-variant-numeric:tabular-nums;color:var(--text-muted)}h3{font:400 1.9rem/1.15 var(--font-serif);letter-spacing:-.02em;margin:12px 0}.lead h3{font-size:clamp(2rem,4vw,3.1rem);max-width:24ch}h3 a{color:var(--text-primary)}.flagship>p:not(.metadata){color:var(--text-secondary);line-height:1.65;max-width:75ch}.read{color:var(--accent-primary);font-size:.85rem;margin-top:auto;padding-top:15px}.stream-section{margin:65px 0;border-top:1px solid var(--border-strong);padding-top:20px}[hidden]{display:none!important}@media(max-width:650px){.flagship-grid{grid-template-columns:1fr}.lead{grid-column:auto}.flagship{padding:24px}}
</style>
