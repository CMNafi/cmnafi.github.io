---
import CodexLayout from '../../../layouts/CodexLayout.astro';
import { projects } from '../../../data/codex/projects';
import ProjectCard from '../../../components/codex/catalog/ProjectCard.astro';
import FormAdvMiniExplorer from '../../../components/codex/islands/FormAdvMiniExplorer.astro';
import CaiaFrontierSandbox from '../../../components/codex/islands/CaiaFrontierSandbox.astro';
const categories=[{id:'all',label:'All'},{id:'fintech-sec',label:'FinTech & SEC Data'},{id:'cricket-sports',label:'Cricket & Sports Analytics'},{id:'knowledge-systems',label:'Knowledge Systems'}];
---
<CodexLayout title="The Systems Workbench" description="Eight projects across regulatory intelligence, cricket tactics and connected knowledge.">
  <header class="page-intro"><p class="eyebrow">Projects & experiments</p><h1>The Systems Workbench</h1><p>Tools I build when the question is interesting and the existing workflow gets in the way. Regulatory data, cricket tactics and a few paths through everyday knowledge.</p></header>
  <section aria-label="Project catalog" data-project-catalog><div class="filters" role="group" aria-label="Filter projects">{categories.map(category => <button type="button" aria-pressed={category.id==='all'?'true':'false'} data-category={category.id}>{category.label} <span>({category.id==='all'?projects.length:projects.filter(p=>p.category===category.id).length})</span></button>)}</div><p class="count" aria-live="polite" data-project-count>{projects.length} projects</p><div class="project-grid">{projects.map(project => <ProjectCard project={project}/>)}</div></section>
  <section class="tools" aria-labelledby="try-title"><div class="section-heading"><h2 id="try-title">Try the ideas</h2><p>Small, self-contained demonstrations. Inspect the assumptions before treating an output as evidence.</p></div><div class="tool-grid"><FormAdvMiniExplorer/><CaiaFrontierSandbox/></div></section>
  <aside class="play-link"><h2>Off the clock</h2><p>The existing Play section keeps fantasy football, Formula 1, cricket fixtures and friendly predictions together.</p><a href="/play/">Visit Play →</a></aside>
</CodexLayout>
<script>
  function initProjects(){document.querySelectorAll<HTMLElement>('[data-project-catalog]').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-category]')];const cards=[...root.querySelectorAll<HTMLElement>('[data-project-category]')];for(const button of buttons)button.addEventListener('click',()=>{let count=0;for(const item of buttons)item.setAttribute('aria-pressed',String(item===button));for(const card of cards){const visible=button.dataset.category==='all'||button.dataset.category===card.dataset.projectCategory;card.hidden=!visible;if(visible)count++;}root.querySelector('[data-project-count]')!.textContent=`${count} ${count===1?'project':'projects'}`;});});}initProjects();document.addEventListener('astro:page-load',initProjects);
</script>
<style>
  .page-intro{max-width:800px;margin:64px 0 42px}.eyebrow{color:var(--accent-primary);font-size:.85rem}h1{font:400 clamp(2.7rem,6vw,4.7rem)/1.05 var(--font-serif);letter-spacing:-.02em;margin:15px 0 24px}.page-intro>p:last-child{font-size:1.15rem;color:var(--text-secondary);line-height:1.7}.filters{display:flex;flex-wrap:wrap;gap:8px}.filters button{padding:12px 16px;border:1px solid var(--border-subtle);background:var(--bg-surface);color:var(--text-secondary);font:inherit;font-size:.85rem;border-radius:var(--radius-sm);cursor:pointer}.filters button[aria-pressed=true]{background:var(--accent-primary);color:var(--bg-canvas)}.count{font-size:.8rem;color:var(--text-muted);margin:20px 0}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.tools{margin:70px 0}.section-heading h2,.play-link h2{font:400 2.5rem var(--font-serif);letter-spacing:-.02em}.section-heading p,.play-link p{color:var(--text-secondary);line-height:1.65}.tool-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:26px}.play-link{border-top:1px solid var(--border-strong);padding:22px 0 50px}.play-link a{color:var(--accent-primary)}[hidden]{display:none!important}@media(max-width:750px){.project-grid,.tool-grid{grid-template-columns:1fr}}
</style>
