---
import CodexLayout from '../../layouts/CodexLayout.astro';
import FormAdvMiniExplorer from '../../components/codex/islands/FormAdvMiniExplorer.astro';
import CricketFieldingTactician from '../../components/codex/islands/CricketFieldingTactician.astro';
import { getWritingItems } from '../../data/codex/writing-curated';
import { projects } from '../../data/codex/projects';
const writing = await getWritingItems();
const lead = writing.find(item => item.slug === 'uber-the-32-billion-hole');
const featuredSlugs = ['the-open-syllabus','adv-universe','gamestop-bid-for-ebay','the-streetcar-conspiracy','capital-lens-16'];
const featured = featuredSlugs.map(slug => writing.find(item => item.slug === slug)).filter(Boolean);
const cricket = ['four-wickets-and-a-chase-blazehawks-vs-go-leopards','five-runs-tb-bengals-vs-mustangs','one-of-those-days-swat-vs-tampa-telugu-titans'].map(slug => writing.find(item => item.slug === slug)).filter((item): item is NonNullable<typeof item> => Boolean(item));
const books = ['going-infinite','liars-poker','good-to-great','shoe-dog'].map(slug => writing.find(item => item.slug === slug)).filter((item): item is NonNullable<typeof item> => Boolean(item));
const worldview = projects.find(project => project.id === 'worldview');
const date = (value: string) => new Date(`${value}T12:00:00Z`).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<CodexLayout>
  <section class="masthead">
    <div><p class="eyebrow">Financial systems · Independent research · Weekend cricket</p><h1>Making financial data useful.<br />Making sense of <em>what happens next.</em></h1><p class="bio">I’m Nafi, a Solutions Engineer at Dasseti. Previously BlackRock, Mayo Clinic, and SkyBridge. I work between investment teams and the software they use, then write about the businesses, filings, and last-over chases that catch my attention.</p><a class="trajectory" href="/codex/story/">Dinajpur <span>→</span> Changshu <span>→</span> Iowa <span>→</span> Florida</a></div>
    <aside class="identity-note"><strong>The common thread</strong><p>Learn the room. Then translate.</p><p>Numbers into stories.<br />Problems into tools.<br />Matches into memory.</p><a class="text-link" href="/codex/story/">A little about me ↗</a></aside>
  </section>
  <section class="section" aria-labelledby="workbench-title"><div class="section-heading"><h2 id="workbench-title">Ideas you can try.</h2><a href="/codex/garage/">The full workbench ↗</a></div><p class="section-intro">Small tools for questions I keep coming back to. Built with AI coding tools, shaped by the problem rather than the technology.</p><div class="workbench-grid"><div class="tool-frame"><header class="tool-heading"><p class="eyebrow">Interactive tool · SEC filings</p><h3>The investment adviser landscape</h3></header><FormAdvMiniExplorer /></div><div class="tool-frame"><header class="tool-heading"><p class="eyebrow">Tactical engine · Cricket</p><h3>One over. Six decisions.</h3></header><CricketFieldingTactician /></div></div><div class="project-strip"><a href={worldview?.href || '/codex/garage/#worldview'}><h3>Worldview</h3><p>An atlas of everyday choices across psychology, culture, and ethics.</p><span class="arrow">Explore the atlas ↗</span></a><a href="/codex/garage/#caia"><h3>CAIA Knowledge Hub</h3><p>Alternative investments, study notes, and a portfolio sandbox.</p><span class="arrow">Try the frontier ↗</span></a><a href="/codex/garage/"><h3>Eight projects.<br />One workbench.</h3><p>Regulatory data, cricket tools, and knowledge systems in one place.</p><span class="arrow">Explore all projects ↗</span></a></div></section>
  <section class="section" aria-labelledby="writing-title"><div class="section-heading"><h2 id="writing-title">Follow the numbers.</h2><a href="/codex/field-notes/">Browse the ledger ↗</a></div><div class="ledger-grid"><div>{lead && <article class="lead-essay"><div class="meta"><span>Featured research</span><time datetime={lead.publishedAt}>{date(lead.publishedAt)}</time><span>{lead.readingMinutes} min read</span></div><a href={`/field-notes/${lead.slug}/`}><h3>{lead.title}</h3></a><p>{lead.summary}</p><a class="text-link" href={`/field-notes/${lead.slug}/`}>Read the full funding history ↗</a></article>}{featured.map(item => item && <a class="essay-row" href={`/field-notes/${item.slug}/`}><h3>{item.title}</h3><time datetime={item.publishedAt}>{date(item.publishedAt)}</time></a>)}</div><aside class="side-ledger"><h3>From the pitch</h3>{cricket.map(item => <a href={`/field-notes/${item.slug}/`}>{item.title}<small>{item.cricketStats?.highlightStat || date(item.publishedAt)}</small></a>)}<div class="books-note"><h3>On the bookshelf</h3><div class="book-list">{books.map(item => <a href={`/field-notes/${item.slug}/`}>{item.title}</a>)}</div><p style="font-size:11px;color:var(--text-secondary);margin-top:14px">{books.find(item => item.slug === 'good-to-great')?.bookMeta?.personalContextNote || 'What I underlined, what stayed with me, and where it met real life.'}</p></div></aside></div></section>
</CodexLayout>
