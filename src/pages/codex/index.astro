---
import CodexLayout from '../../layouts/CodexLayout.astro';
const links = [
  ['About me', '/codex/story/'],
  ['Writing & book notes', '/codex/field-notes/'],
  ['Projects & interactive tools', '/codex/garage/'],
  ['Cricket, fantasy football & Formula 1', '/play/'],
  ['World Cup 2026', '/world-cup-2026/'],
  ['Worldview: everyday choices', '/projects/worldview/'],
  ['CAIA study notes', '/caia/'],
  ['Get in touch', '/codex/connect/'],
];
---
<CodexLayout title="Hi, I’m Nafi | C M Nafi" description="Welcome to my personal website. I’m a solutions engineer with interests in investing, books, cricket, and Formula 1. Find my writing, projects, and more.">
  <section class="welcome" aria-labelledby="welcome-title">
    <h1 id="welcome-title">Hi, I’m Nafi.</h1>
    <p>Welcome to my personal website. I’m a solutions engineer at Dasseti, with interests in investing, books, cricket, and Formula 1.</p>
    <nav aria-label="Explore my website">
      <ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
  </section>
</CodexLayout>
<style>
  .welcome { max-width: 640px; padding: 64px 0 72px; }
  .welcome h1 { font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.12; letter-spacing: -.03em; margin: 0 0 20px; }
  .welcome p { font-size: 18px; line-height: 1.75; color: var(--text-secondary); margin: 0 0 32px; }
  .welcome ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .welcome a { color: var(--accent-primary); font-size: 16px; line-height: 1.5; text-decoration: underline; text-underline-offset: 4px; }
  .welcome a:hover { text-decoration-thickness: 2px; }
  .welcome a:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 5px; }
  @media (max-width: 600px) { .welcome { padding: 40px 0 48px; } }
</style>
