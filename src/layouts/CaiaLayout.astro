---
import BaseLayout from './BaseLayout.astro';
import {getCollection} from 'astro:content';
import 'katex/dist/katex.min.css';
interface Props {title?:string;description?:string;frontmatter?:any}
const {title,description,frontmatter}=Astro.props;
const topics=(await getCollection('caia')).sort((a,b)=>a.data.level.localeCompare(b.data.level)||a.data.topicNumber-b.data.topicNumber);
---
<BaseLayout title={title||frontmatter?.title||'CAIA Corner'} description={description||frontmatter?.description||'Notes and reference material for alternative investment study.'} theme="paper">
 <nav class="caia-subnav section-nav" aria-label="CAIA Corner"><a href="/caia/">CAIA Corner</a><a href="/caia/#level-I">Level I</a><a href="/caia/#level-II">Level II</a><a href="/caia/formulas/">Formulas</a><a href="/caia/glossary/">Glossary</a></nav>
 <div class="study-layout"><details class="study-topics"><summary>Browse all topics</summary>{topics.map(t=><a href={`/caia/${t.slug}/`}>{t.data.level} · {t.data.title}</a>)}</details><div class="reading-body caia-main"><slot/></div></div>
 <p class="study-disclaimer">Personal study notes, not investment advice or an official CAIA Association resource. Check the current curriculum for exam requirements.</p>
</BaseLayout>
<style is:global>.caia-main{width:100%}.caia-main h1{font-size:clamp(36px,5vw,60px)}.caia-main a{color:var(--caia-accent)}.caia-main :is(button,select){font-family:var(--font-mono);font-size:12px;min-height:44px}.caia-main .caia-last-reviewed{flex-wrap:wrap;gap:12px}.caia-main .katex-display{overflow-x:auto;overflow-y:hidden;padding:8px 0}.caia-main table{display:block;overflow-x:auto}.caia-seq-nav{gap:24px}.caia-main dl>div{border-top:1px solid var(--surface-line);padding-top:20px}@media(max-width:650px){.caia-article>header>div:last-child{flex-wrap:wrap;gap:15px}.caia-subnav{padding-inline:20px;gap:18px}.caia-seq-nav{flex-direction:column}.caia-seq-nav>div{text-align:left!important}}</style>
<script>
import renderMathInElement from 'katex/contrib/auto-render';
function math(){const main=document.querySelector<HTMLElement>('.caia-main');if(main)renderMathInElement(main,{delimiters:[{left:'$$',right:'$$',display:true},{left:'\\[',right:'\\]',display:true},{left:'$',right:'$',display:false},{left:'\\(',right:'\\)',display:false}],throwOnError:false});}math();document.addEventListener('astro:page-load',math);
</script>
