---
import '../styles/global.css';
import { siteConfig } from '@/config/site';
import Footer from '@/components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import { execSync } from 'child_process';
import LapTimer from '@/components/telemetry/LapTimer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  hideHeader?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical,
  image = '/og-default.svg',
  type = 'website',
  hideHeader = false
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} - ${siteConfig.title}`;
const canonicalUrl = canonical ? new URL(canonical, siteConfig.siteUrl).toString() : Astro.url.toString();
const imageUrl = new URL(image, siteConfig.siteUrl).toString();
const currentPath = Astro.url.pathname;

// Dynamic Git hash and build timestamp compilation
let commitSha = 'unknown';
try {
  commitSha = execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim().slice(0, 7);
} catch (e) {}
const buildDate = new Date().toISOString();
---
<!-- [SYSTEM TELEMETRY] COMMIT: {commitSha} | COMPILED: {buildDate} | CHASSIS LOGGED -->
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#120f0d" />
    <slot name="head" />
    <ViewTransitions />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W7QGKS85CP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-W7QGKS85CP');
    </script>
  </head>
  <body>
    <div class="page-shell">
      <div class="ambient ambient--one"></div>
      <div class="ambient ambient--two"></div>
      <div class="grain"></div>
      {!hideHeader && (
        <header class="site-header">
          <a class="site-mark" href="/">
            <span>C M Nafi</span>
            <small>Solutions engineer · New York</small>
          </a>
          <nav aria-label="Primary navigation" class="nav-container">
            <ul class="nav-list">
              {siteConfig.nav.map((item) => {
                const isCurrent = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(`${item.href}/`));

                return (
                  <li>
                    <a
                      href={item.href}
                      data-nav-item={item.id}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
            <div class="header-timer-wrap">
              <LapTimer id="global-header-timer" isLive={true} />
            </div>
          </nav>
        </header>
      )}
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      /* Primary Navigation Layout & Timer */
      .nav-container {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .header-timer-wrap {
        display: inline-flex;
        align-items: center;
      }
      @media (max-width: 768px) {
        .nav-container {
          flex-direction: column;
          gap: 1rem;
          align-items: center;
        }
      }

      /* Jony Ive-style Elegant Page Transitions */
      .page-shell {
        opacity: 0;
        transform: scale(1.01);
        transform-origin: center 10vh;
        transition: opacity 240ms cubic-bezier(0.16, 1, 0.3, 1), transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }

      .page-shell.page-ready {
        opacity: 1;
        transform: scale(1);
      }

      .page-shell.page-exiting {
        opacity: 0;
        transform: scale(0.99) !important;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-shell {
          transition: none !important;
          transform: none !important;
        }
      }
    </style>

    <script>
      import { initKeyboardShortcuts } from '../scripts/keyboard';

      function initPageTransitions() {
        const shell = document.querySelector('.page-shell');
        if (shell) {
          setTimeout(() => {
            shell.classList.add('page-ready');
          }, 20); // entry delay
        }
      }

      // Initialize keyboard shortcuts & page shell active state
      document.addEventListener('astro:page-load', () => {
        initPageTransitions();
        initKeyboardShortcuts();
      });
    </script>

    <!-- Pit Wall startup ascii banner -->
    <script define:vars={{ commitSha, buildDate }}>
      console.log(`%c
   ___ __  __   _  _   _   ___ ___ 
  / __|  \\/  | | \\| | /_\\ | __|_ _|
 | (__| |\\/| | | .\` |/ _ \\| _| | | 
  \\___|_|  |_| |_|\\_/_/ \\_\\_| |___|
                                   
 [ SYSTEM ACTIVE SPECIMEN ]
 TELEMETRY: SECTOR-2 ONLINE
 GIT COMMIT: ${commitSha}
 COMPILED: ${buildDate}
`, "color: #7dd3a0; font-family: monospace; font-weight: bold;");
    </script>
  </body>
</html>
