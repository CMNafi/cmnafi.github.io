---
import '../styles/global.css';
import '../styles/editorial.css';
import { siteConfig } from '@/config/site';
import SiteHeader from '@/components/SiteHeader.astro';
import Footer from '@/components/Footer.astro';

interface Props { title?: string; description?: string; canonical?: string; image?: string; type?: 'website'|'article'; hideHeader?: boolean; theme?: 'dark'|'paper'; }
const {title=siteConfig.title,description=siteConfig.description,canonical,image='/og-default.png',type='website',theme='dark'}=Astro.props;
const pageTitle=title===siteConfig.title?title:`${title} · C M Nafi`;
const url=new URL(canonical||Astro.url.pathname,siteConfig.siteUrl).href;
---
<!doctype html><html lang="en" data-theme={theme==='paper'?'light':'dark'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={url}/><link rel="preload" href="/fonts/fraunces-roman.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:type" content={type}/><meta property="og:image" content={new URL(image,siteConfig.siteUrl).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="alternate" type="application/rss+xml" title="C M Nafi — Field Notes" href="/rss.xml"/><meta name="theme-color" content={theme==='paper'?'#f4ede4':'#120f0d'}/><slot name="head"/>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W7QGKS85CP"></script><script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-W7QGKS85CP');</script>
</head><body class:list={['editorial-site',{'paper-site':theme==='paper'}]}><a class="skip-link" href="#main-content">Skip to content</a><SiteHeader/><main id="main-content"><slot/></main><Footer/></body></html>
