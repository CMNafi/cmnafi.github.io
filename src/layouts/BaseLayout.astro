---
import '../styles/global.css';
import '../styles/site.css';
import { siteConfig } from '@/config/site';
import Footer from '@/components/Footer.astro';
import StoryNavigation from '../components/StoryNavigation.astro';
import SiteHeader from '@/components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  hideHeader?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonical,
  image = '/og-default.svg',
  type = 'website',
  hideHeader = false
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} - ${siteConfig.title}`;
const canonicalUrl = canonical ? new URL(canonical, siteConfig.siteUrl).toString() : Astro.url.toString();
const imageUrl = new URL(image, siteConfig.siteUrl).toString();

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#120f0d" />
    <slot name="head" />
    <StoryNavigation />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W7QGKS85CP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-W7QGKS85CP');
    </script>
  </head>
  <body>
    <div class="page-shell">
      <div class="ambient ambient--one"></div>
      <div class="ambient ambient--two"></div>
      <div class="grain"></div>
      {!hideHeader && <SiteHeader />}
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      /* Page fade between navigations */
      .page-shell {
        opacity: 0;
        transition: opacity 240ms cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity;
        max-width: 100vw;
        overflow-x: clip;
      }

      .page-shell.page-ready {
        opacity: 1;
      }

      .page-shell.page-exiting {
        opacity: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-shell {
          transition: none !important;
          transform: none !important;
        }
      }
    </style>

    <script>
      import { initKeyboardShortcuts } from '../scripts/keyboard';

      function initPageTransitions() {
        const shell = document.querySelector('.page-shell');
        if (shell) {
          setTimeout(() => {
            shell.classList.add('page-ready');
          }, 20); // entry delay
        }
      }

      // Initialize keyboard shortcuts & page shell active state
      document.addEventListener('astro:page-load', () => {
        initPageTransitions();
        initKeyboardShortcuts();
      });
    </script>

  </body>
</html>
