---
/**
 * Shell for every /claude page: tokens + base styles, fonts, theme bootstrap,
 * header, footer and command menu. No View Transitions; scripts run once per page load.
 * Contract: keep this file path, the Props interface, and the default <slot />.
 */
import '@/styles/claude/tokens.css';
import '@/styles/claude/base.css';
import Header from '@/components/claude/shell/Header.astro';
import Footer from '@/components/claude/shell/Footer.astro';
import CommandPalette from '@/components/claude/shell/CommandPalette.astro';

export interface Props {
  title: string;
  description?: string;
  /** Path of the current /claude section, used for the active nav state, e.g. '/claude/garage/' */
  activePath?: string;
}

const {
  title,
  description = 'C M Nafi: solutions engineering for institutional capital, long-form writing on how money moves, and weekend league cricket in Tampa.',
  activePath = Astro.url.pathname,
} = Astro.props;

const pageTitle = /nafi/i.test(title) ? title : `${title} · C M Nafi`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Apply the saved theme before first paint (Paper is the default). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('cl-js');
        var theme = 'light';
        try {
          var saved = localStorage.getItem('cmnafi-claude-theme');
          if (saved === 'dark' || saved === 'light') theme = saved;
        } catch (e) {}
        root.setAttribute('data-theme', theme);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="cl-skip-link" href="#cl-main">Skip to content</a>
    <Header activePath={activePath} />
    <main id="cl-main" class="cl-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>

<style>
  .cl-main {
    display: block;
    flex: 1 0 auto;
    width: 100%;
  }
</style>
