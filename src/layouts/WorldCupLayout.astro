---
import BaseLayout from './BaseLayout.astro';
interface Props {title?:string;description?:string;frontmatter?:any}
const {title,description,frontmatter}=Astro.props;
---
<BaseLayout title={title||frontmatter?.title||'World Cup Corner'} description={description||frontmatter?.description||'An archive of a World Cup 2026 research and prediction project.'}><div class="wc-container"><nav class="section-nav" aria-label="World Cup archive"><a href="/world-cup-2026/">World Cup Corner</a><a href="/world-cup-2026/matches/">Matches</a><a href="/world-cup-2026/teams/">Teams</a><a href="/world-cup-2026/groups/">Groups</a><a href="/world-cup-2026/knockouts/">Bracket</a><a href="/garage/">All projects ↗</a></nav><p class="archive-note">Archive · Pre-tournament research and prediction tools. The stored fixtures and projections are not a record of tournament results.</p><div class="wc-main"><slot/></div><p class="meta">Independent project. Not affiliated with FIFA.</p></div></BaseLayout>
<style is:global>:root{--wc-bg:var(--surface-base);--wc-surface:var(--surface-raised);--wc-ink:var(--ink-primary);--wc-accent:var(--accent);--wc-highlight:var(--status-warn);--wc-muted:var(--ink-secondary);--wc-border:var(--surface-line)}.archive-note{font:12px/1.8 var(--font-mono);color:var(--ink-secondary);padding-bottom:25px;max-width:850px}.wc-main{font-family:var(--font-serif);line-height:1.7}.wc-main a{color:inherit}.wc-main button{min-height:44px}.wc-main{margin-bottom:50px}</style>
